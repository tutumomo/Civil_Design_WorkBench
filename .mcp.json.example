{
  "_comment": [
    "MCP 設定範本：複製成 .mcp.json 後填入實際路徑（.mcp.json 已列在 .gitignore，不進版控）。",
    "建議直接跑 python tools/mcp/register_all.py --apply 自動填入前六個伺服器（含 opencadstudio），",
    "再跑 python tools/crosscheck/ocss_crosscheck.py register-mcp --apply 補上 OCSS（token 不經過本檔）。",
    "open-calcsheet-studio 的 Bearer token 是機密，只存在本機 .mcp.json，切勿寫進版控或文件。",
    "opencadstudio 是 stdio 橋，連到執行中的 Open CAD Studio 視窗（不需 token）；command 由 project_paths.opencadstudio_exe() 解析，只認上游版。"
  ],
  "mcpServers": {
    "regs": {
      "command": "<Python 執行檔（需已安裝 mcp 套件）>",
      "args": [
        "-E",
        "-P",
        "-X",
        "utf8",
        "<專案根目錄>/tools/regs/regs_server.py",
        "--mcp"
      ],
      "env": {
        "CIVIL_AI_ROOT": "<專案根目錄>",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "blender": {
      "command": "<Python 執行檔（需已安裝 mcp 套件）>",
      "args": [
        "-E",
        "-P",
        "-X",
        "utf8",
        "<專案根目錄>/tools/blender/blender_mcp.py"
      ],
      "env": {
        "CIVIL_AI_ROOT": "<專案根目錄>",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "autocad": {
      "command": "<autocad-mcp-pro 安裝目錄>/.venv/Scripts/autocad-mcp.exe",
      "args": [],
      "env": {
        "AUTOCAD_MCP_BACKEND": "ezdxf",
        "ALLOWED_PATHS": "<專案根目錄>",
        "TOOL_PROFILE": "full",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "artcraft": {
      "command": "<artcraft-gateway 安裝目錄>/.venv/Scripts/python.exe",
      "args": [
        "<artcraft-gateway 安裝目錄>/server.py"
      ],
      "env": {
        "ARTCRAFT_ROOT": "<ArtCraft 安裝目錄>",
        "ARTCRAFT_WORK_DIR": "<專案根目錄>/out",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "ingetrazo": {
      "command": "<IngeTrazo MCP 執行檔，例如 C:/Program Files/IngeTrazo/ingetrazo-mcp.exe>",
      "args": [],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "opencadstudio": {
      "command": "<Open CAD Studio 執行檔：Linux ~/.local/bin/opencadstudio；Windows「Open CAD Studio」內的 OpenCADStudio.exe；macOS Open CAD Studio.app 內執行檔>",
      "args": [
        "--mcp"
      ]
    },
    "open-calcsheet-studio": {
      "type": "http",
      "url": "http://127.0.0.1:3879/mcp",
      "headers": {
        "Authorization": "Bearer <TW 版 preferences.json 的 mcpToken；勿寫入版控>"
      }
    }
  }
}
