   "payload": {
    "example": true
   },
   "source": [
    "\"溝蓋版彎矩與植筋握裹（無因次化；kN、m、kgf、cm 分開書寫）",
    "b = 0.6",
    "t_w = 0.2",
    "h = 0.25",
    "g_c = 24",
    "P20 = 7300*0.00980665",
    "k_h = 1.25",
    "LF = 1.67",
    "S = min(b + t_w; b + h)",
    "I_m = min(15.24/(S + 38.1); 0.30)",
    "M_L = P20*k_h*(S + 6.0)/6.9*(1 + I_m)",
    "M_D = g_c*h*S^2/8",
    "M_u = 1.25*M_D + LF*M_L",
    "tau = 14",
    "tau_u = 45",
    "d_a = 1.59",
    "h_ef = 20",
    "c_a = 10",
    "N_ba = tau*pi*d_a*h_ef",
    "c_Na = 10*d_a*sqrt(tau_u/77)",
    "psi_ed = if(c_a ≥ c_Na; 1; 0.7 + 0.3*c_a/c_Na)",
    "psi_cp = if(c_a ≥ 2*h_ef; 1; max(c_a/(2*h_ef); c_Na/(2*h_ef)))",
    "N_a = psi_ed*psi_cp*N_ba"
   ],
