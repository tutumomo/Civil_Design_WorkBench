 "formulas": [
  {
   "id": "concrete_const110_wb_ratio",
   "src": "concrete_const110",
   "clause": "3.2.2",
   "page": 20,
   "title": "水膠比 w/(c+p)（結構混凝土施工規範 3.2.2）",
   "keywords": "施工規範 混凝土 水膠比 水灰比 卜作嵐材料 膠結材料 3.2.2",
   "unit": "無因次",
   "output": "w/b",
   "latex": "\\frac{w}{c+p}",
   "vars": {
    "w": {
     "desc": "拌和用水量 w",
     "unit": "kg",
     "min": 0
    },
    "c": {
     "desc": "水泥用量 c",
     "unit": "kg",
     "min": 0
    },
    "p": {
     "desc": "卜作嵐材料用量 p（飛灰、爐碴粉、矽灰等；未摻用時為 0）",
     "unit": "kg",
     "min": 0,
     "default": 0
    }
   },
   "expr": "w / (c + p)",
   "conditions": [
    {
     "expr": "c + p > 0",
     "msg": "膠結材料用量須為正"
    }
   ],
   "tests": [
    {
     "in": {
      "w": 170.0,
      "c": 300.0,
      "p": 50.0
     },
     "out": 0.4857142857142857
    },
    {
     "in": {
      "w": 160.0,
      "c": 320.0,
      "p": 0.0
     },
     "out": 0.5
    }
   ],
   "notes": "水膠比為水(w)與水泥(c)及卜作嵐材料(p)之重量比；不加卜作嵐材料時(p=0)即為水灰比 w/c。耐久性要求之最大水膠比見表3.2.3 與表R3.2.2（concrete_const110_table3_2_3_exposure、concrete_const110_tableR3_2_2_sulfate）。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 const110 PDF 第20頁（含表格影像）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "concrete_const110_fcr",
   "src": "concrete_const110",
   "clause": "3.7.1",
   "page": 26,
   "title": "混凝土配比目標強度 f'cr（結構混凝土施工規範 3.7.1 (3-1)(3-2)）",
   "keywords": "施工規範 混凝土 配比目標強度 fcr 標準差 要求平均抗壓強度 3-1 3-2",
   "unit": "kgf/cm2",
   "output": "fcr",
   "latex": "f_{cr}' \\ge f_c' + 1.34s;\\qquad f_{cr}' \\ge f_c' + 2.33s - 35",
   "vars": {
    "fc": {
     "desc": "混凝土規定抗壓強度 f'c",
     "unit": "kgf/cm2",
     "min": 0
    },
    "s": {
     "desc": "標準差 s（(3-3) 或 (3-4) 式；無試驗紀錄時改用表3.7.2）",
     "unit": "kgf/cm2",
     "min": 0
    }
   },
   "expr": "max(fc + 1.34 * s, fc + 2.33 * s - 35.0)",
   "conditions": [
    {
     "expr": "fc > 0 and s >= 0",
     "msg": "f'c 須為正、s 須非負"
    }
   ],
   "tests": [
    {
     "in": {
      "fc": 280.0,
      "s": 35.0
     },
     "out": 326.9
    },
    {
     "in": {
      "fc": 210.0,
      "s": 28.0
     },
     "out": 247.52
    }
   ],
   "notes": "(3-1)(3-2) 兩式取較大者。(3-1) 係配合第18.2.2 節「任何連續三次試驗平均值 ≥ f'c」、(3-2) 配合「任一試驗值 ≥ f'c − 35」而設；解說並說明 1.34 = 2.33/√3。無試驗紀錄時改用表3.7.2 之規定值（concrete_const110_table3_7_2_fcr）。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 const110 PDF 第26頁（含表格影像）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "concrete_const110_std_dev",
   "src": "concrete_const110",
   "clause": "3.8.2",
   "page": 27,
   "title": "混凝土強度標準差 s（結構混凝土施工規範 3.8.2 (3-3)）",
   "keywords": "施工規範 混凝土 標準差 樣本標準差 變異數 3-3",
   "unit": "kgf/cm2",
   "output": "s",
   "latex": "s=\\sqrt{\\frac{\\sum (X_i-\\bar{X})^2}{n-1}}",
   "vars": {
    "SS": {
     "desc": "離均差平方和 Σ(Xi − X̄)²（引擎不支援級數運算，須先自行加總）",
     "unit": "kgf2/cm4",
     "min": 0
    },
    "n": {
     "desc": "連續試驗次數 n",
     "unit": "組",
     "min": 2
    }
   },
   "expr": "sqrt(SS / (n - 1))",
   "conditions": [
    {
     "expr": "n >= 2",
     "msg": "試驗次數至少 2 組"
    }
   ],
   "tests": [
    {
     "in": {
      "SS": 1000.0,
      "n": 6
     },
     "out": 14.142135623730951
    },
    {
     "in": {
      "SS": 2400.0,
      "n": 11
     },
     "out": 15.491933384829668
    }
   ],
   "notes": "分母採 n−1（自由度為樣本數減一）。個別試驗強度值 Xi 係指同一次強度試驗中各試體強度之平均值。試驗紀錄須符合第3.8.1 節之組數與期間規定；僅 15~29 組時須再乘表3.8.3 之修正因數（concrete_const110_table3_8_3_factor）。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 const110 PDF 第27頁（含表格影像）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "concrete_const110_std_dev_pooled",
   "src": "concrete_const110",
   "clause": "3.8.2",
   "page": 28,
   "title": "兩群試驗標準差之統計平均值（結構混凝土施工規範 3.8.2 (3-4)）",
   "keywords": "施工規範 混凝土 標準差 統計平均 兩群 合併標準差 3-4",
   "unit": "kgf/cm2",
   "output": "s_bar",
   "latex": "\\bar{s}=\\sqrt{\\frac{(n_1-1)s_1^2+(n_2-1)s_2^2}{n_1+n_2-2}}",
   "vars": {
    "n1": {
     "desc": "第一群試驗組數 n1",
     "unit": "組",
     "min": 2
    },
    "s1": {
     "desc": "第一群標準差 s1",
     "unit": "kgf/cm2",
     "min": 0
    },
    "n2": {
     "desc": "第二群試驗組數 n2",
     "unit": "組",
     "min": 2
    },
    "s2": {
     "desc": "第二群標準差 s2",
     "unit": "kgf/cm2",
     "min": 0
    }
   },
   "expr": "sqrt(((n1 - 1) * s1 ** 2 + (n2 - 1) * s2 ** 2) / (n1 + n2 - 2))",
   "conditions": [
    {
     "expr": "n1 + n2 >= 4",
     "msg": "兩群合計至少 4 組"
    }
   ],
   "tests": [
    {
     "in": {
      "n1": 15.0,
      "s1": 20.0,
      "n2": 15.0,
      "s2": 30.0
     },
     "out": 25.495097567963924
    }
   ],
   "notes": "適用於採用二群連續試驗、總數至少 30 組之紀錄；s̄ 可取代 (3-1)(3-2) 式中之 s。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 const110 PDF 第28頁（含表格影像）",
    "by": "agent",
    "date": "2026-11-14"
   }
  }
 ],
