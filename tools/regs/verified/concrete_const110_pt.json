{
 "formulas": [
  {
   "id": "concrete_const110_pretension_mu_tolerance",
   "src": "concrete_const110",
   "clause": "14.6.4",
   "page": 138,
   "title": "外視摩擦係數 µ 之容許誤差（結構混凝土施工規範 14.6.4 表R14.6.2 解說）",
   "keywords": "施工規範 預力 外視摩擦係數 容許誤差 2sigma 根號n 14.6.4",
   "unit": "無因次",
   "output": "tolerance",
   "latex": "\\text{容許誤差}=\\frac{2\\sigma}{\\sqrt{n}},\\quad \\sigma \\approx 0.2",
   "vars": {
    "sigma": {
     "desc": "µ 之標準差 σ（正常管理下假設 0.2）",
     "unit": "無因次",
     "min": 0,
     "default": 0.2
    },
    "n": {
     "desc": "組內之鋼腱股數 n",
     "unit": "股",
     "min": 1
    }
   },
   "expr": "2.0 * sigma / sqrt(n)",
   "conditions": [
    {
     "expr": "n >= 1 and sigma >= 0",
     "msg": "n 須 ≥1、σ 須非負"
    }
   ],
   "tests": [
    {
     "in": {
      "sigma": 0.2,
      "n": 1.0
     },
     "out": 0.4
    },
    {
     "in": {
      "sigma": 0.2,
      "n": 4.0
     },
     "out": 0.2
    },
    {
     "in": {
      "sigma": 0.2,
      "n": 6.0
     },
     "out": 0.16329931618554522
    },
    {
     "in": {
      "sigma": 0.2,
      "n": 10.0
     },
     "out": 0.12649110640673517
    }
   ],
   "notes": "以 95% 信賴度、σ=0.2 換算之容許界限；表R14.6.2 之列值（±0.4／±0.2／±0.16／±0.13）即本式取至小數兩位。正常管理下同一斷面拉力常有 5% 偏差，約每 20 次有 1 次可能超出容許誤差。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 const110 PDF 第138頁（含表格影像）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "concrete_const110_pretension_lambda",
   "src": "concrete_const110",
   "clause": "14.6.4",
   "page": 134,
   "title": "外視摩擦係數之換算參數 λ = K/µ（結構混凝土施工規範 14.6.4 表R14.6.1）",
   "keywords": "施工規範 預力 摩擦係數 K wobble lambda 外視摩擦係數 14.6.4",
   "unit": "1/m",
   "output": "lambda",
   "latex": "\\lambda=\\frac{K}{\\mu}",
   "vars": {
    "K": {
     "desc": "鋼腱與套管間之蜿蜒（wobble）摩擦係數 K",
     "unit": "1/m",
     "min": 0
    },
    "mu": {
     "desc": "鋼腱與套管間之曲率摩擦係數 µ",
     "unit": "無因次",
     "min": 0.0001
    }
   },
   "expr": "K / mu",
   "conditions": [
    {
     "expr": "mu > 0",
     "msg": "µ 須為正"
    }
   ],
   "tests": [
    {
     "in": {
      "K": 0.004,
      "mu": 0.3
     },
     "out": 0.013333333333333334
    },
    {
     "in": {
      "K": 0.005,
      "mu": 0.3
     },
     "out": 0.016666666666666666
    },
    {
     "in": {
      "K": 0.004,
      "mu": 0.25
     },
     "out": 0.016
    }
   ],
   "notes": "表R14.6.1 之 λ 欄即 λ=K/µ（鋼線 0.013、七線絞線 0.016、鋼棒 0.016）。µ 與 K 若無試驗資料可引用表值，或依設計圖規定；實際值原則上應於現場以試驗測定。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 const110 PDF 第134頁（含表格影像）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "concrete_const110_core_diameter",
   "src": "concrete_const110",
   "clause": "18.5.2",
   "page": 177,
   "title": "鑽心試體最小直徑（結構混凝土施工規範 18.5.2）",
   "keywords": "施工規範 混凝土 鑽心試體 直徑 94mm 粗粒料最大粒徑 2倍 18.5.2",
   "unit": "mm",
   "output": "D_req",
   "latex": "D \\ge \\max(94\\ \\mathrm{mm},\\ 2D_{max})",
   "vars": {
    "dmax": {
     "desc": "粗粒料標稱最大粒徑 Dmax",
     "unit": "mm",
     "min": 0
    }
   },
   "expr": "max(94.0, 2.0 * dmax)",
   "conditions": [
    {
     "expr": "dmax > 0",
     "msg": "粗粒料最大粒徑須為正"
    }
   ],
   "warn_if": [
    {
     "expr": "result > 94.0",
     "msg": "受粗粒料粒徑控制，試體直徑須大於 94 mm"
    }
   ],
   "tests": [
    {
     "in": {
      "dmax": 19.0
     },
     "out": 94.0
    },
    {
     "in": {
      "dmax": 50.0
     },
     "out": 100.0
    }
   ],
   "notes": "一般抗壓試驗用之鑽心試體直徑至少 94 mm 或 2 倍粗粒料標稱最大粒徑，取其大者；試體長度不得小於直徑。因結構安全、厚度或鋼筋間距限制致 94 mm 試體不易取得時，得取較小直徑，但不得小於 50 mm、不得小於 2 倍粗粒料標稱最大粒徑，長度亦不得小於直徑。長徑比小於 2 時之強度修正見表R18.5.1（concrete_const110_tableR18_5_1_core_factor）。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 const110 PDF 第177-178頁（含表格影像）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "concrete_const110_core_strength_check",
   "src": "concrete_const110",
   "clause": "18.5.5",
   "page": 178,
   "title": "鑽心試體抗壓強度合格標準（結構混凝土施工規範 18.5.5）",
   "keywords": "施工規範 混凝土 鑽心試體 合格標準 85% 75% 18.5.5",
   "unit": "無因次",
   "output": "ratio_avg",
   "latex": "\\bar{f}_{core} \\ge 0.85f_c'\\ \\text{且}\\ \\min f_{core} \\ge 0.75f_c'",
   "vars": {
    "mean_core": {
     "desc": "同組鑽心試體平均抗壓強度",
     "unit": "kgf/cm2",
     "min": 0
    },
    "min_core": {
     "desc": "同組任一試體最低抗壓強度",
     "unit": "kgf/cm2",
     "min": 0
    },
    "fc": {
     "desc": "混凝土規定抗壓強度 f'c",
     "unit": "kgf/cm2",
     "min": 0.0001
    }
   },
   "expr": "mean_core / fc",
   "conditions": [
    {
     "expr": "fc > 0",
     "msg": "f'c 須為正"
    }
   ],
   "warn_if": [
    {
     "expr": "result < 0.85",
     "msg": "同組平均強度低於 0.85f'c，不合格"
    },
    {
     "expr": "min_core / fc < 0.75",
     "msg": "任一試體強度低於 0.75f'c，不合格"
    }
   ],
   "tests": [
    {
     "in": {
      "mean_core": 250.0,
      "min_core": 220.0,
      "fc": 280.0
     },
     "out": 0.8928571428571429
    },
    {
     "in": {
      "mean_core": 230.0,
      "min_core": 200.0,
      "fc": 280.0
     },
     "out": 0.8214285714285714
    }
   ],
   "notes": "鑽心試驗取三個代表性試體為一組，由監造者選擇對結構物強度損害最小之位置鑽取。輸出為平均強度比；須 ≥0.85 且任一試體 ≥0.75（第二個測試 0.821 即不合格案例）。不合格時依第18.4.3 節辦理。同條件之噴凝土評定（15.7.13）為鑽心 ≥0.85f'c、任一 ≥0.75f'c；方塊試體 ≥1.0f'c、任一 ≥0.85f'c。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 const110 PDF 第178頁（含表格影像）",
    "by": "agent",
    "date": "2026-11-14"
   }
  }
