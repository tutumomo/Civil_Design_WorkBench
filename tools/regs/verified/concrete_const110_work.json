   "clause": "7.2.4",
   "page": 65,
   "title": "混凝土各盤產量 Y（結構混凝土施工規範 7.2.4 解說）",
   "keywords": "施工規範 混凝土 產量 yield 單位重 拌和盤 7.2.4",
   "unit": "m3",
   "output": "Y",
   "latex": "Y(m^3)=\\frac{\\text{每一拌和盤各材料之總重}(kg)}{\\text{混凝土單位重}(kg/m^3)}",
   "vars": {
    "total_mass": {
     "desc": "每一拌和盤各材料之總重",
     "unit": "kg",
     "min": 0
    },
    "unit_weight": {
     "desc": "混凝土單位重",
     "unit": "kg/m3",
     "min": 0.0001
    }
   },
   "expr": "total_mass / unit_weight",
   "conditions": [
    {
     "expr": "unit_weight > 0",
     "msg": "單位重須為正"
    }
   ],
   "tests": [
    {
     "in": {
      "total_mass": 2400.0,
      "unit_weight": 2300.0
     },
     "out": 1.0434782608695652
    }
   ],
   "notes": "計量設備之校正頻率至少每年一次；遇搬移、整修或混凝土產量變異大時應隨即查驗。材料計量許可差見 7.2.5 節（concrete_const110_table7_2_5_metering）。",
   "status": "verified",
