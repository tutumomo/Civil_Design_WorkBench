{
 "formulas": [
  {"id": "found112_K0", "title": "靜止土壓力係數 K0（7.3.1 本文下限 0.5＋解說式 7.3-1~3）", "src": "found112", "clause": "7.3.1", "page": 224,
   "keywords": "靜止土壓力 K0 OCR 過壓密", "unit": "-", "output": "K0",
   "latex": "K_0=1-\\sin\\phi'\\;(\\text{非凝聚性});\\;0.95-\\sin\\phi'\\;(\\text{NC 凝聚性});\\;(0.95-\\sin\\phi')\\,OCR^{0.5}\\;(\\text{OC});\\;\\times(1+\\sin\\alpha)\\;K_0\\ge0.5",
   "vars": {"phi": {"desc": "有效內摩擦角 φ'", "unit": "deg", "min": 5, "max": 50},
            "soil": {"desc": "土壤型式：0＝非凝聚性，1＝正常壓密凝聚性，2＝過壓密凝聚性", "unit": "-", "min": 0, "max": 2},
            "OCR": {"desc": "過壓密比（soil=2 才用）", "unit": "-", "default": 1.0, "min": 1.0, "max": 20},
            "alpha": {"desc": "墻背地表與水平面夾角 α（地表傾斜時乘 (1+sinα)）", "unit": "deg", "default": 0.0, "min": 0, "max": 45}},
   "defs": [["base", "(1-sin(radians(phi))) if soil<0.5 else ((0.95-sin(radians(phi))) if soil<1.5 else (0.95-sin(radians(phi)))*sqrt(OCR))"]],
   "expr": "max(0.5,base*(1+sin(radians(alpha))))",
   "notes": "7.3.1 本文：K0 依經驗估之，但不得小於 0.5，過壓密土壤應酌予提高；估算式為【解說】式(解 7.3-1~3)，適用墻背垂直且地表水平（有斜角時乘 1+sinα）。單位：墻高 H m、土單位重 t/m3、壓力 tf/m2、合力 tf/m。",
   "tests": [{"in": {"phi": 30, "soil": 0}, "out": 0.5}, {"in": {"phi": 30, "soil": 2, "OCR": 2}, "out": 0.6363961030678928, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.224-225＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_P0_at_rest", "title": "靜止土壓力合力 P0=½K0γH²（式7.3-2）", "src": "found112", "clause": "7.3.1", "page": 224,
   "keywords": "靜止土壓力 合力 P0", "unit": "tf/m", "output": "P0",
   "latex": "P_0=\\tfrac12K_0\\gamma H^2",
   "vars": {"K0": {"desc": "靜止土壓力係數", "unit": "-", "min": 0.5, "max": 3}, "gamma": {"desc": "土壤單位重（地下水位以下用有效單位重）", "unit": "t/m3", "min": 0.1, "max": 3},
            "H": {"desc": "擋土牆總高度", "unit": "m", "min": 0}},
   "expr": "0.5*K0*gamma*H**2",
   "notes": "合力作用點在基礎板底以上三分之一墻高處。", "tests": [{"in": {"K0": 0.5, "gamma": 1.8, "H": 4}, "out": 7.2, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.224＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_Ka_rankine", "title": "主動土壓力係數（朗肯，地表水平、墻背垂直、無墻面摩擦，式7.3-6）", "src": "found112", "clause": "7.3.2", "page": 225,
   "keywords": "主動土壓力係數 Ka 朗肯 Rankine", "unit": "-", "output": "KA",
   "latex": "K_A=\\tan^2\\left(45^\\circ-\\frac{\\phi}{2}\\right)",
   "vars": {"phi": {"desc": "墻背土壤內摩擦角", "unit": "deg", "min": 0, "max": 60}},
   "expr": "tan(radians(45-phi/2))**2",
   "tests": [{"in": {"phi": 30}, "out": 0.3333333333333333, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.225＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_Ka_coulomb", "title": "主動土壓力係數 KA（一般狀況，庫侖，式7.3-5）", "src": "found112", "clause": "7.3.2", "page": 225,
   "keywords": "主動土壓力係數 Ka 庫侖 Coulomb 墻背傾斜 墻面摩擦", "unit": "-", "output": "KA",
   "latex": "K_A=\\frac{\\cos^2(\\phi-\\theta)}{\\cos^2\\theta\\cos(\\theta+\\delta)\\left[1+\\sqrt{\\dfrac{\\sin(\\phi+\\delta)\\sin(\\phi-\\alpha)}{\\cos(\\delta+\\theta)\\cos(\\theta-\\alpha)}}\\right]^2}",
   "vars": {"phi": {"desc": "墻背土壤內摩擦角", "unit": "deg", "min": 0, "max": 60},
            "delta": {"desc": "墻背面與土壤間摩擦角（常用 φ/2~2φ/3）", "unit": "deg", "min": 0, "max": 40},
            "theta": {"desc": "墻背面與垂直面交角（逆時針為正，順時針為負）", "unit": "deg", "min": -45, "max": 45},
            "alpha": {"desc": "墻背地表與水平面之交角", "unit": "deg", "min": 0, "max": 45}},
   "defs": [["sa", "sin(radians(phi-alpha)) if phi>=alpha else 0"]],
   "expr": "cos(radians(phi-theta))**2/(cos(radians(theta))**2*cos(radians(theta+delta))*(1+sqrt(sin(radians(phi+delta))*sa/(cos(radians(delta+theta))*cos(radians(theta-alpha)))))**2)",
   "notes": "φ<α 時依條文假定 sin(φ−α)=0。δ 通常取 φ/2~2φ/3；現澆混凝土墻最大 2φ/3，預鑄、木、鋼約 φ/2。含凝聚力者僅適用地面水平、墻背垂直且無摩擦（7.3.2 解說 6），須改用 found112_Hc_cohesive。θ 符號：圖7.3-1，墻背向填土傾（頂端離開土）之符號請對照原圖 p.226。",
   "tests": [{"in": {"phi": 30, "delta": 20, "theta": 10, "alpha": 10}, "out": 0.43757960529861567, "tol": 1e-9},
             {"in": {"phi": 30, "delta": 0, "theta": 0, "alpha": 0}, "out": 0.3333333333333333, "tol": 1e-9},
             {"in": {"phi": 34, "delta": 17, "theta": 0, "alpha": 15}, "out": 0.3097033191251918, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.225-226＋手算＋與 earth_pressure.py 交叉比對", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_Hc_cohesive", "title": "含凝聚力土壤之有效高度 Hc／hc（式7.3-7、7.3-8）", "src": "found112", "clause": "7.3.2", "page": 225,
   "keywords": "凝聚力 張力裂縫 Hc 有效高度 黏土", "unit": "m", "output": "Hc",
   "latex": "H_c=H-\\frac{2c}{\\gamma}\\tan\\left(45^\\circ+\\frac{\\phi}{2}\\right)",
   "vars": {"H": {"desc": "墻高（算 hc 時為計算點深度 h）", "unit": "m", "min": 0}, "c": {"desc": "土壤凝聚力", "unit": "tf/m2", "min": 0},
            "gamma": {"desc": "土壤單位重", "unit": "t/m3", "min": 0.1, "max": 3}, "phi": {"desc": "內摩擦角", "unit": "deg", "min": 0, "max": 60}},
   "expr": "H-2*c/gamma*tan(radians(45+phi/2))",
   "warn_if": [{"expr": "result<=0", "msg": "Hc≤0：條文規定 hc 以零計算，Hc≤0 時應考慮長期效應所造成之土壓力"}],
   "notes": "式(7.3-3)、(7.3-4) 之 h、H 改用 hc、Hc。僅適用地面水平、墻背垂直且無摩擦。張力裂縫深度 2c·tan(45+φ/2)/γ，雨季裂縫充水之水壓力須另行考量（解說 4）。",
   "tests": [{"in": {"H": 10, "c": 1.5, "gamma": 1.8, "phi": 30}, "out": 7.113248654051873, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.225-226＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_PA_active", "title": "主動土壓力合力 PA=½KAγH²（式7.3-4）", "src": "found112", "clause": "7.3.2", "page": 225,
   "keywords": "主動土壓力 合力 PA", "unit": "tf/m", "output": "PA",
   "latex": "P_A=\\tfrac12K_A\\gamma H^2",
   "vars": {"KA": {"desc": "主動土壓力係數", "unit": "-", "min": 0, "max": 3}, "gamma": {"desc": "土壤單位重（水位以下用浸水單位重；黏土用總單位重）", "unit": "t/m3", "min": 0.1, "max": 3},
            "H": {"desc": "擋土牆垂直高度", "unit": "m", "min": 0}},
   "expr": "0.5*KA*gamma*H**2",
   "notes": "合力作用點在基礎板底以上 H/3。不含側向水壓力（用 found112_Pw_water 另算）。",
   "tests": [{"in": {"KA": 0.3333333333333333, "gamma": 1.8, "H": 4}, "out": 4.8, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.225＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_PP_passive", "title": "被動土壓力合力 PP=½KPγH²（式7.3-10）", "src": "found112", "clause": "7.3.3", "page": 227,
   "keywords": "被動土壓力 合力 PP", "unit": "tf/m", "output": "PP",
   "latex": "P_P=\\tfrac12K_P\\gamma H^2",
   "vars": {"KP": {"desc": "被動土壓力係數（由 Caquot-Kerisel 理論或圖表查得，條文無閉式）", "unit": "-", "min": 1, "max": 30},
            "gamma": {"desc": "土壤單位重", "unit": "t/m3", "min": 0.1, "max": 3}, "H": {"desc": "擋土牆（被動側）高度", "unit": "m", "min": 0}},
   "expr": "0.5*KP*gamma*H**2",
   "notes": "KP 條文僅說明可由 Caquot-Kerisel 理論推得或圖表（圖-解 7.3-1、7.3-2）查得，本庫不提供 KP 公式；δ 取值不宜大於 2φ/3，土楔法時不宜大於 φ/3（解說 3、4）。庫侖被動土壓力高估真實值。",
   "tests": [{"in": {"KP": 3.0, "gamma": 1.8, "H": 2}, "out": 10.8, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.227-229＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_KAE", "title": "地震主動土壓力係數 KAE（Mononobe-Okabe，式7.3-12）", "src": "found112", "clause": "7.3.4", "page": 232,
   "keywords": "地震 動態主動土壓力 KAE Mononobe-Okabe 擋土牆 kh kv", "unit": "-", "output": "KAE",
   "latex": "K_{AE}=\\frac{\\cos^2(\\phi-\\theta-\\varphi)}{\\cos\\varphi\\cos^2\\theta\\cos(\\delta+\\varphi+\\theta)\\left[1+\\sqrt{\\dfrac{\\sin(\\phi+\\delta)\\sin(\\phi-\\varphi-\\alpha)}{\\cos(\\delta+\\varphi+\\theta)\\cos(\\theta-\\alpha)}}\\right]^2},\\;\\varphi=\\tan^{-1}\\frac{k_h}{1-k_v}",
   "vars": {"phi": {"desc": "墻背土壤內摩擦角", "unit": "deg", "min": 0, "max": 60},
            "delta": {"desc": "墻背面與土壤間摩擦角", "unit": "deg", "min": 0, "max": 40},
            "theta": {"desc": "墻背面與垂直面交角（符號同 found112_Ka_coulomb）", "unit": "deg", "min": -45, "max": 45},
            "alpha": {"desc": "墻背地表與水平面之交角", "unit": "deg", "min": 0, "max": 45},
            "kh": {"desc": "水平向地震係數", "unit": "-", "min": 0, "max": 1},
            "kv": {"desc": "垂直向地震係數", "unit": "-", "default": 0.0, "min": 0, "max": 0.9}},
   "defs": [["vp", "degrees(atan(kh/(1-kv)))"]],
   "conditions": [{"expr": "phi-vp-alpha>=0", "msg": "φ−ϕ−α<0：地震角過大，無實數解，條文未規定此情況（土楔法或另行評估）"}],
   "expr": "cos(radians(phi-theta-vp))**2/(cos(radians(vp))*cos(radians(theta))**2*cos(radians(delta+vp+theta))*(1+sqrt(sin(radians(phi+delta))*sin(radians(phi-vp-alpha))/(cos(radians(delta+vp+theta))*cos(radians(theta-alpha)))))**2)",
   "notes": "原則上只適用非凝聚性土壤。PAE=½γH²(1−kv)KAE（found112_PAE）。作用點位置與 kh 之選取見 7.3.4 解說（p.232-233）。kh=kv=0 時退化為 found112_Ka_coulomb。",
   "tests": [{"in": {"phi": 30, "delta": 15, "theta": 0, "alpha": 0, "kh": 0.2, "kv": 0.0}, "out": 0.45203224886003435, "tol": 1e-9},
             {"in": {"phi": 30, "delta": 20, "theta": 10, "alpha": 10, "kh": 0.15, "kv": 0.05}, "out": 0.6289360783976398, "tol": 1e-9},
             {"in": {"phi": 30, "delta": 20, "theta": 10, "alpha": 10, "kh": 0.0, "kv": 0.0}, "out": 0.43757960529861567, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.232＋手算＋與 earth_pressure.py（M-O）交叉比對", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_PAE", "title": "地震主動土壓力合力 PAE=½γH²(1−kv)KAE（式7.3-11）", "src": "found112", "clause": "7.3.4", "page": 232,
   "keywords": "地震 動態主動土壓力 合力 PAE", "unit": "tf/m", "output": "PAE",
   "latex": "P_{AE}=\\tfrac12\\gamma H^2(1-k_v)K_{AE}",
   "vars": {"gamma": {"desc": "土壤單位重", "unit": "t/m3", "min": 0.1, "max": 3}, "H": {"desc": "擋土牆高度", "unit": "m", "min": 0},
            "kv": {"desc": "垂直向地震係數", "unit": "-", "default": 0.0, "min": 0, "max": 0.9}, "KAE": {"desc": "地震主動土壓力係數", "unit": "-", "min": 0, "max": 5}},
   "expr": "0.5*gamma*H**2*(1-kv)*KAE",
   "notes": "動態增量 ΔPAE=PAE−PA（解說 7.3-4）；作用點見解說。",
   "tests": [{"in": {"gamma": 1.8, "H": 4, "kv": 0.05, "KAE": 0.5}, "out": 6.84, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.232＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_KPE", "title": "地震被動土壓力係數 KPE（Mononobe-Okabe，式7.3-14）", "src": "found112", "clause": "7.3.5", "page": 234,
   "keywords": "地震 動態被動土壓力 KPE Mononobe-Okabe", "unit": "-", "output": "KPE",
   "latex": "K_{PE}=\\frac{\\cos^2(\\phi+\\theta-\\varphi)}{\\cos\\varphi\\cos^2\\theta\\cos(\\delta-\\theta+\\varphi)\\left[1-\\sqrt{\\dfrac{\\sin(\\phi+\\delta)\\sin(\\phi-\\varphi+\\alpha)}{\\cos(\\delta-\\theta+\\varphi)\\cos(\\alpha-\\theta)}}\\right]^2}",
   "vars": {"phi": {"desc": "內摩擦角", "unit": "deg", "min": 0, "max": 60},
            "delta": {"desc": "墻背面與土壤間摩擦角", "unit": "deg", "min": 0, "max": 40},
            "theta": {"desc": "墻背面與垂直面交角", "unit": "deg", "min": -45, "max": 45},
            "alpha": {"desc": "墻背地表與水平面之交角", "unit": "deg", "min": 0, "max": 45},
            "kh": {"desc": "水平向地震係數", "unit": "-", "min": 0, "max": 1},
            "kv": {"desc": "垂直向地震係數", "unit": "-", "default": 0.0, "min": 0, "max": 0.9}},
   "defs": [["vp", "degrees(atan(kh/(1-kv)))"]],
   "conditions": [{"expr": "phi-vp+alpha>=0", "msg": "φ−ϕ+α<0，無實數解"}],
   "expr": "cos(radians(phi+theta-vp))**2/(cos(radians(vp))*cos(radians(theta))**2*cos(radians(delta-theta+vp))*(1-sqrt(sin(radians(phi+delta))*sin(radians(phi-vp+alpha))/(cos(radians(delta-theta+vp))*cos(radians(alpha-theta)))))**2)",
   "notes": "PPE=½γH²(1−kv)KPE（式7.3-13）。只適用非凝聚性土壤；δ 不宜高估（≤2φ/3）。kh=kv=0 且 δ=θ=α=0 時＝tan²(45+φ/2)（被動朗肯）。",
   "tests": [{"in": {"phi": 30, "delta": 0, "theta": 0, "alpha": 0, "kh": 0.0, "kv": 0.0}, "out": 3.0000000000000004, "tol": 1e-9},
             {"in": {"phi": 30, "delta": 10, "theta": 0, "alpha": 0, "kh": 0.2, "kv": 0.0}, "out": 3.4995326416187016, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.234＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_Pw_water", "title": "墻背水壓力 PW=½γwHw²（式7.3-15）", "src": "found112", "clause": "7.3.6", "page": 235,
   "keywords": "水壓力 墻背水位 Pw 靜水壓", "unit": "tf/m", "output": "Pw",
   "latex": "P_W=\\tfrac12\\gamma_wH_w^2",
   "vars": {"Hw": {"desc": "墻背水位高度（自基礎底面起算）", "unit": "m", "min": 0}, "gamma_w": {"desc": "水單位重", "unit": "t/m3", "default": 1.0, "min": 0.9, "max": 1.1}},
   "expr": "0.5*gamma_w*Hw**2",
   "notes": "合力作用點在基礎底面以上 Hw/3。墻背及墻底有滲流時須考慮滲流影響。地震時動水壓力增量見 found112_dPWE。",
   "tests": [{"in": {"Hw": 3}, "out": 4.5, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.235＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_dPWE", "title": "地震動水壓力增量 ΔPWE=7/12·kh·γw·b·H²（Westergaard，解說式 7.3-8）", "src": "found112", "clause": "7.3.6", "page": 236,
   "keywords": "動水壓力 地震 Westergaard 水壓", "unit": "tf", "output": "dPWE",
   "latex": "\\Delta P_{WE}=\\frac{7}{12}k_h\\gamma_w bH^2,\\quad H_g=\\frac25H",
   "vars": {"kh": {"desc": "水平向地震係數", "unit": "-", "min": 0, "max": 1}, "gamma_w": {"desc": "水單位重", "unit": "t/m3", "default": 1.0, "min": 0.9, "max": 1.1},
            "b": {"desc": "與動水壓作用方向垂直之擋土牆寬度（可取 1 m）", "unit": "m", "default": 1.0, "min": 0}, "H": {"desc": "水深", "unit": "m", "min": 0}},
   "expr": "7/12*kh*gamma_w*b*H**2",
   "notes": "出自 7.3.6【解說】3（非條文本文）；合力作用點高度 Hg=2H/5（解說 7.3-9）。土側地下水之動水壓條文未提供算式（解說 4）。",
   "tests": [{"in": {"kh": 0.2, "H": 3}, "out": 1.05, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.236＋手算", "by": "agent", "date": "2026-11-01"}}
 ],
