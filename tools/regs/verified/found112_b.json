 "formulas": [
  {"id": "found112_qu_ultimate", "title": "淺基礎極限支承力 qu（式4.3-1，表4.3-1、4.3-2 因素）", "src": "found112", "clause": "4.3.1", "page": 53,
   "keywords": "極限支承力 承載力 淺基礎 bearing capacity qu 獨立基腳 Meyerhof", "unit": "tf/m2", "output": "qu",
   "latex": "q_u=cN_cF_{cs}F_{cd}F_{ci}+\\gamma_2D_fN_qF_{qs}F_{qd}F_{qi}+0.5\\gamma_1BN_\\gamma F_{rs}F_{rd}F_{ri}",
   "vars": {"c": {"desc": "基礎板底面以下土壤凝聚力", "unit": "tf/m2", "min": 0},
            "phi": {"desc": "土壤摩擦角 φ", "unit": "deg", "min": 0, "max": 50},
            "gamma1": {"desc": "基礎板底以下 B 深度範圍內土壤平均單位重（水位以下用有效單位重）", "unit": "tf/m3", "min": 0.1, "max": 3},
            "gamma2": {"desc": "基礎板底以上土壤平均單位重（水位以下用有效單位重）", "unit": "tf/m3", "min": 0.1, "max": 3},
            "Df": {"desc": "基礎附近最低地面至板底深度（鄰近有開挖須考慮）", "unit": "m", "min": 0},
            "B": {"desc": "矩形基腳短邊長（圓形為直徑）", "unit": "m", "min": 0.01},
            "L": {"desc": "矩形基腳長邊長", "unit": "m", "min": 0.01},
            "beta": {"desc": "載重方向與鉛直線夾角 β", "unit": "deg", "default": 0.0, "min": 0, "max": 89}},
   "lookups": [{"table": "found112_bearing_N", "x": "phi", "map": {"Nc": "Nc", "Nq": "Nq", "Ng": "Ng"}}],
   "defs": [["t2", "tan(radians(45+phi/2))**2"], ["t1", "tan(radians(45+phi/2))"],
            ["Fcs", "min(1+0.2*B/L,1.2) if phi<10 else 1+0.2*(B/L)*t2"], ["Fqs", "1.0 if phi<10 else 1+0.1*(B/L)*t2"], ["Frs", "1.0 if phi<10 else 1+0.1*(B/L)*t2"],
            ["Fcd", "min(1+0.2*Df/B,1.5) if phi<10 else 1+0.2*(Df/B)*t1"], ["Fqd", "1.0 if phi<10 else 1+0.1*(Df/B)*t1"], ["Frd", "1.0 if phi<10 else 1+0.1*(Df/B)*t1"],
            ["Fci", "(1-beta/90)**2"], ["Fqi", "(1-beta/90)**2"], ["Fri", "0.0 if beta>=phi else (1-beta/phi)**2"]],
   "expr": "c*Nc*Fcs*Fcd*Fci+gamma2*Df*Nq*Fqs*Fqd*Fqi+0.5*gamma1*B*Ng*Frs*Frd*Fri",
   "conditions": [{"expr": "B<=L", "msg": "B 須為短邊（B≤L）"}],
   "notes": "φ<10° 用 φ=0 法（形狀與埋置深度因素有上限）。Nc、Nq、Nγ 由表 4.3-1 階梯取不大於 φ 之整數度列（保守，表為整數度）。基礎剪力破壞型式（全面／局部／貫穿）已併入表值之修正。飽和黏土不排水以總應力法 c=su、φ=0、γ2 取總單位重（解說3）。極限支承力非允許值：容許支承力見 found112_qa_from_qu 與 FS 表 found112_FS_vertical_T435。偏心載重基礎請用 found112_qu_eccentric；斜坡及層狀地層（4.3.3）須另行特殊考慮。",
   "tests": [{"in": {"c": 0, "phi": 30, "gamma1": 1.0, "gamma2": 1.8, "Df": 1.5, "B": 2, "L": 2}, "out": 48.56100597057714, "tol": 1e-9},
             {"in": {"c": 2.0, "phi": 0, "gamma1": 1.8, "gamma2": 1.8, "Df": 1.0, "B": 2.0, "L": 4.0}, "out": 14.626000000000001, "tol": 1e-9},
             {"in": {"c": 0.5, "phi": 34, "gamma1": 0.9, "gamma2": 1.7, "Df": 2.0, "B": 3.0, "L": 6.0, "beta": 10}, "out": 109.46171043860711, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.53-56（式4.3-1、表4.3-1、表4.3-2）＋獨立手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_qu_eccentric", "title": "偏心載重基礎淨極限支承力與容許偏心載重（解說式 4.3-1~4.3-8，有效面積法）", "src": "found112", "clause": "4.3.2", "page": 59,
   "keywords": "偏心 有效面積 Meyerhof 淨極限支承力 容許載重", "unit": "tf", "output": "Pa",
   "latex": "B'=B-2e_B,\\;L'=L-2e_L,\\;q'_{u,net}=cN_cF_{cs}F_{cd}F_{ci}+\\gamma_2D_fN_qF_{qs}F_{qd}F_{qi}+0.5\\gamma_1B'N_\\gamma^*F_{rs}F_{rd}F_{ri}-\\gamma_2D_f,\\;P_a=q'_{u,net}B'L'/FS+\\gamma_2D_fB'L'",
   "vars": {"c": {"desc": "土壤凝聚力", "unit": "tf/m2", "min": 0},
            "phi": {"desc": "土壤摩擦角", "unit": "deg", "min": 0, "max": 50},
            "gamma1": {"desc": "板底以下土壤平均單位重", "unit": "tf/m3", "min": 0.1, "max": 3},
            "gamma2": {"desc": "板底以上土壤平均單位重", "unit": "tf/m3", "min": 0.1, "max": 3},
            "Df": {"desc": "埋置深度", "unit": "m", "min": 0},
            "B": {"desc": "基礎寬", "unit": "m", "min": 0.01}, "L": {"desc": "基礎長", "unit": "m", "min": 0.01},
            "eB": {"desc": "B 方向偏心量", "unit": "m", "min": 0}, "eL": {"desc": "L 方向偏心量", "unit": "m", "default": 0.0, "min": 0},
            "beta": {"desc": "載重傾角", "unit": "deg", "default": 0.0, "min": 0, "max": 89},
            "FS": {"desc": "安全係數（表4.3-1：長期3.0、短期2.0、極限1.1）", "unit": "-", "min": 1.0},
            "use_Ng_star": {"desc": "使用偏心專用 Nγ*＝1（表註）；＝0 用 Nγ", "unit": "-", "default": 1, "min": 0, "max": 1}},
   "lookups": [{"table": "found112_bearing_N", "x": "phi", "map": {"Nc": "Nc", "Nq": "Nq", "Ng0": "Ng", "Ngs": "Ng*"}}],
   "defs": [["Bp", "B-2*eB"], ["Lp", "L-2*eL"], ["Ng", "Ngs if use_Ng_star>0.5 else Ng0"], ["t2", "tan(radians(45+phi/2))**2"], ["t1", "tan(radians(45+phi/2))"],
            ["Fcs", "min(1+0.2*Bp/Lp,1.2) if phi<10 else 1+0.2*(Bp/Lp)*t2"], ["Fqs", "1.0 if phi<10 else 1+0.1*(Bp/Lp)*t2"], ["Frs", "1.0 if phi<10 else 1+0.1*(Bp/Lp)*t2"],
            ["Fcd", "min(1+0.2*Df/Bp,1.5) if phi<10 else 1+0.2*(Df/Bp)*t1"], ["Fqd", "1.0 if phi<10 else 1+0.1*(Df/Bp)*t1"], ["Frd", "1.0 if phi<10 else 1+0.1*(Df/Bp)*t1"],
            ["Fci", "(1-beta/90)**2"], ["Fqi", "(1-beta/90)**2"], ["Fri", "0.0 if beta>=phi else (1-beta/phi)**2"],
            ["qnet", "c*Nc*Fcs*Fcd*Fci+gamma2*Df*Nq*Fqs*Fqd*Fqi+0.5*gamma1*Bp*Ng*Frs*Frd*Fri-gamma2*Df"]],
   "expr": "qnet*Bp*Lp/FS+gamma2*Df*Bp*Lp",
   "conditions": [{"expr": "Bp>0 and Lp>0", "msg": "有效寬度 B'=B−2eB 與 L'=L−2eL 須為正"}, {"expr": "Bp<=Lp", "msg": "B' 須為有效短邊（B'≤L'）"}],
   "warn_if": [{"expr": "eB>B/3 or eL>L/3", "msg": "偏心量超過基礎板尺寸 1/3：短期載重情況最大偏心量不得大於 1/3、長期不得大於 1/6（4.3.2 第2項）"},
               {"expr": "eB>B/6 or eL>L/6", "msg": "偏心量超過 1/6：長期載重情況不得（4.3.2 第2項）；並須檢核旋轉角對上部結構之影響"}],
   "notes": "矩形基礎；steps.qnet 為淨極限支承力 q'u,net（tf/m2）、Bp/Lp 為有效尺寸。原書式(解 4.3-7) 印的是 Nγ（未加*），而表 4.3-1 註記 Nγ* 為偏心載重基礎使用，二者不一致：本庫預設用 Nγ*（保守需看 φ，Nγ* 在 φ≥30° 大於 Nγ），可用 use_Ng_star=0 改用 Nγ，使用前請確認。圓形基礎的有效面積（解 4.3-6）未收錄。此式為【解說】提供之方法，非條文本文。",
   "tests": [{"in": {"c": 0, "phi": 30, "gamma1": 1.0, "gamma2": 1.8, "Df": 1.5, "B": 2, "L": 3, "eB": 0.2, "eL": 0.1, "FS": 3.0}, "out": 87.40686475852603, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.58-60＋獨立手算（Nγ/Nγ* 不一致已揭露）", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_qa_from_qu", "title": "容許支承力 qa=(qu−γ2Df)/FS+γ2Df（4.3.5）", "src": "found112", "clause": "4.3.5", "page": 63,
   "keywords": "容許支承力 安全係數 qa 淨極限支承力", "unit": "tf/m2", "output": "qa",
   "latex": "q_a=\\frac{q_u-\\gamma_2D_f}{FS}+\\gamma_2D_f",
   "vars": {"qu": {"desc": "極限支承力", "unit": "tf/m2", "min": 0}, "gamma2": {"desc": "板底以上土壤單位重", "unit": "tf/m3", "min": 0.1, "max": 3},
            "Df": {"desc": "埋置深度", "unit": "m", "min": 0}, "FS": {"desc": "安全係數（表 found112_FS_vertical_T435）", "unit": "-", "min": 1.0}},
   "expr": "(qu-gamma2*Df)/FS+gamma2*Df",
   "notes": "條文：極限支承力扣除基礎底面以上挖除土重得淨極限支承力，除以安全係數後再加上挖除土重；沉陷量須小於容許沉陷量。短期載重（地震、風、暴雨、積雪）容許支承力得提高 50%（解說，對應 FS=2.0）。",
   "tests": [{"in": {"qu": 100, "gamma2": 1.8, "Df": 1.5, "FS": 3.0}, "out": 35.13333333333333, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐字對照原頁圖 p.63＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_delta_base", "title": "基礎底面摩擦角 δ（4.6.2 解說）", "src": "found112", "clause": "4.6.2", "page": 82,
   "keywords": "底面摩擦角 delta 場鑄 預鑄 硬岩", "unit": "deg", "output": "delta",
   "latex": "\\delta=\\phi'\\;(\\text{場鑄});\\;\\tfrac23\\phi'\\;(\\text{預鑄});\\;\\text{硬岩 }\\delta\\le45^\\circ\\,(\\text{場鑄})/30^\\circ\\,(\\text{預鑄})",
   "vars": {"phi": {"desc": "地層有效內摩擦角 φ'（硬岩時給 δ 對應之 φ'）", "unit": "deg", "min": 0, "max": 60},
            "precast": {"desc": "預鑄施工＝1；現場澆注＝0", "unit": "-", "min": 0, "max": 1},
            "hard_rock": {"desc": "支承層為硬岩＝1；土壤或軟岩＝0", "unit": "-", "min": 0, "max": 1}},
   "defs": [["d0", "(2*phi/3) if precast>0.5 else phi"]],
   "expr": "min(d0, 30 if precast>0.5 else 45) if hard_rock>0.5 else d0",
   "notes": "條文 4.6.2 本文：δ 土壤或軟岩取 2/3φ' 至 φ'；硬岩取 30° 至 45°。本式依【解說】1 之選用原則（場鑄／預鑄、土壤／硬岩）。",
   "tests": [{"in": {"phi": 30, "precast": 0, "hard_rock": 0}, "out": 30.0}, {"in": {"phi": 30, "precast": 1, "hard_rock": 0}, "out": 20.0},
             {"in": {"phi": 50, "precast": 0, "hard_rock": 1}, "out": 45.0}, {"in": {"phi": 50, "precast": 1, "hard_rock": 1}, "out": 30.0}],
   "status": "verified", "verified": {"method": "逐字對照原頁圖 p.81-83＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_Rf_base_friction", "title": "基礎板底面摩擦阻力 Rf=N·tanδ+A·ca（式4.6-1）", "src": "found112", "clause": "4.6.2", "page": 81,
   "keywords": "滑動 摩擦阻力 底面 Rf 水平支承力", "unit": "tf", "output": "Rf",
   "latex": "R_f=N\\tan\\delta+Ac_a",
   "vars": {"N": {"desc": "作用於基礎板底面之有效鉛直載重", "unit": "tf", "min": 0}, "delta": {"desc": "底面混凝土與地層間摩擦角（found112_delta_base）", "unit": "deg", "min": 0, "max": 60},
            "A": {"desc": "基礎板底面有效接觸面積", "unit": "m2", "min": 0}, "ca": {"desc": "底面與地層之有效附著力", "unit": "tf/m2", "min": 0}},
   "expr": "N*tan(radians(delta))+A*ca",
   "notes": "有效接觸面積依 4.3.2 解說（偏心時用 B'L'）。水平極限支承力為 Rf＋前側抵抗 Rp（found112_Rp_front），須滿足表 found112_FS_horizontal_T461。",
   "tests": [{"in": {"N": 100, "delta": 30, "A": 12, "ca": 0.5}, "out": 63.735026918962575, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.81＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_Rp_front", "title": "基礎板前側之側向抵抗力 Rp（式4.6-2，Rankine Kp、Ka 見解說）", "src": "found112", "clause": "4.6.3", "page": 82,
   "keywords": "前側抵抗 被動土壓力 側向抵抗 Rp 滑動", "unit": "tf", "output": "Rp",
   "latex": "R_P=\\alpha L(\\sigma_P\\Delta h)-L(\\sigma_A\\Delta h),\\;\\alpha=1.0+0.4D_f/L\\le2.0,\\;\\sigma_P=\\gamma h_eK_P+2c\\sqrt{K_P},\\;\\sigma_A=\\gamma h_eK_A-2c\\sqrt{K_A}",
   "vars": {"L": {"desc": "基礎板前側承受側向抵抗力之板寬度", "unit": "m", "min": 0.01}, "Df": {"desc": "地表至基礎板底之深度", "unit": "m", "min": 0},
            "he": {"desc": "地表至基礎板中心點之深度", "unit": "m", "min": 0}, "dh": {"desc": "基礎板厚度 Δh", "unit": "m", "min": 0},
            "gamma": {"desc": "地層平均有效單位重", "unit": "tf/m3", "min": 0.1, "max": 3}, "c": {"desc": "凝聚力", "unit": "tf/m2", "default": 0.0, "min": 0},
            "phi": {"desc": "有效內摩擦角（用 Rankine KP、KA：解說式 4.6-1、4.6-2）", "unit": "deg", "min": 0, "max": 60}},
   "defs": [["Kp", "tan(radians(45+phi/2))**2"], ["Ka", "tan(radians(45-phi/2))**2"], ["alpha", "min(1.0+0.4*Df/L,2.0)"],
            ["sP", "gamma*he*Kp+2*c*sqrt(Kp)"], ["sA", "gamma*he*Ka-2*c*sqrt(Ka)"]],
   "expr": "alpha*L*(sP*dh)-L*(sA*dh)",
   "notes": "KP、KA 條文以 Rankine 公式例示（解說 4.6-1、4.6-2）；若採其他 KP（如 Caquot-Kerisel）請自行代入 sP。α 的建議值見圖-解 4.6-1。須滿足表 4.6-1 水平承載之安全係數。",
   "tests": [{"in": {"L": 3, "Df": 1.2, "he": 0.6, "dh": 0.4, "gamma": 1.8, "c": 0.5, "phi": 30}, "out": 7.181915047163425, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.82-83＋手算", "by": "agent", "date": "2026-11-01"}}
 ],
