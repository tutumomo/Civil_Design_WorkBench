{
 "formulas": [
  {"id": "found112_FL_HBF", "title": "土壤液化抗液化安全係數 FL（HBF 法，解說式 10.3-1~12）", "src": "found112", "clause": "10.3", "page": 315,
   "keywords": "液化 抗液化安全係數 FL HBF 黃俊鴻 SPT-N CRR CSR 土壤液化潛能", "unit": "-", "output": "FL",
   "latex": "F_L=\\frac{CRR}{CSR},\\;CRR=CRR_{7.5}\\left(\\frac{M_w}{7.5}\\right)^{-1.8},\\;CRR_{7.5}=0.08+\\frac{0.0035(N_1)_{60cs}}{1-(N_1)_{60cs}/39},\\;CSR=0.65\\frac{A}{g}\\frac{\\sigma_{v0}}{\\sigma'_{v0}}r_d",
   "vars": {"z": {"desc": "評估土層距地表深度", "unit": "m", "min": 0.1, "max": 20},
            "hw": {"desc": "地下水位深度（鑽探時水位）", "unit": "m", "min": 0, "max": 20},
            "gamma_t1": {"desc": "地下水位面上方土壤單位體積重", "unit": "tf/m3", "min": 0.5, "max": 3},
            "gamma_t2": {"desc": "地下水位面下方土壤單位體積重", "unit": "tf/m3", "min": 0.5, "max": 3},
            "gamma_t2e": {"desc": "地下水位面下方土壤有效單位體積重", "unit": "tf/m3", "min": 0.1, "max": 2.5},
            "A": {"desc": "尖峰水平地表加速度（以 g 計）", "unit": "g", "min": 0.01, "max": 1.5},
            "Mw": {"desc": "地震矩規模", "unit": "-", "min": 4, "max": 9.5},
            "N60": {"desc": "鑽桿傳遞貫入能量比 60% 之 SPT N 值", "unit": "blows/30cm", "min": 0, "max": 100},
            "FC": {"desc": "細粒含量（<75μm 通過重量百分率）", "unit": "%", "min": 0, "max": 100}},
   "defs": [["sv", "gamma_t1*hw+gamma_t2*(z-hw)"], ["sve", "gamma_t1*hw+gamma_t2e*(z-hw)"],
            ["rd", "1.0-0.01*z if z<=10 else 1.2-0.03*z"], ["CSR", "0.65*A*sv/sve*rd"],
            ["CN", "min(sqrt(10.2/sve),1.7)"], ["N1_60", "CN*N60"], ["Ks", "1.0 if FC<=10 else 1+0.07*sqrt(FC-10)"],
            ["N1cs", "Ks*N1_60"], ["CRR75", "0.08+0.0035*N1cs/(1-N1cs/39)"], ["MSF", "(Mw/7.5)**(-1.8)"], ["CRR", "CRR75*MSF"]],
   "expr": "CRR/CSR",
   "conditions": [{"expr": "z>=hw", "msg": "評估土層須位於地下水位以下（z≥hw）"}, {"expr": "N1cs<39", "msg": "(N1)60cs≥39，式(解 10.3-3) 分母≤0，原文未規定此情況"}],
   "warn_if": [{"expr": "result<1.0", "msg": "FL<1.0：依 10.3 本文判定該土層為液化土層"}],
   "notes": "式出自 10.3【解說】(1) HBF 法（黃俊鴻等，2012）。適用：地表下 20 m 內、地下水位以下之飽和土層、塑性指數 Ip<7。N60 須由鑽桿能量比換算（無實測：自由落錘 70%、拉索式 60%）。Pa=10.2 tf/m2。本條文本文僅規定 FL=CRR/CSR 且 FL<1.0 判定液化；方法選擇（HBF／NCEER／AIJ／JRA）見解說。單位 tf、m。",
   "tests": [{"in": {"z": 6, "hw": 1.5, "gamma_t1": 1.8, "gamma_t2": 1.9, "gamma_t2e": 0.9, "A": 0.3, "Mw": 7.3, "N60": 12, "FC": 20}, "out": 0.6776822835209116, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.314-317（式解10.3-1~12）＋獨立手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_FL_NCEER", "title": "土壤液化抗液化安全係數 FL（NCEER 2001 法，解說式 10.3-13~25）", "src": "found112", "clause": "10.3", "page": 317,
   "keywords": "液化 FL NCEER Youd Seed SPT-N CRR CSR 土壤液化潛能", "unit": "-", "output": "FL",
   "latex": "CRR_{7.5}=\\frac{1}{34-x}+\\frac{x}{135}+\\frac{50}{[10x+45]^2}-\\frac{1}{200},\\;x=(N_1)_{60cs}=\\alpha+\\beta(N_1)_{60},\\;MSF=(M_w/7.5)^{-2.56}",
   "vars": {"z": {"desc": "評估土層距地表深度", "unit": "m", "min": 0.1, "max": 20},
            "hw": {"desc": "地下水位深度", "unit": "m", "min": 0, "max": 20},
            "gamma_t1": {"desc": "地下水位面上方土壤單位體積重", "unit": "tf/m3", "min": 0.5, "max": 3},
            "gamma_t2": {"desc": "地下水位面下方土壤單位體積重", "unit": "tf/m3", "min": 0.5, "max": 3},
            "gamma_t2e": {"desc": "地下水位面下方土壤有效單位體積重", "unit": "tf/m3", "min": 0.1, "max": 2.5},
            "A": {"desc": "尖峰水平地表加速度（以 g 計）", "unit": "g", "min": 0.01, "max": 1.5},
            "Mw": {"desc": "地震矩規模", "unit": "-", "min": 4, "max": 9.5},
            "N60": {"desc": "鑽桿傳遞貫入能量比 60% 之 SPT N 值", "unit": "blows/30cm", "min": 0, "max": 100},
            "FC": {"desc": "細粒含量", "unit": "%", "min": 0.0001, "max": 100}},
   "defs": [["sv", "gamma_t1*hw+gamma_t2*(z-hw)"], ["sve", "gamma_t1*hw+gamma_t2e*(z-hw)"],
            ["rd", "(1-0.4113*z**0.5+0.04052*z+0.001753*z**1.5)/(1-0.4177*z**0.5+0.05729*z-0.006205*z**1.5+0.00121*z**2)"],
            ["CSR", "0.65*A*sv/sve*rd"], ["CN", "min(sqrt(10.2/sve),1.7)"], ["N1_60", "CN*N60"],
            ["alpha", "0.0 if FC<=5 else (exp(1.76-190/FC**2) if FC<=35 else 5.0)"], ["beta", "1.0 if FC<=5 else (0.99+FC**1.5/1000 if FC<=35 else 1.2)"],
            ["x", "alpha+beta*N1_60"], ["CRR75", "1/(34-x)+x/135+50/(10*x+45)**2-1/200"], ["MSF", "(Mw/7.5)**(-2.56)"], ["CRR", "CRR75*MSF"]],
   "expr": "CRR/CSR",
   "conditions": [{"expr": "z>=hw", "msg": "評估土層須位於地下水位以下（z≥hw）"}, {"expr": "x<34", "msg": "(N1)60cs≥34，式(解 10.3-15) 無定義，原文未規定此情況"}],
   "warn_if": [{"expr": "result<1.0", "msg": "FL<1.0：依 10.3 本文判定該土層為液化土層"}],
   "notes": "式出自 10.3【解說】(2) NCEER(2001) 法。rd 為 Youd 等之深度折減係數（式解 10.3-23，適用 z≤20 m）。Pa=10.2 tf/m2。單位 tf、m。",
   "tests": [{"in": {"z": 6, "hw": 1.5, "gamma_t1": 1.8, "gamma_t2": 1.9, "gamma_t2e": 0.9, "A": 0.3, "Mw": 7.3, "N60": 12, "FC": 20}, "out": 0.7221185459866606, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.317-320（式解10.3-13~25）＋獨立手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "found112_FL_JRA", "title": "土壤液化抗液化安全係數 FL（JRA 1996 法，解說式 10.3-35~45）", "src": "found112", "clause": "10.3", "page": 324,
   "keywords": "液化 FL JRA 日本道路協會 N72 砂質土 礫質土 CRR CSR", "unit": "-", "output": "FL",
   "latex": "CRR=0.0882\\sqrt{N_a/1.7}\\;(N_a<14);\\;+1.6\\times10^{-6}(N_a-14)^{4.5}\\;(N_a\\ge14),\\;(N_1)_{72}=17\\frac{N_{72}}{\\sigma'_{v0}+7},\\;CSR=\\frac{A}{g}\\frac{\\sigma_{v0}}{\\sigma'_{v0}}r_d,\\;r_d=1-0.015z",
   "vars": {"z": {"desc": "評估土層距地表深度", "unit": "m", "min": 0.1, "max": 20},
            "hw": {"desc": "地下水位深度（須在地表下 10 m 內）", "unit": "m", "min": 0, "max": 10},
            "gamma_t1": {"desc": "地下水位面上方土壤單位體積重", "unit": "tf/m3", "min": 0.5, "max": 3},
            "gamma_t2": {"desc": "地下水位面下方土壤單位體積重", "unit": "tf/m3", "min": 0.5, "max": 3},
            "gamma_t2e": {"desc": "地下水位面下方土壤有效單位體積重", "unit": "tf/m3", "min": 0.1, "max": 2.5},
            "A": {"desc": "尖峰水平地表加速度（以 g 計）", "unit": "g", "min": 0.01, "max": 1.5},
            "N72": {"desc": "鑽桿傳遞貫入能量比 72% 之 SPT N 值", "unit": "blows/30cm", "min": 0, "max": 100},
            "FC": {"desc": "細粒含量", "unit": "%", "min": 0, "max": 100},
            "gravel": {"desc": "礫質土＝1（式解10.3-41）；砂質土＝0", "unit": "-", "default": 0, "min": 0, "max": 1},
            "D50": {"desc": "通過率 50% 之粒徑（礫質土才用）", "unit": "mm", "default": 1.0, "min": 0.05, "max": 10}},
   "defs": [["sv", "gamma_t1*hw+gamma_t2*(z-hw)"], ["sve", "gamma_t1*hw+gamma_t2e*(z-hw)"], ["rd", "1-0.015*z"], ["CSR", "A*sv/sve*rd"],
            ["N1_72", "17*N72/(sve+7)"],
            ["C1", "1.0 if FC<10 else ((FC+40)/50 if FC<60 else FC/20-1)"], ["C2", "0.0 if FC<10 else (FC-10)/18"],
            ["Na", "(1-0.36*log10(D50/2))*N1_72 if gravel>0.5 else C1*N1_72+C2"],
            ["CRR", "0.0882*sqrt(Na/1.7) if Na<14 else 0.0882*sqrt(Na/1.7)+1.6e-6*(Na-14)**4.5"]],
   "expr": "CRR/CSR",
   "conditions": [{"expr": "z>=hw", "msg": "評估土層須位於地下水位以下（z≥hw）"}, {"expr": "Na>0", "msg": "Na≤0，CRR 無定義"}],
   "warn_if": [{"expr": "result<1.0", "msg": "FL<1.0：依 10.3 本文判定該土層為液化土層"}],
   "notes": "式出自 10.3【解說】(4) JRA(1996) 法。適用條件：地表下 20 m 內飽和砂土層且地下水位在地表下 10 m 內；FC≤35% 或 FC>35% 且 Ip≤15；D50≤10 mm、D10≤1 mm。此法不考慮地震規模，CSR 用尖峰剪應力比。本書解說式未含 JRA 原規範之地震動特性修正係數 cw，使用前請對照原規範。σ'v0 以 tf/m2 代入（式解 10.3-38 為 +7）。",
   "tests": [{"in": {"z": 6, "hw": 1.5, "gamma_t1": 1.8, "gamma_t2": 1.9, "gamma_t2e": 0.9, "A": 0.3, "N72": 10, "FC": 20}, "out": 0.5832982992164374, "tol": 1e-9},
             {"in": {"z": 8, "hw": 2, "gamma_t1": 1.8, "gamma_t2": 1.9, "gamma_t2e": 0.9, "A": 0.4, "N72": 30, "FC": 5}, "out": 1.8281560466786375, "tol": 1e-9},
             {"in": {"z": 8, "hw": 2, "gamma_t1": 1.8, "gamma_t2": 1.9, "gamma_t2e": 0.9, "A": 0.4, "N72": 30, "FC": 5, "gravel": 1, "D50": 10}, "out": 0.6438982341759185, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.323-325（式解10.3-35~45）＋獨立手算", "by": "agent", "date": "2026-11-01"}}
