  {
   "id": "found112_Qu_pile",
   "title": "單樁極限垂直支承力 Qu=fs·As+qb·Ab（式5.3-1）",
   "src": "found112",
   "clause": "5.3.1",
   "page": 98,
   "keywords": "基樁 單樁 極限垂直支承力 Qu 摩擦 端點",
   "unit": "tf",
   "output": "Qu",
   "latex": "Q_u=Q_s+Q_b=f_sA_s+q_bA_b",
   "vars": {
    "fs": {
     "desc": "樁表面摩擦阻力",
     "unit": "tf/m2",
     "min": 0
    },
    "As": {
     "desc": "樁身表面積",
     "unit": "m2",
     "min": 0
    },
    "qb": {
     "desc": "樁端極限支承壓力",
     "unit": "tf/m2",
     "min": 0
    },
    "Ab": {
     "desc": "樁端斷面積",
     "unit": "m2",
     "min": 0
    }
   },
   "defs": [
    [
     "Qs",
     "fs*As"
    ],
    [
     "Qb",
     "qb*Ab"
    ]
   ],
   "expr": "Qs+Qb",
   "notes": "fs、qb 須由靜力學公式、貫入試驗公式、樁載重試驗或動態分析推估（本庫未收錄各推估法）。容許支承力見 found112_Qa_pile。單位 tf、m。",
   "tests": [
    {
