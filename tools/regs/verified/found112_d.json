  {
   "id": "hwdrain107_bridge_backwater",
   "title": "橋梁壅水高度 h（附錄R R-1，d'Aubuisson 公式）",
   "src": "hwdrain107",
   "clause": "附錄R",
   "page": 144,
   "keywords": "橋梁 壅水 迴水 d'Aubuisson 束縮係數 Ka",
   "unit": "m",
   "output": "h",
   "latex": "h=\\frac{1}{2g}\\left[\\left(\\frac{Q}{K_a b_2 y_3}\\right)^2-V_1^2\\right]",
   "vars": {
    "Q": {
     "desc": "設計流量",
     "unit": "m3/s",
     "min": 0
    },
    "Ka": {
     "desc": "束縮係數（表 hwdrain107_Ka_TR1）",
     "unit": "-",
     "min": 0.5,
     "max": 2
    },
    "b2": {
     "desc": "橋墩處淨通水寬度",
     "unit": "m",
     "min": 0.1
    },
    "y3": {
     "desc": "橋梁下游側等速流水深",
     "unit": "m",
     "min": 0.01
    },
    "V1": {
     "desc": "橋梁上游側橫斷面平均流速",
     "unit": "m/s",
     "min": 0
    },
    "g": {
     "desc": "重力加速度",
     "unit": "m/s2",
     "default": 9.8
    }
   },
   "expr": "((Q/(Ka*b2*y3))**2-V1**2)/(2*g)",
   "warn_if": [
    {
     "expr": "Q/(Ka*b2*y3)<=V1",
     "msg": "橋墩處流速不大於上游流速，壅水高度≤0（無壅水）"
    }
   ],
   "notes": "附錄R 摘自 Ven Te Chow《Open-Channel Hydraulics》1959 與 HEC-2 手冊，適用於亂流程度較大之流況。相關章節 7.3.2。",
   "tests": [
    {
     "in": {
      "Q": 50,
      "Ka": 0.9,
      "b2": 8.0,
      "y3": 1.5,
      "V1": 1.0
     },
     "out": 1.0425240054869684,
     "tol": 1e-09
    }
   ],
   "status": "verified",
   "verified": {
    "method": "逐式對照原頁圖 p.144（式R-1）＋手算",
    "by": "agent",
    "date": "2026-11-01"
   }
  },
  {
   "id": "found112_Ra_uplift",
   "title": "單樁容許拉拔力 Ra（式5.3-5、5.3-6）",
   "src": "found112",
   "clause": "5.3.2",
   "page": 113,
   "keywords": "基樁 拉拔力 抗拉拔 上浮 uplift Ra 樁載重試驗",
   "unit": "tf",
   "output": "Ra",
   "latex": "R_a=W_p+\\frac{1}{FS}f_sA_s;\\quad R_a=W_p+\\frac{Q_{ut}-W_p}{FS}",
   "vars": {
    "mode": {
     "desc": "以摩擦阻力推估＝0；以樁載重試驗＝1",
     "unit": "-",
     "default": 0,
     "min": 0,
     "max": 1
    },
    "Wp": {
     "desc": "樁體重量（應考慮地下水之影響）",
     "unit": "tf",
     "min": 0
    },
    "fs": {
     "desc": "樁表面摩擦阻力（依5.3.1推估）",
     "unit": "tf/m2",
     "default": 0.0,
     "min": 0
    },
    "As": {
     "desc": "樁之表面積",
     "unit": "m2",
     "default": 0.0,
     "min": 0
    },
    "Qut": {
     "desc": "單樁極限拉拔力（試驗值）",
     "unit": "tf",
     "default": 0.0,
     "min": 0
    },
    "FS": {
     "desc": "拉拔力安全係數（表 found112_FS_uplift_T533）",
     "unit": "-",
     "min": 1.0,
     "max": 6
    }
   },
   "defs": [
    [
     "Ra",
     "Wp+(Qut-Wp)/FS if mode>0.5 else Wp+fs*As/FS"
    ]
   ],
   "expr": "Ra",
   "warn_if": [
    {
     "expr": "Wp<0 or As<0",
     "msg": "Wp、As 不得為負"
    }
   ],
   "notes": "樁底為擴座式者應依可能破壞模式分析，且**任何情況下容許拉拔力不得超過容許垂直支承力之 75%**（本式未自動換算，須另行比對 found112_Qa_pile）。表5.3-1 之拉拔力安全係數：常時 2.0／5.0、短期 1.5／3.0、極限 1.2／2.4（試驗值／推估公式）。",
   "tests": [
    {
     "in": {
      "mode": 0,
      "Wp": 10,
      "fs": 8,
      "As": 20,
      "FS": 5.0
     },
     "out": 42.0
    },
    {
     "in": {
      "mode": 1,
      "Wp": 10,
      "Qut": 120,
      "FS": 2.0
     },
     "out": 65.0
    }
   ],
   "status": "verified",
   "verified": {
    "method": "逐式對照原頁圖 p.113（式5.3-5、5.3-6）＋手算",
    "by": "agent",
    "date": "2026-11-01"
   }
  },
  {
   "id": "found112_negative_friction",
   "title": "負摩擦力檢核（式5.3-7、5.3-8）",
   "src": "found112",
   "clause": "5.3.4",
   "page": 125,
   "keywords": "基樁 負摩擦力 中性點 下陷 群樁",
   "unit": "-",
   "output": "ratio1",
   "latex": "(P+P_{fn})/A_p\\le\\sigma_{sa};\\quad (P+P_{fn})\\le(Q_p+R_f)/1.2",
   "vars": {
    "P": {
     "desc": "樁頂部之長期軸向荷重",
     "unit": "tf",
     "min": 0
    },
    "Pfn": {
     "desc": "中立點以上之負摩擦力總和",
     "unit": "tf",
     "min": 0
    },
    "Ap": {
     "desc": "樁身斷面積",
     "unit": "m2",
     "min": 0.0001
    },
    "sigma_sa": {
     "desc": "樁材料之短期容許應力強度",
     "unit": "tf/m2",
     "min": 0
    },
    "Qp": {
     "desc": "樁端點之極限支承力",
     "unit": "tf",
     "min": 0
    },
    "Rf": {
     "desc": "樁身中立點以下之正摩擦阻力",
     "unit": "tf",
     "min": 0
    }
   },
   "defs": [
    [
     "ratio1",
     "(P+Pfn)/Ap"
    ],
    [
     "limit2",
     "(Qp+Rf)/1.2"
    ],
    [
     "ratio2",
     "(P+Pfn)/limit2"
    ]
   ],
   "expr": "ratio1",
   "warn_if": [
    {
     "expr": "(P+Pfn)/Ap>sigma_sa",
     "msg": "式(5.3-7) 不滿足：樁身應力超過短期容許應力"
    },
    {
     "expr": "(P+Pfn)>(Qp+Rf)/1.2",
     "msg": "式(5.3-8) 不滿足：軸力超過 (Qp+Rf)/1.2"
    }
   ],
   "notes": "輸出為 ratio1=(P+Pfn)/Ap（tf/m2），須 ≤ σsa；steps.limit2、ratio2 為式(5.3-8) 之檢核。中立點位置依樁支承地層與樁四周壓縮地層之相對勁度定之。考慮地震、風力、衝擊力、車輛等短期載重時可不計負摩擦力；群樁得考慮相互影響折減；樁表面特殊處理者得依實測折減。",
   "tests": [
    {
     "in": {
      "P": 100,
      "Pfn": 30,
      "Ap": 1.0,
      "sigma_sa": 200,
      "Qp": 200,
      "Rf": 80
     },
     "out": 130.0
    }
   ],
   "status": "verified",
   "verified": {
    "method": "逐式對照原頁圖 p.125（式5.3-7、5.3-8）＋手算",
    "by": "agent",
    "date": "2026-11-01"
   }
  },
