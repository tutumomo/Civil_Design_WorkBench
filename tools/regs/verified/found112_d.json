      "fs": 10,
      "As": 10,
      "qb": 50,
      "Ab": 3
     },
     "out": 250.0
    }
   ],
   "status": "verified",
   "verified": {
    "method": "逐式對照原頁圖 p.98（式5.3-1）＋手算",
    "by": "agent",
