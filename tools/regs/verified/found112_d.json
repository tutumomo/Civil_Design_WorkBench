  {
   "id": "found112_Pfn_group",
   "title": "群樁負摩擦力平均値 Pfn＝(UG·ΣLiτi＋AG·γs·Lfn)/np（式5.4-2）",
   "src": "found112",
   "clause": "5.4.2",
   "page": 134,
   "keywords": "群樁 負摩擦力 平均値 中立點",
   "unit": "tf",
   "output": "Pfn",
   "latex": "P_{fn}=\\frac{U_G\\sum L_i\\tau_i+A_G\\gamma_s L_{fn}}{n_p}",
   "vars": {
    "UG": {
     "desc": "群樁之外圍周邊長",
     "unit": "m",
     "min": 0
    },
    "sum_Ltau": {
     "desc": "Σ Li·τi：基礎底面至中立點間各土層厚度×剪強度之總和",
     "unit": "tf/m",
     "min": 0
    },
    "AG": {
     "desc": "扣除樁斷面積之群樁底面面積",
     "unit": "m2",
     "min": 0
    },
    "gamma_s": {
     "desc": "土壤單位重（地下水位以下用有效單位重）",
     "unit": "tf/m3",
     "min": 0
    },
    "Lfn": {
     "desc": "基礎底面至中立點之距離",
     "unit": "m",
     "min": 0
    },
    "np": {
     "desc": "樁數",
     "unit": "支",
     "min": 1
    }
   },
   "expr": "(UG*sum_Ltau+AG*gamma_s*Lfn)/np",
   "notes": "群樁之負摩擦力可考慮各樁相互影響折減；群樁中單樁負摩擦力應取本式與單樁法（found112_negative_friction 之 Pfn）**較大者**。本式只算群樁平均値。",
