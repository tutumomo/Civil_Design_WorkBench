{
 "formulas": [
  {
   "id": "found112_sigma_z_boussinesq",
   "title": "垂直應力增量 σz（Boussinesq 集中載重，解說式4.4-1）",
   "src": "found112",
   "clause": "4.4.3",
   "page": 64,
   "keywords": "應力增量 Boussinesq 垂直應力 集中載重 沉陷",
   "unit": "tf/m2",
   "output": "sigma_z",
   "latex": "\\sigma_z=\\frac{P}{2\\pi}\\times\\frac{3z^3}{R^5},\\quad R=\\sqrt{z^2+r^2}",
   "vars": {
    "P": {
     "desc": "垂直集中載重",
     "unit": "tf",
     "min": 0
    },
    "z": {
     "desc": "地層中深度",
     "unit": "m",
     "min": 0.01
    },
    "r": {
     "desc": "計算點與載重作用線之水平距離",
     "unit": "m",
     "min": 0
    }
   },
   "defs": [
    [
     "R",
     "sqrt(z**2+r**2)"
    ]
   ],
   "expr": "P/(2*pi)*3*z**3/R**5",
   "notes": "適用土層視為均質、均向、線彈性且柏松比 ν=0.5 之情況。淺基礎實務多以 2:1 法或其他彈性解（如影響圖）作「適當之修正」（4.4.3 本文允許），本工作區之 settlement_assessment 即採 2:1 法（見稽核的範圍差異）。",
   "tests": [
    {
     "in": {
      "P": 100,
      "z": 5,
      "r": 2
     },
     "out": 1.3178209414387168,
     "tol": 1e-09
    }
   ],
   "status": "verified",
   "verified": {
    "method": "逐式對照原頁圖 p.64（式解4.4-1）＋手算",
    "by": "agent",
    "date": "2026-11-01"
   }
  },
  {
   "id": "found112_dH_immediate_layers",
   "title": "瞬時沉陷分層法 ΔH=Σ(Hj/Ej)(Δσz−νΔσx−νΔσy)（解說式4.4-2）",
   "src": "found112",
   "clause": "4.4.5",
   "page": 66,
   "keywords": "瞬時沉陷 分層 沉陷量 變形模數 柏松比 immediate settlement",
   "unit": "m",
   "output": "dH",
   "latex": "\\Delta H_{i,p}=\\sum\\frac{H_j}{E_j}(\\Delta\\sigma_{zj}-\\nu_j\\Delta\\sigma_{xj}-\\nu_j\\Delta\\sigma_{yj})",
   "vars": {
    "H": {
     "desc": "該土層厚度",
     "unit": "m",
     "min": 0
    },
    "E": {
     "desc": "該土層變形模數",
     "unit": "tf/m2",
     "min": 0.1
    },
    "dsz": {
     "desc": "垂直應力增量 Δσz",
     "unit": "tf/m2",
     "min": 0
    },
    "dsx": {
     "desc": "水平應力增量 Δσx",
     "unit": "tf/m2",
     "default": 0.0
    },
    "dsy": {
     "desc": "另一水平應力增量 Δσy",
     "unit": "tf/m2",
     "default": 0.0
    },
    "nu": {
     "desc": "柏松比 ν",
     "unit": "-",
     "min": 0,
     "max": 0.5
    }
   },
   "expr": "H/E*(dsz-nu*dsx-nu*dsy)",
   "notes": "單層形式；多層時逐層相加（本式可重複呼叫後加總，或將各層 H/E 換算為等效值）。總沉陷＝瞬時＋壓密＋次壓縮（＋極軟弱黏土之塑性流／潛移）。",
   "tests": [
    {
     "in": {
      "H": 2.0,
      "E": 3000,
      "dsz": 80,
      "nu": 0.3,
      "dsx": 80,
      "dsy": 40
     },
     "out": 0.029333333333333333,
     "tol": 1e-09
    }
   ],
   "status": "verified",
   "verified": {
    "method": "逐式對照原頁圖 p.66（式解4.4-2）＋手算",
    "by": "agent",
    "date": "2026-11-01"
   }
  },
  {
   "id": "found112_dH_elastic_uniform",
   "title": "均布載重地層之瞬時沉陷 ΔHi=(1−ν²)qBI/E（解說式4.4-3）",
   "src": "found112",
   "clause": "4.4.5",
   "page": 66,
   "keywords": "瞬時沉陷 彈性理論 均布載重 影響係數",
   "unit": "m",
   "output": "dHi",
   "latex": "\\Delta H_i=\\frac{1-\\nu^2}{E}qBI",
   "vars": {
    "E": {
     "desc": "變形模數",
     "unit": "tf/m2",
     "min": 0.1
    },
    "nu": {
     "desc": "柏松比 ν",
     "unit": "-",
     "min": 0,
     "max": 0.5
    },
    "q": {
     "desc": "均布載重（淨載重）",
     "unit": "tf/m2",
     "min": 0
    },
    "B": {
     "desc": "基礎寬度",
     "unit": "m",
     "min": 0.01
    },
    "I": {
     "desc": "影響係數（依基礎形狀與柔性／剛性，由彈性理論圖表查得）",
     "unit": "-",
     "default": 1.0,
     "min": 0.1,
     "max": 3
    }
   },
   "expr": "(1-nu**2)/E*q*B*I",
   "notes": "I 須依基礎形狀（圓形、矩形長寬比）與柔性／剛性基礎查彈性理論圖表（條文未列式，本庫不收 I 之圖表）。",
   "tests": [
    {
     "in": {
      "E": 3000,
      "nu": 0.3,
      "q": 150,
      "B": 2.0,
      "I": 1.0
     },
     "out": 0.09100000000000001,
     "tol": 1e-09
    }
   ],
   "status": "verified",
   "verified": {
    "method": "逐式對照原頁圖 p.66（式解4.4-3）＋手算",
    "by": "agent",
    "date": "2026-11-01"
   }
  },
  {
   "id": "found112_consol_settle_e",
   "title": "黏性土層單向度壓密沉陷量（式4.4-1，單層）",
   "src": "found112",
   "clause": "4.4.6",
   "page": 68,
   "keywords": "壓密沉陷 沉陷 孔隙比 單向度壓密 黏性土層 consolidation settlement",
   "unit": "m",
   "output": "dHc",
   "latex": "\\Delta H_c=\\sum_{i=1}^{n}\\frac{e_{oi}-e_{fi}}{1+e_{oi}}H_i\\;\\Rightarrow\\;\\frac{e_{o}-e_{f}}{1+e_{o}}H",
   "vars": {
    "e0": {
     "desc": "第 i 層初始有效垂直應力 σ'oi 時之孔隙比",
     "unit": "-",
     "min": 0.2,
     "max": 6,
     "default": 1.0
    },
    "ef": {
     "desc": "同層有效垂直應力增至 σ'fi 時之孔隙比",
     "unit": "-",
     "min": 0.1,
     "max": 6,
     "default": 0.9
    },
    "H": {
     "desc": "第 i 層土壤厚度",
     "unit": "m",
     "min": 0.01,
     "max": 200,
     "default": 3.0
    }
   },
   "expr": "(e0-ef)/(1+e0)*H",
   "notes": "原式(4.4-1)為 Σ 逐層求和；本條目只算**單層**，多層時逐層呼叫後相加（不可用平均孔隙比一次算）。e_oi／e_fi 取自各層中央點的初始與最終有效垂直應力（σ'oi、σ'fi，原式單位 tf/m²），須用修正後的工地壓密曲線讀取，不是試驗原始曲線。實務上常改用壓縮指數：正常壓密 S=(Cc·H/(1+e0))·log(σ'f/σ'o)、過壓密分兩段（見解說圖4.4-3），本庫尚未收錄該兩式，需用時另行核對原頁 p.68 解說。ef>e0 代表膨脹，結果為負值——此時不是沉陷，應回頭確認載重或孔隙比是否合理。",
   "tests": [
    {
     "in": {
      "e0": 1.0,
      "ef": 0.9,
      "H": 3.0
     },
     "out": 0.15,
     "tol": 1e-12
    },
    {
     "in": {
      "e0": 0.8,
      "ef": 0.75,
      "H": 5.0
     },
     "out": 0.1388888888888889,
     "tol": 1e-12
    }
   ],
   "status": "verified",
   "verified": {
    "method": "逐式對照座標化文字層 p.68 式(4.4-1)（分子 e_oi−e_fi、分母 1+e_oi、乘 H_i）＋手算",
    "by": "agent",
    "date": "2026-11-01"
   }
  }
 ],
