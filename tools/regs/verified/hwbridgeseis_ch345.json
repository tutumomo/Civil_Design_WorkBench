{
 "formulas": [
  {
   "id": "hwbridgeseis_Bs_B1",
   "title": "阻尼比調整係數 Bs 與 B1（公路橋梁耐震 3.2、表3-1 線性內插）",
   "src": "hwbridgeseis108",
   "clause": "3.2",
   "page": 39,
   "keywords": "公路橋梁耐震 阻尼比調整係數 Bs B1 有效阻尼比 內插 表3-1",
   "unit": "無因次",
   "output": "Bs",
   "latex": "B_S,\\ B_1:\\ (\\xi<2\\to0.80/0.80),\\ (5\\to1.00/1.00),\\ (10\\to1.33/1.25),\\ (\\xi\\ge20\\to1.60/1.50)\\ \\text{（其間線性內插）}",
   "vars": {
    "xi": {
     "desc": "橋梁有效阻尼比 ξ（%）",
     "unit": "%",
     "min": 0,
     "max": 100
    }
   },
   "defs": [
    [
     "Bs",
     "0.80 if xi < 2 else ((0.80 + (1.00 - 0.80) * (xi - 2.0) / 3.0) if xi < 5 else ((1.00 + (1.33 - 1.00) * (xi - 5.0) / 5.0) if xi < 10 else ((1.33 + (1.60 - 1.33) * (xi - 10.0) / 10.0) if xi < 20 else 1.60)))"
    ]
   ],
   "expr": "0.80 if xi < 2 else ((0.80 + (1.00 - 0.80) * (xi - 2.0) / 3.0) if xi < 5 else ((1.00 + (1.25 - 1.00) * (xi - 5.0) / 5.0) if xi < 10 else ((1.25 + (1.50 - 1.25) * (xi - 10.0) / 10.0) if xi < 20 else 1.50)))",
   "conditions": [
    {
     "expr": "xi >= 0",
     "msg": "有效阻尼比須非負"
    }
   ],
   "tests": [
    {
     "in": {
      "xi": 7.5
     },
     "out": 1.125
    },
    {
     "in": {
      "xi": 3.0
     },
     "out": 0.8666666666666667
    },
    {
     "in": {
      "xi": 25.0
     },
     "out": 1.5
    }
   ],
   "notes": "本式輸出 B1；defs 內同時算得 Bs（ξ=7.5% 時 Bs=1.165、B1=1.125）。表3-1 四點：<2→0.80、5→1.00、10→1.33(Bs)/1.25(B1)、>=20→1.60/1.50，其間線性內插。公路橋梁耐震 3.2 規定以 Bs、B1 將 S_II,S 與 S_II,1 調整為 S_II,S/Bs 與 S_II,1/B1。",
   "status": "verified",
   "verified": {
    "method": "逐格對照 hwbridgeseis108 PDF p.156 表3-1（hb_p175.png）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "hwbridgeseis_T0_damped",
   "title": "阻尼調整後短週期與中長週期分界 T0（公路橋梁耐震 3.2 (3-1)(3-2)式）",
   "src": "hwbridgeseis108",
   "clause": "3.2",
   "page": 40,
   "keywords": "公路橋梁耐震 阻尼調整 T0 分界 Bs B1 台北盆地 (3-1) (3-2)",
   "unit": "秒",
   "output": "T0",
   "latex": "T_0=\\frac{S_{II,1}B_S}{S_{II,S}B_1}\\;(一般工址、近斷層);\\qquad T_0=\\frac{T_0^{II}B_S}{B_1}\\;(臺北盆地)",
   "vars": {
    "S_IIS": {
     "desc": "工址短週期等級II 譜加速度係數 S_II,S（一般工址用）",
     "unit": "無因次",
     "min": 0
    },
    "S_II1": {
     "desc": "工址一秒週期等級II 譜加速度係數 S_II,1（一般工址用）",
     "unit": "無因次",
     "min": 0
    },
    "T0_II": {
     "desc": "未調整之等級II 分界 T0^II（臺北盆地用，見 (2-16b)）",
     "unit": "秒",
     "min": 0.01,
     "default": 1.3
    },
    "Bs": {
     "desc": "短週期阻尼比調整係數 Bs",
     "unit": "無因次",
     "min": 0.1,
     "default": 1.0
    },
    "B1": {
     "desc": "一秒週期阻尼比調整係數 B1",
     "unit": "無因次",
     "min": 0.1,
     "default": 1.0
    },
    "is_taipei": {
     "desc": "0=一般工址或活動斷層近域；1=臺北盆地",
     "unit": "型態",
     "min": 0,
     "max": 1
    }
   },
   "expr": "T0_II * Bs / B1 if is_taipei > 0.5 else (S_II1 * Bs / (S_IIS * B1))",
   "conditions": [
    {
     "expr": "Bs > 0 and B1 > 0",
     "msg": "Bs、B1 須為正"
    },
    {
     "expr": "is_taipei > 0.5 or S_IIS > 0",
     "msg": "一般工址之 S_II,S 須大於 0"
    }
   ],
   "tests": [
    {
     "in": {
      "S_IIS": 0.72,
      "S_II1": 0.35,
      "T0_II": 1.3,
      "Bs": 1.165,
      "B1": 1.125,
      "is_taipei": 0
     },
     "out": 0.5033950617283951
    },
    {
     "in": {
      "S_IIS": 0.72,
      "S_II1": 0.35,
      "T0_II": 1.3,
      "Bs": 1.165,
      "B1": 1.125,
      "is_taipei": 1
     },
     "out": 1.3462222222222224
    }
   ],
   "notes": "公路橋梁耐震 3.2 (3-1) 式（一般工址及活動斷層近域）、(3-2) 式（臺北盆地）。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 hwbridgeseis108 PDF p.40 §3.2 (3-1)(3-2)式（hb_p39.png）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "hwbridgeseis_SaII_damped",
   "title": "阻尼調整後等級II 地震水平譜加速度係數 Sa,II（公路橋梁耐震 3.2 表3-2／表3-3）",
   "src": "hwbridgeseis108",
   "clause": "3.2",
   "page": 32,
   "keywords": "公路橋梁耐震 阻尼調整 譜加速度係數 表3-2 表3-3 台北盆地 分段 Bs B1",
   "unit": "無因次",
   "output": "Sa_II",
   "latex": "S_{a,II}=S_{II,S}\\left[0.4+\\left(\\frac{1}{B_S}-0.4\\right)\\frac{T}{0.2T_0}\\right]\\ (T\\le0.2T_0);\\quad \\frac{S_{II,S}}{B_S}\\ (0.2T_0<T\\le T_0);\\quad \\frac{S_{II,1}}{B_1T}\\ (T>T_0)",
   "vars": {
    "T": {
     "desc": "橋梁振動週期 T",
     "unit": "秒",
     "min": 0.001
    },
    "T0": {
     "desc": "阻尼調整後之短週期與中長週期分界 T0（依 (3-1) 或 (3-2)）",
     "unit": "秒",
     "min": 0.001
    },
    "S_IIS": {
     "desc": "工址短週期等級II 譜加速度係數 S_II,S",
     "unit": "無因次",
     "min": 0
    },
    "S_II1": {
     "desc": "工址一秒週期等級II 譜加速度係數 S_II,1",
     "unit": "無因次",
     "min": 0
    },
    "Bs": {
     "desc": "短週期阻尼比調整係數 Bs",
     "unit": "無因次",
     "min": 0.1,
     "default": 1.0
    },
    "B1": {
     "desc": "一秒週期阻尼比調整係數 B1",
     "unit": "無因次",
     "min": 0.1,
     "default": 1.0
    },
    "T0_II": {
     "desc": "未調整之等級II 分界 T0^II（臺北盆地中長週期段用）",
     "unit": "秒",
     "min": 0.01,
     "default": 1.3
    },
    "is_taipei": {
     "desc": "0=一般工址或活動斷層近域；1=臺北盆地",
     "unit": "型態",
     "min": 0,
     "max": 1
    }
   },
   "expr": "S_IIS * (0.4 + (1.0 / Bs - 0.4) * T / (0.2 * T0)) if T <= 0.2 * T0 else ((S_IIS / Bs) if T <= T0 else ((T0_II * S_IIS / (B1 * T)) if is_taipei > 0.5 else (S_II1 / (B1 * T))))",
   "conditions": [
    {
     "expr": "T > 0 and T0 > 0 and Bs > 0 and B1 > 0",
     "msg": "T、T0、Bs、B1 須為正"
    }
   ],
   "tests": [
    {
     "in": {
      "T": 0.3,
      "T0": 0.5034,
      "S_IIS": 0.72,
      "S_II1": 0.35,
      "Bs": 1.165,
      "B1": 1.125,
      "T0_II": 1.3,
      "is_taipei": 0
     },
     "out": 0.6180257510729613
    },
    {
     "in": {
      "T": 0.05,
      "T0": 0.5034,
      "S_IIS": 0.72,
      "S_II1": 0.35,
      "Bs": 1.165,
      "B1": 1.125,
      "T0_II": 1.3,
      "is_taipei": 0
     },
     "out": 0.45189836664330624
    },
    {
     "in": {
      "T": 2.0,
      "T0": 1.3468,
      "S_IIS": 0.72,
      "S_II1": 0.35,
      "Bs": 1.165,
      "B1": 1.125,
      "T0_II": 1.3,
      "is_taipei": 1
     },
     "out": 0.416
    }
   ],
   "notes": "表3-2（一般工址及活動斷層近域）與表3-3（臺北盆地）三段式相同，僅中長週期段之分子不同：一般工址用 S_II,1，臺北盆地用 T0^II·S_II,S。",
   "status": "verified",
   "verified": {
    "method": "逐式對照 hwbridgeseis108 PDF p.156 表3-2、表3-3（hb_p175.png）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "hwbridgeseis_response_spectrum_input",
   "title": "等級 II 反應譜分析之輸入譜加速度係數（公路橋梁耐震 3.3 (3-3)式）",
   "src": "hwbridgeseis108",
   "clause": "3.3",
   "page": 40,
   "keywords": "公路橋梁耐震 反應譜分析 輸入譜加速度係數 多振態 疊加 (3-3)",
   "unit": "無因次",
   "output": "Sa_input",
   "latex": "S_{a,II}(T)\\cdot\\frac{I}{1.2\\alpha_y S_{a,II}(T_1)}\\left(\\frac{S_{a,II}(T_1)}{F_{u,D}(T_1)}\\right)_m",
   "vars": {
    "Sa_T": {
     "desc": "週期 T 之等級II 譜加速度係數 Sa,II(T)",
     "unit": "無因次",
     "min": 0
    },
    "Sa_T1": {
     "desc": "基本振動週期 T1 且阻尼比 5% 之等級II 譜加速度係數 Sa,II(T1)",
     "unit": "無因次",
     "min": 0.0001
    },
    "FuD_T1": {
     "desc": "週期 T1 之等級II 地震力折減係數 Fu,D(T1)（(2-12)式）",
     "unit": "無因次",
     "min": 0.1
    },
    "I": {
     "desc": "用途係數 I",
     "unit": "無因次",
     "min": 0.1
    },
    "alpha_y": {
     "desc": "起始降伏地震力放大倍數 αy",
     "unit": "無因次",
     "min": 0.1
    }
   },
   "defs": [
    [
     "r",
     "Sa_T1 / FuD_T1"
    ],
    [
     "m_r",
     "r if r <= 0.3 else ((0.52 * r + 0.144) if r <= 0.8 else 0.70)"
    ]
   ],
   "expr": "Sa_T * I / (1.2 * alpha_y * Sa_T1) * m_r",
   "conditions": [
    {
     "expr": "Sa_T1 > 0 and FuD_T1 > 0 and I > 0 and alpha_y > 0",
     "msg": "Sa,II(T1)、Fu,D(T1)、I、αy 須為正"
    }
   ],
   "tests": [
    {
     "in": {
      "Sa_T": 0.5,
      "Sa_T1": 0.72,
      "FuD_T1": 1.5,
      "I": 1.2,
      "alpha_y": 1.65
     },
     "out": 0.16565656565656567
    },
    {
     "in": {
      "Sa_T": 0.3,
      "Sa_T1": 0.9,
      "FuD_T1": 2.0,
      "I": 1.0,
      "alpha_y": 1.2
     },
     "out": 0.0875
    }
   ],
   "notes": "公路橋梁耐震 3.3 (3-3)式：輸入譜加速度係數＝Sa,II(T) 乘上 I/(1.2αy·Sa,II(T1)) 再乘 (Sa,II(T1)/Fu,D(T1))_m；最後一項之下標 m 表示依 (2-11) 式三段式調整。隔震橋梁（7.5.1）以有效週期 Te 取代 T1。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 hwbridgeseis108 PDF p.40 §3.3 (3-3)式（hb_p39.png 目視）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "hwbridgeseis_vertical_spectrum",
   "title": "垂直譜加速度係數（公路橋梁耐震 3.5 (3-4)式）",
   "src": "hwbridgeseis108",
   "clause": "3.5",
   "page": 42,
   "keywords": "公路橋梁耐震 垂直地震效應 垂直譜加速度係數 alpha_v 2/3 (3-4)",
   "unit": "無因次",
   "output": "Sa_vertical",
   "latex": "\\frac{\\alpha_v I}{\\alpha_y}S_{a,II}(T),\\quad \\alpha_v=\\frac{2}{3}",
   "vars": {
    "I": {
     "desc": "用途係數 I",
     "unit": "無因次",
     "min": 0.1
    },
    "alpha_y": {
     "desc": "起始降伏地震力放大倍數 αy",
     "unit": "無因次",
     "min": 0.1
    },
    "Sa_II": {
     "desc": "設計水平譜加速度係數 Sa,II(T)",
     "unit": "無因次",
     "min": 0
    }
   },
   "defs": [
    [
     "alpha_v",
     "2.0 / 3.0"
    ]
   ],
   "expr": "alpha_v * I / alpha_y * Sa_II",
   "conditions": [
    {
     "expr": "I > 0 and alpha_y > 0 and Sa_II >= 0",
     "msg": "I、αy 須為正，Sa,II 須非負"
    }
   ],
   "tests": [
    {
     "in": {
      "I": 1.2,
      "alpha_y": 1.65,
      "Sa_II": 0.5
     },
     "out": 0.24242424242424243
    }
   ],
   "notes": "公路橋梁耐震 3.5 (3-4)式：位於活動斷層近域之橋梁須考慮垂直地震力，αv = 2/3 為垂直與水平譜加速度係數之比值；以阻尼器增加阻尼比者，Sa,II(T) 依 3.2 節調整。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 hwbridgeseis108 PDF p.42 §3.5 (3-4)式（hb_p41.png）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "hwbridgeseis_stability_index",
   "title": "P-Δ 效應之穩定指數 QS（公路橋梁耐震 4.6 (4-2)式）",
   "src": "hwbridgeseis108",
   "clause": "4.6",
   "page": 47,
   "keywords": "公路橋梁耐震 P-Delta 效應 穩定指數 QS 軸力 彈性變位 (4-2)",
   "unit": "無因次",
   "output": "QS",
   "latex": "Q_S=\\frac{P\\,\\Delta_0}{V_u\\,l_c}",
   "vars": {
    "P": {
     "desc": "載重組合下柱之軸力 P",
     "unit": "kgf",
     "min": 0
    },
    "delta_0": {
     "desc": "柱承受 Vu 時柱頂對柱底之相對彈性變位 Δ0",
     "unit": "cm",
     "min": 0
    },
    "Vu": {
     "desc": "載重組合下柱之剪力 Vu",
     "unit": "kgf",
     "min": 0.001
    },
    "lc": {
     "desc": "柱高 lc（可算至節點中心）",
     "unit": "cm",
     "min": 0.001
    }
   },
   "expr": "P * delta_0 / (Vu * lc)",
   "conditions": [
    {
     "expr": "Vu > 0 and lc > 0",
     "msg": "Vu 與 lc 須為正"
    }
   ],
   "warn_if": [
    {
     "expr": "result > 0.05",
     "msg": "QS > 0.05，依公路橋梁耐震 4.6 須考慮 P-Δ 效應（二階分析）"
    }
   ],
   "tests": [
    {
     "in": {
      "P": 500000,
      "delta_0": 3.0,
      "Vu": 80000,
      "lc": 800.0
     },
     "out": 0.0234375
    }
   ],
   "notes": "公路橋梁耐震 4.6 (4-2)式：QS 超過 0.05 時須考慮 P-Δ 效應。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 hwbridgeseis108 PDF p.47 §4.6 (4-2)式",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "hwbridgeseis_column_shear_Vn",
   "title": "橋柱塑鉸區剪力計算強度 Vn（公路橋梁耐震 5.3.3 (5-1)式）",
   "src": "hwbridgeseis108",
   "clause": "5.3.3",
   "page": 50,
   "keywords": "公路橋梁耐震 橋柱 剪力強度 Vn Vs Vc 塑鉸區 0.85 (5-1)",
   "unit": "kgf",
   "output": "Vn",
