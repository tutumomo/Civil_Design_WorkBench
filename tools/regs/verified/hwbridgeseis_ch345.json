  },
  {
   "id": "hwbridgeseis_column_Vs_rect",
   "title": "矩形橋柱剪力鋼筋強度 Vs（公路橋梁耐震 5.3.3 (5-2a)式）",
   "src": "hwbridgeseis108",
   "clause": "5.3.3",
   "page": 50,
   "keywords": "公路橋梁耐震 矩形橋柱 剪力鋼筋 Ash fyh 間距 (5-2a)",
   "unit": "kgf",
   "output": "Vs",
   "latex": "V_s=\\frac{A_{sh}f_{yh}d}{a}",
   "vars": {
    "Ash": {
     "desc": "沿某方向箍筋總面積（含輔助箍筋）Ash",
     "unit": "cm2",
     "min": 0
    },
    "fyh": {
     "desc": "剪力鋼筋規定降伏強度 fyh",
     "unit": "kgf/cm2",
     "min": 1
    },
    "d": {
     "desc": "沿剪力方向柱之有效深度 d",
     "unit": "cm",
     "min": 0.1
    },
    "a": {
     "desc": "橫向箍筋之垂直間距 a",
     "unit": "cm",
     "min": 0.1
    }
   },
   "expr": "Ash * fyh * d / a",
   "conditions": [
    {
     "expr": "a > 0 and d > 0 and fyh > 0",
     "msg": "a、d、fyh 須為正"
