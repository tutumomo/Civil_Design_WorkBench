    {
     "key": "s-phi10",
     "values": {
      "考慮影響項目": "形狀影響因素(s)",
      "適用條件": "φ >= 10°",
      "凝聚力(c)": "Fcs = 1 + 0.2(B/L)·tan²(45°+φ/2)",
      "超載(q)": "Fqs = 1 + 0.1(B/L)·tan²(45°+φ/2)",
      "土重(gamma)": "Fgs = 1 + 0.1(B/L)·tan²(45°+φ/2)"
     }
    },
    {
     "key": "d-phi0",
     "values": {
      "考慮影響項目": "埋置深度影響因素(d)",
      "適用條件": "φ=0 法",
      "凝聚力(c)": "Fcd = 1 + 0.2(Df/B) ≤ 1.5",
      "超載(q)": "Fqd = 1.0",
      "土重(gamma)": "Fgd = 1.0"
     }
    },
    {
     "key": "d-phi10",
     "values": {
      "考慮影響項目": "埋置深度影響因素(d)",
      "適用條件": "φ >= 10°",
      "凝聚力(c)": "Fcd = 1 + 0.2(Df/B)·tan(45°+φ/2)",
      "超載(q)": "Fqd = 1 + 0.1(Df/B)·tan(45°+φ/2)",
      "土重(gamma)": "Fgd = 1 + 0.1(Df/B)·tan(45°+φ/2)"
     }
    },
    {
     "key": "i-beta-ge-phi",
     "values": {
      "考慮影響項目": "載重傾斜影響因素(i)",
      "適用條件": "β >= φ",
      "凝聚力(c)": "Fci = (1 - β/90°)²",
      "超載(q)": "Fqi = (1 - β/90°)²",
      "土重(gamma)": "Fgi = 0"
     }
    },
    {
     "key": "i-beta-lt-phi",
     "values": {
      "考慮影響項目": "載重傾斜影響因素(i)",
      "適用條件": "β < φ",
      "凝聚力(c)": "Fci = (1 - β/90°)²",
      "超載(q)": "Fqi = (1 - β/90°)²",
      "土重(gamma)": "Fgi = (1 - β/φ)²"
     }
    }
