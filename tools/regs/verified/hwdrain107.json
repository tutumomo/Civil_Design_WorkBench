 "formulas": [
  {"id": "hwdrain107_manning_V", "title": "曼寧公式 V=(1/n)R^(2/3)Sf^(1/2)（式4-2）", "src": "hwdrain107", "clause": "4.2.2", "page": 33,
   "keywords": "曼寧 流速 渠流 manning 公路排水", "unit": "m/s", "output": "V",
   "latex": "V=\\frac{1}{n}R^{2/3}S_f^{1/2},\\quad R=\\frac{A}{P}",
   "vars": {"n": {"desc": "曼寧 n 值（附錄 J，表 hwdrain107_manning_n_J）", "unit": "-", "min": 0.005, "max": 0.2},
            "R": {"desc": "水力半徑 A/P", "unit": "m", "min": 0.0001},
            "Sf": {"desc": "能量坡降（均勻流時等於渠底坡降 S0）", "unit": "m/m", "min": 0.000001}},
   "expr": "(1/n)*R**(2/3)*Sf**0.5",
   "notes": "與水保規範第84條（swc84_manning_v）同式。容許流速見表 hwdrain107_max_velocity_T41。",
   "tests": [{"in": {"n": 0.015, "R": 0.5, "Sf": 0.01}, "out": 4.199736832982911, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.33＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "hwdrain107_energy_headloss", "title": "渠流能量方程式能量損失 hL（式4-3 移項）", "src": "hwdrain107", "clause": "4.2.3", "page": 34,
   "keywords": "能量方程式 能量損失 水頭損失 hL", "unit": "m", "output": "hL",
   "latex": "d_1\\cos\\theta+z_1+\\frac{\\alpha_1V_1^2}{2g}=d_2\\cos\\theta+z_2+\\frac{\\alpha_2V_2^2}{2g}+h_L",
   "vars": {"d1": {"desc": "上游斷面水深", "unit": "m", "min": 0}, "d2": {"desc": "下游斷面水深", "unit": "m", "min": 0},
            "z1": {"desc": "上游斷面底床高程", "unit": "m"}, "z2": {"desc": "下游斷面底床高程", "unit": "m"},
            "V1": {"desc": "上游斷面平均流速", "unit": "m/s", "min": 0}, "V2": {"desc": "下游斷面平均流速", "unit": "m/s", "min": 0},
            "alpha1": {"desc": "上游能量修正係數（一般可假設為 1）", "unit": "-", "default": 1.0, "min": 1.0, "max": 2.0},
            "alpha2": {"desc": "下游能量修正係數", "unit": "-", "default": 1.0, "min": 1.0, "max": 2.0},
            "theta": {"desc": "渠底坡度角", "unit": "deg", "default": 0.0, "min": 0, "max": 45},
            "g": {"desc": "重力加速度", "unit": "m/s2", "default": 9.8}},
   "expr": "d1*cos(radians(theta))+z1+alpha1*V1**2/(2*g)-(d2*cos(radians(theta))+z2+alpha2*V2**2/(2*g))",
   "notes": "式(4-3) 為已知兩斷面求損失；反推水深須用標準步推法（channel_profile）。",
   "tests": [{"in": {"d1": 1.2, "z1": 10.0, "V1": 2.0, "d2": 1.0, "z2": 9.5, "V2": 3.0}, "out": 0.44489795918367214, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.34＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "hwdrain107_freeboard_min", "title": "渠道最小出水高度（4.4.3）", "src": "hwdrain107", "clause": "4.4.3", "page": 36,
   "keywords": "出水高度 出水高 freeboard 渠道 最小", "unit": "m", "output": "freeboard_min",
   "latex": "f_{min}=\\max(0.25\\,d,\\;0.20)\\;(\\text{L型、拋物線型溝不受 }0.20\\text{ m 限制})",
   "vars": {"d": {"desc": "設計水深", "unit": "m", "min": 0},
            "exempt_L_parabola": {"desc": "L 型或拋物線型排水溝＝1（不受 20 cm 下限）；其他＝0", "unit": "-", "default": 0, "min": 0, "max": 1}},
   "expr": "0.25*d if exempt_L_parabola>0.5 else max(0.25*d,0.20)",
   "notes": "條文：最小出水高度依設計水深 25% 計算，最小值 20 cm；並須以高一階重現期距（表 hwdrain107_return_period_T42）流量不溢頂校核；陡槽溝或彎道另酌加（本式不含）；水利主管機關另有規定者從其規定。",
   "tests": [{"in": {"d": 0.5}, "out": 0.2}, {"in": {"d": 1.2}, "out": 0.3}, {"in": {"d": 0.5, "exempt_L_parabola": 1}, "out": 0.125}],
   "status": "verified", "verified": {"method": "逐字對照原頁圖 p.36＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "hwdrain107_transition_length_min", "title": "漸變段最小長度（4.6 第1款）", "src": "hwdrain107", "clause": "4.6", "page": 37,
   "keywords": "漸變段 長度 水面寬度差", "unit": "m", "output": "L_min",
   "latex": "L\\ge\\max(1.5,\\;2\\,|T_1-T_2|)",
   "vars": {"T1": {"desc": "上游水面寬度", "unit": "m", "min": 0}, "T2": {"desc": "下游水面寬度", "unit": "m", "min": 0}},
   "defs": [["by_width", "2*abs(T1-T2)"]],
   "expr": "max(1.5,by_width)",
   "notes": "原文「其長度不應小於 1.5 m 或上下游水面寬度差之 2 倍」，連接詞為「或」；本庫採兩者取大（保守）；steps.by_width 為單獨以寬度差計之值。目的事業機關另有規定者從其規定。流量大於 3.0 m3/s 或進口流速大於 2.5 m/s 且水頭損失影響大時，宜以能量方程式另行分析。",
   "tests": [{"in": {"T1": 2.0, "T2": 1.0}, "out": 2.0}, {"in": {"T1": 1.0, "T2": 0.8}, "out": 1.5}],
   "status": "verified", "verified": {"method": "逐字對照原頁圖 p.37＋手算（「或」取大為保守解讀）", "by": "agent", "date": "2026-11-01"}},

  {"id": "hwdrain107_culvert_outlet_Hw", "title": "涵洞出口控制上游水深 Hw=Hf+h0−L·S0（附錄O 式O-1、O-2）", "src": "hwdrain107", "clause": "附錄O", "page": 130,
   "keywords": "涵洞 出口控制 上游水深 Hw 水頭損失 附錄O 排水涵洞", "unit": "m", "output": "Hw",
   "latex": "H_w=H_f+h_0-LS_0,\\quad H_f=\\left(1+K_e+\\frac{19.6\\,n^2L}{R^{1.33}}\\right)\\frac{V^2}{2g}",
   "vars": {"Ke": {"desc": "進口水頭損失係數（表 hwdrain107_Ke_TO1）", "unit": "-", "min": 0, "max": 1.5},
            "n": {"desc": "涵洞曼寧 n 值", "unit": "-", "min": 0.005, "max": 0.1},
            "L": {"desc": "涵洞長度", "unit": "m", "min": 0},
            "R": {"desc": "涵洞水力半徑", "unit": "m", "min": 0.001},
            "V": {"desc": "涵洞水流平均流速", "unit": "m/s", "min": 0},
            "h0": {"desc": "下游水深（下游水位與涵洞出口渠底之高差）", "unit": "m", "min": 0},
            "S0": {"desc": "涵洞底坡（以 m/m 代入 L·S0）", "unit": "m/m", "min": 0, "max": 0.5},
            "g": {"desc": "重力加速度", "unit": "m/s2", "default": 9.8}},
   "defs": [["Hf", "(1+Ke+19.6*n**2*L/R**1.33)*V**2/(2*g)"]],
   "expr": "Hf+h0-L*S0",
   "notes": "原文 S0 標示為「(%)」但式中 L·S0 須為高差（m），本庫以 m/m 代入（dimensional 一致）；若原文確以 % 代入，結果差 100 倍，使用前請對照官方公告確認。設計上游水位須取進口控制與出口控制之大者（6.2.1）；潛沒流時 Hw/D 宜控制在 1.5 以上；進口控制為圖解（附錄 N 諾模圖，無公式，未收錄）。",
   "tests": [{"in": {"Ke": 0.5, "n": 0.013, "L": 20, "R": 0.3, "V": 2.5, "h0": 0.8, "S0": 0.01}, "out": 1.1830835534763813, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.130-131＋手算", "by": "agent", "date": "2026-11-01"}}
