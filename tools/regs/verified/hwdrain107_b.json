{
 "formulas": [
  {
   "id": "hwdrain107_scour_shen",
   "title": "橋墩局部沖刷深度（沈學汶 1966，式S-1）",
   "src": "hwdrain107",
   "clause": "附錄S",
   "page": 148,
   "keywords": "橋墩 局部沖刷 沖刷深度 沈學汶 Shen 福祿數 scour",
   "unit": "m",
   "output": "hs",
   "latex": "h_s/y_1=2.5F_r^{2/5}(D_p/y_1)^{3/5},\\quad F_r=V/\\sqrt{g y_1}",
   "vars": {
    "y1": {
     "desc": "橋墩上游側水深",
     "unit": "m",
     "min": 0.1
    },
    "Dp": {
     "desc": "橋墩直徑",
     "unit": "m",
     "min": 0.05
    },
    "V": {
     "desc": "橋墩上游側流速",
     "unit": "m/s",
     "min": 0
    },
    "g": {
     "desc": "重力加速度（原式隱含於 Fr）",
     "unit": "-",
     "default": 1,
     "min": 1,
     "max": 1
    }
   },
   "defs": [
    [
     "Fr",
     "V/sqrt(9.8*y1)"
    ]
   ],
   "expr": "y1*2.5*Fr**(2/5)*(Dp/y1)**(3/5)",
   "notes": "適用砂質含沉澱水流情況（附錄S.1.1，摘自 Shen, Scheider & Karaki 1966）。沖刷深度為局部沖刷量，未含束縮與一般沖刷。",
   "tests": [
    {
     "in": {
      "y1": 3.0,
      "Dp": 1.2,
      "V": 2.0
     },
     "out": 2.904288735290087,
     "tol": 1e-09
    }
   ],
   "status": "verified",
   "verified": {
    "method": "逐式對照原頁圖 p.148（式S-1）＋手算",
    "by": "agent",
    "date": "2026-11-01"
   }
  },
  {
