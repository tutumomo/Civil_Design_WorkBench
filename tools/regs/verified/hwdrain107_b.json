  {
   "id": "hwdrain107_scour_inglis",
   "title": "橋墩局部沖刷深度（Inglis 1949，式S-3）",
   "src": "hwdrain107",
   "clause": "附錄S",
   "page": 149,
   "keywords": "橋墩 局部沖刷 Inglis scour 福祿數",
   "unit": "m",
   "output": "hs",
   "latex": "h_s/D_p=4.2(y_1/B)^{0.73}F_r^{0.52}",
   "vars": {
    "y1": {
     "desc": "橋墩上游側水深",
     "unit": "m",
     "min": 0.1
    },
    "Dp": {
     "desc": "橋墩直徑",
     "unit": "m",
     "min": 0.05
    },
    "B": {
     "desc": "橋墩迎水面寬度（基腳露出河床者以基腳迎水寬計）",
     "unit": "m",
     "min": 0.05
    },
    "V": {
     "desc": "流速",
     "unit": "m/s",
     "min": 0.01
    }
   },
   "defs": [
    [
     "Fr",
     "V/sqrt(9.8*y1)"
    ]
   ],
   "expr": "Dp*4.2*(y1/B)**0.73*Fr**0.52",
   "notes": "附錄S.1.3（Inglis 1949，摘自 Research Publication No.13, Poona）。B 定義見條文。",
   "tests": [
