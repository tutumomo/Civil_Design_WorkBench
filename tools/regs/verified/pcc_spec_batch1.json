{
 "formulas": [
  {
   "id": "pcc_pt_anchor_efficiency",
   "src": "pcc_spec",
   "clause": "03231/3.4.5",
   "page": null,
   "title": "預力端錨錨碇效率 ηA＝FTu／Fpm，須≧0.95（靜載重試驗）",
   "keywords": "施工綱要規範 預力 端錨 續接器 錨碇效率 靜載重試驗 極限拉力 母材預力鋼材",
   "unit": "-",
   "output": "etaA",
   "latex": "\\eta_A = \\dfrac{F_{Tu}}{F_{pm}} = \\dfrac{F_{Tu}}{A_{pm}\\,f_{pm}} \\geq 0.95",
   "vars": {
    "FTu": {
     "desc": "試件量測之極限拉力",
     "unit": "kN",
     "min": 1.0,
     "max": 100000.0
    },
    "Apm": {
     "desc": "試件預力鋼材之實際平均截面積",
     "unit": "mm2",
     "min": 10.0,
     "max": 100000.0
    },
    "fpm": {
     "desc": "預力鋼材母材試驗之實際平均極限強度",
     "unit": "N/mm2",
     "min": 200.0,
     "max": 2500.0
    }
   },
   "expr": "FTu / (Apm * fpm / 1000.0)",
   "warn_if": [
    {
     "expr": "result < 0.95",
     "msg": "錨碇效率未達 0.95，依第03231章 3.4.5 為不合格"
    }
   ],
   "tests": [
    {
     "in": {
      "FTu": 2700.0,
      "Apm": 1500.0,
      "fpm": 1860.0
     },
     "out": 0.967741935,
     "tol": 1e-06
    },
    {
     "in": {
      "FTu": 2400.0,
      "Apm": 1500.0,
      "fpm": 1860.0
     },
     "out": 0.860215054,
     "tol": 1e-06
    }
   ],
   "notes": "第03231章（預力鋼腱端錨與續接器）3.4.5：Fpm＝Apm×fpm（原文乘號於文字層誤為「⊆」）。同一靜載重試驗另有 3.4.6：量測極限拉力時之總應變 εu ≧ 2%。動力載重試驗合格標準 4.4.2：經 200 萬次循環載重後，預力鋼材因端錨或續接器影響之疲勞破壞面積不得大於初始總截面積之 5%。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 data/法規/公共工程施工綱要規範_全文.txt 第03231章 3.4.5 及式中說明",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "pcc_pt_dynamic_test_strands",
   "src": "pcc_spec",
   "clause": "03231/4.1",
   "page": null,
   "title": "動力載重試驗之預力鋼材股數 n′ 下限（n≦12 取 n/2；n>12 取 6+(n-12)/3）",
   "keywords": "施工綱要規範 預力 端錨 動力載重試驗 疲勞 股數 n' 端錨外圈",
   "unit": "股",
   "output": "n_prime",
   "latex": "n' \\geq \\begin{cases} n/2 & n \\leq 12 \\\\ 6 + (n-12)/3 & n > 12 \\end{cases}",
   "vars": {
    "n": {
     "desc": "產品股數",
     "unit": "股",
     "min": 1.0,
     "max": 200.0
    }
   },
   "expr": "n / 2.0 if n <= 12 else 6.0 + (n - 12.0) / 3.0",
   "tests": [
    {
     "in": {
      "n": 12.0
     },
     "out": 6.0,
     "tol": 1e-06
    },
    {
     "in": {
      "n": 8.0
     },
     "out": 4.0,
     "tol": 1e-06
    },
    {
     "in": {
      "n": 19.0
     },
     "out": 8.333333333,
     "tol": 1e-06
    }
   ],
   "notes": "第03231章 4.1：動力載重試驗試件規定同靜載重試驗，惟試驗時預力鋼材股數 n′ 依本式規定，且預力鋼材應由端錨外圈開始佈設。加載脈衝頻率每分鐘不得超過 500 次，施力上限 0.65 fPK、應力幅度 816 kgf/cm²。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 data/法規/公共工程施工綱要規範_全文.txt 第03231章 4.1",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "pcc_excavation_pay_section_area",
   "src": "pcc_spec",
   "clause": "02316/4.1.3",
   "page": null,
   "title": "構造物開挖計價断面積＝H(B+2c)+s·H²（一般構造物 c=0.5m、H:V=0.5:1；小型構造物 c=0.3m、H:V=0.3:1）",
   "keywords": "施工綱要規範 開挖 回填 計價線 構造物開挖 土方 數量計算 H:V 邊坡 計量",
   "unit": "m2",
   "output": "A",
   "latex": "A = H\\left(B + 2c\\right) + s\\,H^{2}",
   "vars": {
    "H": {
     "desc": "開挖深度",
     "unit": "m",
     "min": 0.1,
     "max": 30.0
    },
    "B": {
     "desc": "構造物外緣寬度",
     "unit": "m",
     "min": 0.1,
     "max": 100.0
    },
    "c": {
     "desc": "構造物外緣外加寬度（一般 0.5；小型構造物深≦1 m 者 0.3）",
     "unit": "m",
     "min": 0.0,
     "max": 2.0,
     "default": 0.5
    },
    "s": {
     "desc": "邊坡 H:V 之 H 值（一般 0.5；小型構造物 0.3）",
     "unit": "-",
     "min": 0.0,
     "max": 2.0,
     "default": 0.5
    }
   },
   "expr": "H * (B + 2.0 * c) + s * H ** 2.0",
   "warn_if": [
    {
     "expr": "abs(c - (0.3 if H <= 1.0 else 0.5)) > 1e-9",
     "msg": "外加寬度與條文慣例不一致：一般構造物 0.5 m、深 1 m 以內之小型構造物 0.3 m"
    }
   ],
   "tests": [
    {
     "in": {
      "H": 3.0,
      "B": 2.0,
      "c": 0.5,
      "s": 0.5
     },
     "out": 13.5,
     "tol": 1e-06
    },
    {
     "in": {
      "H": 1.0,
      "B": 1.0,
      "c": 0.3,
      "s": 0.3
     },
     "out": 1.9,
     "tol": 1e-06
    },
    {
     "in": {
      "H": 2.0,
      "B": 3.0,
      "c": 0.5,
      "s": 0.5
     },
     "out": 10.0,
     "tol": 1e-06
    }
   ],
   "notes": "第02316章「構造物開挖」4.1.3 計量方式：設計圖說未標示開挖回填計價線時，一般構造物自構造物外緣外 50 cm 處按 H:V＝0.5:1 之邊坡開挖回填線計量；小型構造物（深 1 公尺以內者，如 U 型溝、集水井）自外緣外 30 cm 處按 H:V＝0.3:1 計量；堅硬岩盤內開挖依工程司指示或按構造物邊緣線外 30 cm 垂直開挖。第02317章 4.1.2 為同一規定（兩章條文相同）。開挖計價體積之計算：底邊以基礎底部平面為準、頂面以其他開挖項目完成後之地面為準，超出計價線範圍外之挖方已含於「構造物開挖」單價內不予計量。本式僅計算「單側長度 1 m 之横断面積」，體積須再乘計價長度。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 data/法規/公共工程施工綱要規範_全文.txt 第02316章 4.1.3（與第02317章 4.1.2 同文）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "pcc_pipe_test_pressure",
   "src": "pcc_spec",
   "clause": "02505/3.4.3",
   "page": null,
   "title": "水管水壓試驗壓力＝1.5 倍最高許可使用壓力，上限 10 kgf/cm²（操作壓力>10 者以操作壓力計）",
   "keywords": "施工綱要規範 水管 試壓 水壓試驗 漏水試驗 許可壓力 kgf/cm2 10 上限",
   "unit": "kgf/cm2",
   "output": "P_test",
   "latex": "P_{test} = \\max\\left(P_{op},\\ \\min\\left(1.5\\,P_{allow},\\ 10\\right)\\right)",
   "vars": {
    "P_allow": {
     "desc": "該管材最高許可使用壓力",
     "unit": "kgf/cm2",
     "min": 0.5,
     "max": 30.0
    },
    "P_op": {
     "desc": "管線實際操作壓力（無資料時填 0）",
     "unit": "kgf/cm2",
     "min": 0.0,
     "max": 30.0,
     "default": 0.0
    }
   },
   "expr": "max(P_op, min(1.5 * P_allow, 10.0))",
   "tests": [
    {
     "in": {
      "P_allow": 7.5,
      "P_op": 0.0
     },
     "out": 10.0,
     "tol": 1e-06
    },
    {
     "in": {
      "P_allow": 4.0,
      "P_op": 0.0
     },
     "out": 6.0,
     "tol": 1e-06
    },
    {
     "in": {
      "P_allow": 7.5,
      "P_op": 13.0
     },
     "out": 13.0,
     "tol": 1e-06
    }
   ],
   "notes": "第02505章 3.4.3(1)：水管應依「各種管材最高許可使用壓力」之 1.5 倍施行水壓試驗，如超過 10 kgf/cm² 則以 10 kgf/cm² 施行；惟管線實際操作壓力超過 10 kgf/cm² 者，應以實際操作壓力施行，歷時 1 小時。合格判定另有漏水量公式（L 為每小時容許漏水量 l、N 為接頭數、D 為標稱管徑 cm、P 為試水壓力 kgf/cm²），該式於全文文字層僅存變數定義、公式本體遺失，數值未經驗證，須回原規範核對。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 data/法規/公共工程施工綱要規範_全文.txt 第02505章 3.4.3(1)(2)",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "pcc_tree_transplant_weight",
   "src": "pcc_spec",
   "clause": "02905/3.3.1",
   "page": null,
   "title": "樹木吊搬總重量＝莖幹密度×樹體體積＋根球土壤密度×根球體積",
   "keywords": "施工綱要規範 植栽 樹木移植 米高直徑 吊搬 總重量 莖幹密度 根球 土壤密度 機具選用",
   "unit": "t",
   "output": "W",
   "latex": "W = \\rho_{stem}V_{stem} + \\rho_{soil}V_{ball}",
   "vars": {
    "rho_stem": {
     "desc": "樹體莖幹密度（查附錄七，如榕樹 1.13、黑板樹 0.81）",
     "unit": "t/m3",
     "min": 0.3,
     "max": 4.0
    },
    "V_stem": {
     "desc": "樹體（莖幹）體積",
     "unit": "m3",
     "min": 0.001,
     "max": 100.0
    },
    "rho_soil": {
     "desc": "根球部土壤密度（查附錄七，如一般型 1.75、礫石型 2.10）",
     "unit": "t/m3",
     "min": 1.0,
     "max": 4.0
    },
    "V_ball": {
     "desc": "預估或實測根球部體積",
     "unit": "m3",
     "min": 0.001,
     "max": 50.0
    }
   },
   "expr": "rho_stem * V_stem + rho_soil * V_ball",
   "tests": [
    {
     "in": {
      "rho_stem": 1.13,
      "V_stem": 2.0,
      "rho_soil": 1.75,
      "V_ball": 1.5
     },
     "out": 4.885,
     "tol": 1e-06
    },
    {
     "in": {
      "rho_stem": 0.81,
      "V_stem": 1.0,
      "rho_soil": 2.1,
      "V_ball": 0.8
     },
     "out": 2.49,
     "tol": 1e-06
    }
   ],
   "notes": "第02905章 3.3.1(3)：樹木重量計算公式＝（樹體莖幹密度×樹體體積＝樹體部重量）＋（根球部土壤密度×預估或實測根球部體積＝根球部重量）＝樹木吊搬總重量。僅適用於植栽米高直徑大於 30 cm 以上者（須先計算整體吊搬總重量作為選用機具之依據）；根球部挖掘完成後應再複測確認。同章 3.4.2：植穴寬度應大於根球部直徑 2 倍、深度應大於根球部高度 1.3 倍（契約圖說未規定時）。密度值見已驗證表格 pcc_t_02905_stem_density 與 pcc_t_02905_rootball_soil_density。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 data/法規/公共工程施工綱要規範_全文.txt 第02905章 3.3.1(3)、3.4.2 與附錄七",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "pcc_02797_thickness_accept",
