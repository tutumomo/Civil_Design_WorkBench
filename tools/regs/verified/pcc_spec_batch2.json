{
 "formulas": [
  {
   "id": "pcc_02727_mixing_time",
   "src": "pcc_spec",
   "clause": "02727/3.3.3",
   "page": null,
   "title": "連續式拌和機拌和時間＝拌和機載重量÷出口量，且不得超過 60 秒",
   "keywords": "施工綱要規範 冷拌再生瀝青 連續式拌和機 拌和時間 載重量 出口量 60秒",
   "unit": "s",
   "output": "t_mix",
   "latex": "t_{mix} = \\dfrac{W}{q_{out}} \\leq 60\\ \\mathrm{s}",
   "vars": {
    "W": {
     "desc": "拌和機之載重量（由工程司在工地作試驗決定）",
     "unit": "kg",
     "min": 1.0,
     "max": 100000.0
    },
    "q_out": {
     "desc": "拌和機之出口量",
     "unit": "kg/s",
     "min": 0.01,
     "max": 1000.0
    }
   },
   "expr": "W / q_out",
   "warn_if": [
    {
     "expr": "result > 60",
     "msg": "拌和時間超過 60 s 上限（連續式拌和機）"
    }
   ],
   "tests": [
    {
     "in": {
      "W": 3000.0,
      "q_out": 60.0
     },
     "out": 50.0,
     "tol": 1e-06
    },
    {
     "in": {
      "W": 5000.0,
      "q_out": 60.0
     },
     "out": 83.333333333,
     "tol": 1e-06
    }
   ],
   "notes": "第02727章 3.3.3(3)C.c：以連續式拌和機拌和時，拌和時間（s）＝拌和機之載重量（kg）÷拌和機之出口量（kg/s），式中重量由工程司在工地作試驗決定之，惟在連續式拌和機內拌和之時間不得超過 60 s。同款 B：分盤式拌和機之濕拌時間不得超過 50 s。冷拌再生瀝青拌和溫度建議 10 ℃ 以上；乳化瀝青混凝土建議添加 1.5~2.5% 拌和用水量。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 data/法規/公共工程施工綱要規範_全文.txt 第02727章 3.3.3(3)C",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "pcc_02798_cantabro_loss",
   "src": "pcc_spec",
   "clause": "02798/5",
   "page": null,
   "title": "肯塔堡飛散試驗損失率 C＝A／B×100（%，附錄二）",
   "keywords": "施工綱要規範 多孔隙瀝青 肯塔堡飛散試驗 飛散損失率 300轉 附錄二 最佳瀝青含量",
   "unit": "%",
   "output": "C",
   "latex": "C = \\dfrac{A}{B}\\times 100",
   "vars": {
    "A": {
     "desc": "試體試驗後之損失量",
     "unit": "g",
     "min": 0.0,
     "max": 10000.0
    },
    "B": {
     "desc": "試體試驗前之重量",
     "unit": "g",
     "min": 1.0,
     "max": 20000.0
    }
   },
   "expr": "A / B * 100.0",
   "warn_if": [
    {
     "expr": "result > 20",
     "msg": "飛散損失率偏高，通常代表瀝青含量不足或黏結力不佳，須檢討配合設計"
    }
   ],
   "tests": [
    {
     "in": {
      "A": 45.0,
      "B": 1000.0
     },
     "out": 4.5,
     "tol": 1e-06
    },
    {
     "in": {
      "A": 120.0,
      "B": 1000.0
     },
     "out": 12.0,
     "tol": 1e-06
    }
   ],
   "notes": "第02798章附錄二「壓實瀝青混凝土肯塔堡飛散試驗」5. 計算：計算在 300 轉過程中試體所損失重量與原試體重之百分率。原文分數式之分子分母於文字層遺失（僅存「C＝ × 100」與變數定義），依變數定義還原為 A／B。依不同瀝青含量所測得飛散損失率繪製曲線，曲線轉折點切線之交點對應之瀝青含量即最接近之最佳瀝青含量。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 data/法規/公共工程施工綱要規範_全文.txt 第02798章附錄二 5.",
    "by": "agent",
    "date": "2026-11-14"
   }
  }
