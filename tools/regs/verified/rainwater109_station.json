  {
   "id": "rainwater109_engine_output_start",
   "src": "rainwater109",
   "clause": "III-3.2.5",
   "page": 201,
   "title": "啟動最大負荷時引擎輸出動力 PE2=PG2·cosθ_G/(0.736η_G·β)（雨水下水道設計指南 3.2.5）",
   "keywords": "抽水站 柴油引擎 輸出動力 啟動 平均有效壓力 β 發電機效率",
   "unit": "PS",
   "output": "power",
   "latex": "PE_2 = \\dfrac{PG_2\\cos\\theta_G}{0.736\\,\\eta_G\\,\\beta}",
   "vars": {
    "PG2": {
     "desc": "啟動並考慮壓降之發電機容量",
     "unit": "kVA",
     "min": 0
    },
    "costG": {
     "desc": "發電機之力率 cosθ_G（一般 0.8）",
     "unit": "無因次",
     "min": 0,
     "max": 1
    },
    "etaG": {
     "desc": "發電機效率 ηG（見表3-2）",
     "unit": "無因次",
     "min": 0,
     "max": 1
    },
    "beta": {
     "desc": "引擎平均有效壓力 β（1.0，非氣冷式）",
     "unit": "無因次",
     "min": 0
    }
   },
   "expr": "PG2 * costG / (0.736 * etaG * beta)",
   "conditions": [
    {
     "expr": "PG2 > 0 and 0 < etaG <= 1 and beta > 0",
     "msg": "PG2、β 須為正、效率須介於 0~1"
    }
   ],
   "warn_if": [],
   "tests": [
