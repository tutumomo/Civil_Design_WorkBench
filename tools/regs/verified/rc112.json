{
 "formulas": [
  {"id": "rc112_beta1", "title": "等值矩形應力區係數 β1（表22.2.2.4.3）", "src": "rc112", "clause": "22.2.2.4.3", "index_clause": "22.2.2.4.2", "page": 373,
   "keywords": "beta1 β1 等值矩形 應力區", "unit": "-", "output": "beta1",
   "latex": "\\beta_1=0.85-\\frac{0.05(f'_c-28)}{7}\\;(28<f'_c<56\\text{ MPa});\\;0.85\\;(f'_c\\le28);\\;0.65\\;(f'_c\\ge56)",
   "vars": {"fc": {"desc": "混凝土抗壓強度 fc'", "unit": "MPa", "min": 17, "max": 100}},
   "expr": "0.85 if fc<=28 else (0.65 if fc>=56 else 0.85-0.05*(fc-28)/7)",
   "tests": [{"in": {"fc": 40}, "out": 0.7642857142857142, "tol": 1e-9}, {"in": {"fc": 24}, "out": 0.85}, {"in": {"fc": 60}, "out": 0.65}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.373（括號 MPa 版）＋手算＋與 rc_design 交叉比對", "by": "agent", "date": "2026-11-01"}},

  {"id": "rc112_phi_flexure", "title": "撓曲／軸力強度折減因數 φ（表21.2.2，由淨拉應變 εt）", "src": "rc112", "clause": "21.2.2", "page": 366,
   "keywords": "phi φ 強度折減 淨拉應變 撓曲 壓力控制 拉力控制 過渡", "unit": "-", "output": "phi",
   "latex": "\\varphi=0.65+0.25\\frac{\\varepsilon_t-\\varepsilon_{ty}}{0.003}\\;(\\text{其他箍筋});\\;0.75+0.15\\frac{\\varepsilon_t-\\varepsilon_{ty}}{0.003}\\;(\\text{螺箍筋})",
   "vars": {"et": {"desc": "最外緣受拉鋼筋淨拉應變 εt", "unit": "-", "min": 0, "max": 0.05},
            "fy": {"desc": "鋼筋降伏強度", "unit": "MPa", "min": 240, "max": 690},
            "Es": {"desc": "鋼筋彈性模數", "unit": "MPa", "default": 200000},
            "spiral": {"desc": "橫向鋼筋為符合25.7.3之螺箍筋＝1，其他＝0", "unit": "-", "default": 0, "min": 0, "max": 1}},
   "defs": [["ety", "fy/Es"], ["lo", "0.75 if spiral>0.5 else 0.65"], ["k", "0.15 if spiral>0.5 else 0.25"]],
   "expr": "lo if et<=ety else (0.9 if et>=ety+0.003 else lo+k*(et-ety)/0.003)",
   "notes": "112.08.10 版：拉力控制限值為 εty+0.003（舊 100 年版為 0.005）。fy=420 MPa 時條文允許 εty 採 0.002（此處用 fy/Es＝0.0021，φ 稍保守）。壓力控制 0.65（螺箍 0.75）、拉力控制 0.90。",
   "tests": [{"in": {"et": 0.005, "fy": 420}, "out": 0.8916666666666666, "tol": 1e-9}, {"in": {"et": 0.001, "fy": 420}, "out": 0.65}, {"in": {"et": 0.006, "fy": 420}, "out": 0.9}, {"in": {"et": 0.0036, "fy": 420, "spiral": 1}, "out": 0.825, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.366-367（表21.2.2、圖R21.2.2b）＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "rc112_lambda_s", "title": "尺寸效應修正係數 λs（式22.5.5.1.3）", "src": "rc112", "clause": "22.5.5.1.3", "page": 379,
   "keywords": "尺寸效應 lambda λs 剪力", "unit": "-", "output": "lambda_s",
   "latex": "\\lambda_s=\\sqrt{\\frac{2}{1+d/250}}\\le1",
   "vars": {"d": {"desc": "有效深度", "unit": "mm", "min": 1, "max": 5000}},
   "expr": "min(1, sqrt(2/(1+d/250)))",
   "tests": [{"in": {"d": 500}, "out": 0.816496580927726, "tol": 1e-9}, {"in": {"d": 250}, "out": 1.0}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.379（括號 MPa 版，d 以 mm、分母 250）＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "rc112_Vc_a", "title": "非預力構材 Vc（表22.5.5.1 式(a)，Av≥Av,min）", "src": "rc112", "clause": "22.5.5.1", "page": 378,
   "keywords": "Vc 混凝土剪力強度 剪力 shear 非預力", "unit": "N", "output": "Vc",
   "latex": "V_c=\\left(0.17\\lambda\\sqrt{f'_c}+\\frac{N_u}{6A_g}\\right)b_w d",
   "vars": {"fc": {"desc": "混凝土抗壓強度 fc'", "unit": "MPa", "min": 17, "max": 100},
            "bw": {"desc": "腹板寬", "unit": "mm", "min": 1}, "d": {"desc": "有效深度", "unit": "mm", "min": 1},
            "lam": {"desc": "輕質混凝土修正係數 λ（常重 1.0）", "unit": "-", "default": 1.0, "min": 0.4, "max": 1.0},
            "Nu": {"desc": "軸力，壓力為正、拉力為負", "unit": "N", "default": 0},
            "Ag": {"desc": "斷面積（無軸力可不給）", "unit": "mm2", "default": 1, "min": 1}},
   "defs": [["axial", "min(Nu/(6*Ag),0.05*fc)"]],
   "expr": "max(0,min((0.17*lam*sqrt(fc)+axial)*bw*d,0.42*lam*sqrt(fc)*bw*d))",
   "notes": "(a)式與(b)式擇一計算（表22.5.5.1）；Nu/(6Ag) 不得超過 0.05fc'（22.5.5.1.2）；Vc 不得超過 0.42λ√fc'·bw·d（22.5.5.1.1）；Vc 不得小於零。SI（MPa、N、mm）。注意 22.5.5.1.2 僅限制壓力項上限；拉力軸力（Nu<0）會降低 Vc。",
   "tests": [{"in": {"fc": 28, "bw": 300, "d": 500}, "out": 134933.31686429415, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.378-379（括號 MPa 版）＋手算＋與 rc_design.shear_check 交叉比對", "by": "agent", "date": "2026-11-01"}},

  {"id": "rc112_Vc_b_c", "title": "非預力構材 Vc（表22.5.5.1 式(b)／(c)，含縱向鋼筋比 ρw）", "src": "rc112", "clause": "22.5.5.1", "page": 378,
   "keywords": "Vc 混凝土剪力強度 rho 縱向鋼筋比 尺寸效應", "unit": "N", "output": "Vc",
   "latex": "V_c=\\left(0.68\\lambda_s\\lambda(\\rho_w)^{1/3}\\sqrt{f'_c}+\\frac{N_u}{6A_g}\\right)b_w d",
   "vars": {"fc": {"desc": "混凝土抗壓強度 fc'", "unit": "MPa", "min": 17, "max": 100},
            "bw": {"desc": "腹板寬", "unit": "mm", "min": 1}, "d": {"desc": "有效深度", "unit": "mm", "min": 1},
            "rho": {"desc": "縱向受拉鋼筋比 ρw=As/(bw·d)", "unit": "-", "min": 0.0001, "max": 0.1},
            "lam": {"desc": "輕質混凝土修正係數 λ", "unit": "-", "default": 1.0, "min": 0.4, "max": 1.0},
            "no_min_shear_steel": {"desc": "Av<Av,min（式c，乘 λs）＝1；Av≥Av,min（式b）＝0", "unit": "-", "default": 0, "min": 0, "max": 1},
            "Nu": {"desc": "軸力，壓力為正", "unit": "N", "default": 0},
            "Ag": {"desc": "斷面積（無軸力可不給）", "unit": "mm2", "default": 1, "min": 1}},
   "defs": [["ls", "min(1,sqrt(2/(1+d/250))) if no_min_shear_steel>0.5 else 1"], ["axial", "min(Nu/(6*Ag),0.05*fc)"]],
   "expr": "max(0,min((0.68*ls*lam*rho**(1/3)*sqrt(fc)+axial)*bw*d,0.42*lam*sqrt(fc)*bw*d))",
   "notes": "SI（MPa、N、mm）係數 0.68（kgf/cm² 版為 2.12）。式(b)用於 Av≥Av,min；式(c)加 λs 用於 Av<Av,min。受 0.42λ√fc'·bw·d 上限。",
   "tests": [{"in": {"fc": 28, "bw": 300, "d": 500, "rho": 0.01}, "out": 116282.00747739982, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.378（括號 MPa 版）＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "rc112_Vs_stirrup", "title": "剪力鋼筋 Vs=Av·fyt·d/s（式22.5.8.5.3，垂直箍筋）", "src": "rc112", "clause": "22.5.8.5.3", "page": 384,
   "keywords": "Vs 箍筋 剪力鋼筋 stirrup", "unit": "N", "output": "Vs",
   "latex": "V_s=\\frac{A_v f_{yt} d}{s}",
   "vars": {"Av": {"desc": "間距 s 內剪力鋼筋總斷面積", "unit": "mm2", "min": 0},
            "fyt": {"desc": "剪力鋼筋降伏強度", "unit": "MPa", "min": 0, "max": 690},
            "d": {"desc": "有效深度", "unit": "mm", "min": 1}, "s": {"desc": "箍筋縱向間距", "unit": "mm", "min": 1}},
   "expr": "Av*fyt*d/s",
   "warn_if": [{"expr": "fyt>420", "msg": "22.5.3.3：fyt 取值不得超過 20.2.2.4 之限制（解說：設計上限取 420 MPa）"}],
   "notes": "垂直於構材軸線之箍筋；斜向肋筋式(22.5.8.5.4)未收錄。Vs 上限（22.5.1.2）未收錄。",
   "tests": [{"in": {"Av": 142, "fyt": 420, "d": 500, "s": 150}, "out": 198800.0}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.384＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "rc112_As_min_beam", "title": "非預力梁最少撓曲鋼筋 As,min（9.6.1.2）", "src": "rc112", "clause": "9.6.1.2", "index_clause": "9.6.1.1", "page": 127,
   "keywords": "As,min 最少撓曲鋼筋 梁 最小鋼筋", "unit": "mm2", "output": "As_min",
   "latex": "A_{s,min}=\\max\\left(\\frac{0.25\\sqrt{f'_c}}{f_y}b_w d,\\;\\frac{1.4}{f_y}b_w d\\right)",
   "vars": {"fc": {"desc": "混凝土抗壓強度 fc'", "unit": "MPa", "min": 17, "max": 100},
            "fy": {"desc": "鋼筋降伏強度", "unit": "MPa", "min": 240, "max": 550},
            "bw": {"desc": "腹板寬", "unit": "mm", "min": 1}, "d": {"desc": "有效深度", "unit": "mm", "min": 1}},
   "expr": "max(0.25*sqrt(fc)/fy,1.4/fy)*bw*d",
   "notes": "fy 不得大於 550 MPa；翼板受拉之靜定梁 bw 取 bf 與 2bw 之小者；若所有斷面配置之 As 大於分析所需至少 1/3 則不受此限（9.6.1.3）。",
   "tests": [{"in": {"fc": 28, "fy": 420, "bw": 300, "d": 500}, "out": 500.0, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.127（括號 MPa 版）＋手算＋與舊版式(3-3)/(3-4)比對", "by": "agent", "date": "2026-11-01"}},

  {"id": "rc112_Av_min_over_s", "title": "非預力梁最少剪力鋼筋 Av,min/s（表9.6.3.4 (a)(b)）", "src": "rc112", "clause": "9.6.3.4", "index_clause": "9.6.3.1", "page": 129,
   "keywords": "Av,min 最少剪力鋼筋 箍筋 間距", "unit": "mm2/mm", "output": "Av_min_over_s",
   "latex": "\\frac{A_{v,min}}{s}=\\max\\left(0.062\\sqrt{f'_c}\\frac{b_w}{f_{yt}},\\;0.35\\frac{b_w}{f_{yt}}\\right)",
   "vars": {"fc": {"desc": "混凝土抗壓強度 fc'", "unit": "MPa", "min": 17, "max": 100},
            "bw": {"desc": "腹板寬", "unit": "mm", "min": 1},
            "fyt": {"desc": "剪力鋼筋降伏強度", "unit": "MPa", "min": 240, "max": 690}},
   "expr": "max(0.062*sqrt(fc)*bw/fyt,0.35*bw/fyt)",
   "notes": "僅適用非預力梁，且依 9.5.4.1 可忽略扭力時；預力梁（Apsfse≥0.4(Apsfpu+Asfy)）之取較小者規定未收錄。是否需配置 Av,min 見表 9.6.3.1。",
   "tests": [{"in": {"fc": 28, "bw": 300, "fyt": 420}, "out": 0.25, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.129（括號 MPa 版）＋手算＋與 rc_design 交叉比對", "by": "agent", "date": "2026-11-01"}},

  {"id": "rc112_Mn_rect_singly", "title": "單筋矩形梁標稱彎矩 Mn（由 22.2.2 假設靜力平衡導出）", "src": "rc112", "clause": "22.2.2.4.1", "page": 372,
   "keywords": "Mn 標稱彎矩 單筋 矩形 撓曲強度", "unit": "N·mm", "output": "Mn",
   "latex": "a=\\frac{A_s f_y}{0.85 f'_c b},\\quad M_n=A_s f_y\\left(d-\\frac{a}{2}\\right)",
   "vars": {"As": {"desc": "受拉鋼筋面積", "unit": "mm2", "min": 0},
            "fy": {"desc": "鋼筋降伏強度", "unit": "MPa", "min": 240, "max": 690},
            "fc": {"desc": "混凝土抗壓強度 fc'", "unit": "MPa", "min": 17, "max": 100},
            "b": {"desc": "受壓面寬", "unit": "mm", "min": 1}, "d": {"desc": "有效深度", "unit": "mm", "min": 1}},
   "defs": [["a", "As*fy/(0.85*fc*b)"]],
   "expr": "As*fy*(d-a/2)",
   "conditions": [{"expr": "As*fy/(0.85*fc*b)<=d", "msg": "等值應力塊深度 a 超過 d，斷面不合理"}],
   "notes": "22.2.2.4.1 規定混凝土應力 0.85fc' 均勻分布於等值壓力區；本式為其靜力平衡之導出，非條文逐字公式。僅適用矩形、僅受拉鋼筋；設計強度 φMn 之 φ 須由 εt 與表21.2.2 決定。T 形或有受壓筋不適用。",
   "tests": [{"in": {"As": 1500, "fy": 420, "fc": 28, "b": 300, "d": 500}, "out": 287205882.35294116, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "對照原頁圖 p.372-373 假設＋靜力平衡手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "rc112_ld_tension", "title": "受拉竹節鋼筋伸展長度 ld（表25.4.2.3）", "src": "rc112", "clause": "25.4.2.3", "page": 448,
   "keywords": "ld 伸展長度 錨定 development length 鋼筋 搭接", "unit": "mm", "output": "ld",
   "latex": "\\ell_d=\\left(\\frac{f_y\\psi_t\\psi_e}{c\\,\\lambda\\sqrt{f'_c}}\\right)d_b,\\;c=2.1/1.7\\,(\\text{間距良好}),\\;1.4/1.1\\,(\\text{其他})\\;(D19\\text{以下}/D22\\text{以上})",
   "vars": {"fy": {"desc": "鋼筋降伏強度", "unit": "MPa", "min": 240, "max": 690},
            "fc": {"desc": "混凝土抗壓強度 fc'", "unit": "MPa", "min": 17, "max": 100},
            "db": {"desc": "鋼筋標稱直徑（D19 及以下 ≤19.5；D22 及以上 ≥22）", "unit": "mm", "min": 6, "max": 60},
            "psi_t": {"desc": "鋼筋位置係數 ψt", "unit": "-", "default": 1.0, "min": 1.0, "max": 1.3},
            "psi_e": {"desc": "塗布係數 ψe", "unit": "-", "default": 1.0, "min": 1.0, "max": 1.5},
            "lam": {"desc": "輕質混凝土修正係數 λ", "unit": "-", "default": 1.0, "min": 0.4, "max": 1.0},
            "good_spacing": {"desc": "表中第一列情況（淨間距≥db、保護層≥db、箍筋不少於規範最小值；或淨間距≥2db 且保護層≥db）＝1；其他情況＝0", "unit": "-", "min": 0, "max": 1}},
   "conditions": [{"expr": "db<=19.5 or db>=22", "msg": "鋼筋直徑須為 D19 及以下或 D22 及以上之標稱尺寸"}],
   "defs": [["small", "1 if db<=19.5 else 0"], ["c", "(2.1 if small>0.5 else 1.7) if good_spacing>0.5 else (1.4 if small>0.5 else 1.1)"], ["rf", "min(sqrt(fc),8.3)"], ["psi", "min(psi_t*psi_e,1.7)"], ["ld_a", "fy*psi/(c*lam*rf)*db"]],
   "expr": "max(ld_a,300)",
   "notes": "SI（MPa、mm）。已含：25.4.2.1(b) 最小 300 mm、25.4.1.4 √fc′≤8.3 MPa、ψt·ψe≤1.7（表25.4.2.5）。steps.ld_a 為不含 300 mm 下限之值，供搭接長度（rc112_ls_tension_lap）使用。修正因數見表 rc112_ld_modifiers。未收錄：頂部鋼筋位置判定、(cb+Ktr)/db 法（式25.4.2.4a）、25.4.10.1 超量鋼筋折減。",
   "tests": [{"in": {"fy": 420, "fc": 28, "db": 25, "good_spacing": 1}, "out": 1167.2432254696723, "tol": 1e-9}, {"in": {"fy": 420, "fc": 28, "db": 16, "good_spacing": 1}, "out": 604.7431568147634, "tol": 1e-9}, {"in": {"fy": 420, "fc": 28, "db": 16, "good_spacing": 0}, "out": 907.1147352221453, "tol": 1e-9}],
   "status": "verified", "verified": {"method": "逐式對照原頁圖 p.448（括號 MPa 版）＋手算（解說之 47db 範例相符：420/(1.7√28)=46.7）", "by": "agent", "date": "2026-11-01"}}
