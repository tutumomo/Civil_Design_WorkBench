  {
   "id": "rc112_ldh_hook",
   "title": "受拉標準彎鉤伸展長度 ldh（式25.4.3.1）",
   "src": "rc112",
   "clause": "25.4.3.1",
   "page": 451,
   "keywords": "ldh 彎鉤 伸展長度 標準彎鉤 錨定",
   "unit": "mm",
   "output": "ldh",
   "latex": "\\ell_{dh}=\\max\\left(\\frac{f_y\\psi_e\\psi_r\\psi_o\\psi_c}{23\\lambda\\sqrt{f'_c}}d_b^{1.5},\\;8d_b,\\;150\\right)",
   "vars": {
    "fy": {
     "desc": "鋼筋降伏強度",
     "unit": "MPa",
     "min": 240,
     "max": 690
    },
    "fc": {
     "desc": "混凝土抗壓強度 fc'",
     "unit": "MPa",
     "min": 17,
     "max": 100
    },
    "db": {
     "desc": "鋼筋標稱直徑（適用 ≤D57，彎鉤規定限標準彎鉤）",
     "unit": "mm",
     "min": 6,
     "max": 60
    },
    "psi_e": {
     "desc": "塗布係數：環氧樹脂 1.2、其他 1.0",
     "unit": "-",
     "default": 1.0,
     "min": 1.0,
     "max": 1.2
    },
    "psi_r": {
     "desc": "圍束鋼筋係數：≤D36 且 Ath≥0.4Ahs 或 s≥6db 取 1.0，其他 1.6",
     "unit": "-",
     "default": 1.6,
     "min": 1.0,
     "max": 1.6
    },
    "psi_o": {
     "desc": "位置係數：柱核心內終止或側向保護層≥65 mm 或≥6db 取 1.0，其他 1.25",
     "unit": "-",
     "default": 1.25,
     "min": 1.0,
     "max": 1.25
    },
    "psi_c": {
     "desc": "混凝土強度係數 ψc（用 rc112_psi_c_hook）",
     "unit": "-",
     "default": 1.0,
     "min": 0.6,
     "max": 1.0
    },
    "lam": {
     "desc": "輕質混凝土修正係數 λ",
     "unit": "-",
     "default": 1.0,
     "min": 0.4,
     "max": 1.0
    }
   },
   "defs": [
    [
     "rf",
     "min(sqrt(fc),8.3)"
    ]
   ],
   "expr": "max(fy*psi_e*psi_r*psi_o*psi_c/(23*lam*rf)*db**1.5,8*db,150)",
   "notes": "SI（MPa、mm）。注意：原書 kgf/cm² 版公式印成與 [MPa] 版同為 23，疑似排版錯誤，本庫只採 [MPa] 版。ldh 自臨界斷面量至彎鉤最外緣；位於構材不連續端使用 25.4.3.4（未收錄）；25.4.3.8 折減因數（超量鋼筋等）未收錄；預設 ψr、ψo 取保守值（1.6、1.25）。√fc′ 上限 8.3 MPa（25.4.1.4）。",
   "tests": [
    {
     "in": {
