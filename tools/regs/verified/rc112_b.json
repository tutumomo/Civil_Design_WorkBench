      "db": 25,
      "psi_r": 1.6,
      "psi_o": 1.0,
      "psi_c": 1.0
     },
     "out": 690.1959941907627,
     "tol": 1e-09
    },
    {
     "in": {
      "fy": 420,
      "fc": 28,
      "db": 6,
      "psi_r": 1.0,
      "psi_o": 1.0,
      "psi_c": 1.0
     },
     "out": 150.0
    }
   ],
