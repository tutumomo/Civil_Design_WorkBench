  {
   "id": "rc112_ls_tension_lap",
   "title": "受拉竹節鋼筋搭接長度 lst（表25.5.2.1）",
   "src": "rc112",
   "clause": "25.5.2.1",
   "page": 468,
   "keywords": "搭接長度 搭接 lap splice 甲級 乙級",
   "unit": "mm",
   "output": "lst",
   "latex": "\\ell_{st}=\\max(k\\,\\psi_g\\,\\ell_d,\\;300),\\;k=1.0\\,(\\text{甲級}),\\;1.3\\,(\\text{乙級})",
   "vars": {
    "ld": {
     "desc": "伸展長度 ld（依 25.4.2.1(a) 算出之值，不含 300 mm 下限；取 rc112_ld_tension 的 steps.ld_a）",
     "unit": "mm",
     "min": 1
    },
    "fy": {
     "desc": "鋼筋降伏強度",
     "unit": "MPa",
     "min": 240,
     "max": 690
    },
    "ratio": {
     "desc": "搭接長度內鋼筋比 (使用As)/(需求As)",
     "unit": "-",
     "min": 0
    },
    "pct": {
     "desc": "搭接長度內被搭接鋼筋面積占全部鋼筋之百分比",
     "unit": "%",
     "min": 0,
     "max": 100
    }
   },
   "defs": [
    [
     "psi_g",
     "1.0 if fy<=420 else (1.08 if fy<=490 else (1.15 if fy<=550 else 1.30))"
    ],
    [
     "k",
     "1.0 if (ratio>=2 and pct<=50) else 1.3"
    ]
   ],
   "expr": "max(k*psi_g*ld,300)",
   "notes": "甲級搭接僅當 (使用As/需求As)≥2 且搭接比例≤50% 才可用，否則乙級（1.3ψg·ld）。ψg：fy≤420→1.0；490→1.08；550→1.15；690→1.30，條文未規定內插，fy 介於其間時本庫取上一檔（保守）。不適用束筋、受壓搭接、銲接網。",
   "tests": [
