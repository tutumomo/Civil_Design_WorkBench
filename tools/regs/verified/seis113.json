  {"id": "seis113_Fx_rest", "title": "其餘各層橫力 Fx=(V−Ft)Wxhx/ΣWihi（式2-15）", "src": "seis113", "clause": "2.11", "page": 30,
   "keywords": "Fx 豎向分配 樓層橫力 地震力", "unit": "tf", "output": "Fx",
   "latex": "F_x=\\frac{(V-F_t)W_xh_x}{\\sum_{i=1}^{n}W_ih_i}",
   "vars": {"V": {"desc": "最小設計水平總橫力", "unit": "tf", "min": 0}, "Ft": {"desc": "頂層外加集中橫力", "unit": "tf", "min": 0},
            "Wx": {"desc": "第 x 層重量", "unit": "tf", "min": 0}, "hx": {"desc": "第 x 層距基面高度", "unit": "m", "min": 0},
            "sumWh": {"desc": "ΣWihi（全部樓層 W×h 之和；計算 x 層時不含已扣除之 Ft）", "unit": "tf·m", "min": 0.001}},
