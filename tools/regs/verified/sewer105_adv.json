{
 "formulas": [
  {
   "id": "sewer105_coag_mixing_power",
   "src": "sewer105",
   "clause": "5-4-01",
   "page": 363,
   "title": "快混池所需攪拌設備動力 P=G²·V·μ（式5-1）",
   "keywords": "污水下水道 混凝沉降 快混池 攪拌動力 速度梯度 粘滯度 GT值",
   "unit": "W",
   "output": "P",
   "latex": "P = G^{2}V\\mu",
   "vars": {
    "G": {
     "desc": "速度梯度（快混 300~1,000 sec⁻¹、慢混 20~80 sec⁻¹）",
     "unit": "1/s",
     "min": 1.0,
     "max": 5000.0,
     "default": 500.0
    },
    "V": {
     "desc": "池槽體積",
     "unit": "m3",
     "min": 0.1,
     "max": 100000.0
    },
    "mu": {
     "desc": "流體粘滯度（20 °C 水約 0.001）",
     "unit": "N*s/m2",
     "min": 0.0005,
     "max": 0.05,
     "default": 0.001
    }
   },
   "expr": "G ** 2.0 * V * mu",
   "warn_if": [
    {
     "expr": "result / V < 0.01 or result / V > 1000",
     "msg": "單位容積動力超出常見範圍，請確認 G、V、μ 單位一致（SI：G 1/s、V m³、μ N·s/m²）"
    }
   ],
   "tests": [
    {
     "in": {
      "G": 500.0,
      "V": 20.0,
      "mu": 0.001
     },
     "out": 5000.0,
     "tol": 1e-06
    },
    {
     "in": {
      "G": 800.0,
      "V": 10.0,
      "mu": 0.001
     },
     "out": 6400.0,
     "tol": 1e-06
    }
   ],
   "notes": "式(5-1)。快混槽水力停留時間 1~3 分鐘、G=300~1,000 sec⁻¹；慢混槽 20~30 分鐘、G=20~80 sec⁻¹、GT 值 10⁴~10⁵。原文另註 V 可為 m³ 或 ft³、μ 對應 N·s/m² 或 lb·s/ft²（採用英制時 P 之單位為 hp）。凝聚劑一般使用鐵鹽、鋁鹽或有機凝聚劑，適當添加量可使總磷達 0.5 mg/L。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.363（頁碼 346）式(5-1) 及式中說明（另以 150 dpi 頁面影像目視核對）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "sewer105_impeller_power",
   "src": "sewer105",
   "clause": "5-4-01",
   "page": 364,
   "title": "攪拌設備可提供之動力 P=k·ρ·n³·D⁵（式5-2）",
   "keywords": "污水下水道 混凝沉降 攪拌機 槳葉型式 流體密度 轉速 槳葉直徑 功率常數",
   "unit": "W",
   "output": "P",
   "latex": "P = k\\,\\rho\\,n^{3}D^{5}",
   "vars": {
    "k": {
     "desc": "槳葉型式常數（6葉平板6.30／6葉曲線4.80／單層螺旋0.32／雙層螺旋1.00／flat type 6 blades 1.70／fan type 1.65）",
     "unit": "-",
     "min": 0.1,
     "max": 20.0
    },
    "rho": {
     "desc": "流體密度",
     "unit": "kg/m3",
     "min": 500.0,
     "max": 2000.0,
     "default": 1000.0
    },
    "n": {
     "desc": "轉速",
     "unit": "1/s",
     "min": 0.1,
     "max": 20.0
    },
    "D": {
     "desc": "槳葉半徑（原文為槳葉半徑，常數對應直徑 D）",
     "unit": "m",
     "min": 0.05,
     "max": 5.0
    }
   },
   "expr": "k * rho * n ** 3.0 * D ** 5.0",
   "tests": [
    {
     "in": {
      "k": 6.3,
      "rho": 1000.0,
      "n": 1.2,
      "D": 0.6
     },
     "out": 846.526464,
     "tol": 1e-06
    },
    {
     "in": {
      "k": 6.3,
      "rho": 1000.0,
      "n": 1.0,
      "D": 0.5
     },
     "out": 196.875,
     "tol": 1e-06
    }
   ],
   "notes": "式(5-2)。原文式中僅列 ρ（流體密度，kg/m³ 或 slug/ft³），未明列 n 與 D 之單位；本條目採 SI（n 為 rev/s、D 為 m，D 以槳葉直徑計），若手邊轉速為 rpm 須先除以 60，否則結果偏大 60³ 倍。槳葉型式常數見原文圖5-6。可與式(5-1) 之 P 反推所需 n。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.364（頁碼 347）式(5-2) 及式中說明、圖5-6 槳葉常數（另以 150 dpi 頁面影像目視核對）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "sewer105_freundlich_isotherm",
   "src": "sewer105",
   "clause": "5-5-01",
   "page": 367,
   "title": "Freundlich 等溫吸附方程式 x/m=Kf·Ce^(1/n)（式5-4）",
   "keywords": "污水下水道 活性碳吸附 Freundlich 等溫吸附 容量因子 強度參數 平衡濃度",
   "unit": "mg/mg",
   "output": "xm",
   "latex": "\\dfrac{x}{m} = K_f\\,C_e^{1/n}",
   "vars": {
    "Kf": {
     "desc": "Freundlich 容量因子",
     "unit": "-",
     "min": 0.01,
     "max": 100.0
    },
    "Ce": {
     "desc": "吸附質的平衡濃度",
     "unit": "mg/L",
     "min": 0.0001,
     "max": 1000.0
    },
    "invn": {
     "desc": "Freundlich 強度參數 1/n",
     "unit": "-",
     "min": 0.1,
     "max": 1.5,
     "default": 0.5
    }
   },
   "expr": "Kf * Ce ** invn",
   "tests": [
    {
     "in": {
      "Kf": 5.0,
      "Ce": 10.0,
      "invn": 0.5
     },
     "out": 15.8113883,
     "tol": 1e-06
    },
    {
     "in": {
      "Kf": 0.02,
      "Ce": 1.0,
      "invn": 0.4
     },
     "out": 0.02,
     "tol": 1e-06
    }
   ],
   "notes": "式(5-4)。x/m：單位吸附劑（活性碳）可吸附的吸附質（污染物），mg/mg。等溫吸附方程式另含 Langmuir 及 BET isotherm，原文僅介紹前二者。Kf、1/n 係以吸附實驗（等溫吸附曲線或管柱法）求得。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.367（頁碼 350）式(5-4) 及式中說明（另以 150 dpi 頁面影像目視核對）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "sewer105_langmuir_isotherm",
   "src": "sewer105",
   "clause": "5-5-01",
   "page": 367,
   "title": "Langmuir 等溫吸附方程式 x/m=a·b·Ce/(1+b·Ce)（式5-5）",
   "keywords": "污水下水道 活性碳吸附 Langmuir 等溫吸附 經驗常數 平衡濃度",
   "unit": "mg/mg",
   "output": "xm",
   "latex": "\\dfrac{x}{m} = \\dfrac{a\\,b\\,C_e}{1 + b\\,C_e}",
   "vars": {
    "a": {
     "desc": "經驗常數（最大吸附量）",
     "unit": "mg/mg",
     "min": 0.001,
     "max": 100.0
    },
    "b": {
     "desc": "經驗常數",
     "unit": "L/mg",
     "min": 0.0001,
     "max": 10.0
    },
    "Ce": {
     "desc": "吸附質的平衡濃度",
     "unit": "mg/L",
     "min": 0.0001,
     "max": 1000.0
    }
   },
   "expr": "a * b * Ce / (1.0 + b * Ce)",
   "tests": [
    {
     "in": {
      "a": 100.0,
      "b": 0.05,
      "Ce": 10.0
     },
     "out": 33.33333333,
     "tol": 1e-06
    },
    {
     "in": {
      "a": 0.1,
      "b": 0.5,
      "Ce": 20.0
     },
     "out": 0.09090909,
     "tol": 1e-06
    }
   ],
   "notes": "式(5-5)。a、b 為經驗常數。Ce 極低時趨近 a·b·Ce（線性），Ce 極高時趨近 a（單分子層飽和），此為與 Freundlich 之主要差異。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.367（頁碼 350）式(5-5) 及式中說明（另以 150 dpi 頁面影像目視核對）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "sewer105_gac_mass_balance",
   "src": "sewer105",
   "clause": "5-5-01",
   "page": 367,
   "title": "粒狀活性碳反應器質量平衡 M=Q·C0·t−Q·Ce·t−M_GAC·qe（式5-6）",
   "keywords": "污水下水道 粒狀活性碳 反應器 質量平衡 累積量 吸附量 空床接觸時間",
   "unit": "mg",
   "output": "M",
   "latex": "M = Q C_0 t - Q C_e t - M_{GAC}\\,q_e",
   "vars": {
    "Q": {
     "desc": "流量",
     "unit": "L/hr",
     "min": 0.1,
     "max": 1000000.0
    },
    "C0": {
     "desc": "吸附質初始濃度",
     "unit": "mg/L",
     "min": 0.01,
     "max": 1000.0
    },
    "Ce": {
     "desc": "吸附質最終平衡濃度",
     "unit": "mg/L",
     "min": 0.0,
     "max": 1000.0
    },
    "t": {
     "desc": "時間",
     "unit": "hr",
     "min": 0.01,
     "max": 100000.0
    },
    "MGAC": {
     "desc": "吸附劑（活性碳）質量",
     "unit": "mg",
     "min": 1.0,
     "max": 1000000000.0
    },
    "qe": {
     "desc": "平衡後吸附相的濃度",
     "unit": "mg吸附質/mg吸附劑",
     "min": 0.0,
     "max": 1.0
    }
   },
   "expr": "Q * C0 * t - Q * Ce * t - MGAC * qe",
   "tests": [
    {
     "in": {
      "Q": 100.0,
      "C0": 50.0,
      "Ce": 5.0,
      "t": 10.0,
      "MGAC": 2000.0,
      "qe": 0.2
     },
     "out": 44600.0,
     "tol": 1e-06
    },
    {
     "in": {
      "Q": 200.0,
      "C0": 30.0,
      "Ce": 0.0,
      "t": 24.0,
      "MGAC": 10000.0,
      "qe": 0.1
     },
     "out": 143000.0,
     "tol": 1e-06
    }
   ],
   "notes": "式(5-6)。穩態下累積量＝進流量−出流量−吸附量。活性碳吸附以去除二級處理水中之有機物、色度及臭味為目的；過濾線速度向下流 5~10 m/hr、向上流 10~20 m/hr；活性碳直徑約 1~5 mm。設計參數查表5-5。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.367（頁碼 350）式(5-6) 及式中說明（另以 150 dpi 頁面影像目視核對）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "sewer105_hypochlorite_dosing",
   "src": "sewer105",
   "clause": "6-2-04",
   "page": 374,
   "title": "次氯酸鈉加藥量 VR=Q·R·(100/C)·(1/D)×10⁻³（式6-1）",
   "keywords": "污水下水道 次氯酸鈉 消毒 加藥量 有效氯濃度 比重 接觸槽 15分鐘",
   "unit": "L/hr",
   "output": "VR",
   "latex": "VR = Q\\times R\\times\\dfrac{100}{C}\\times\\dfrac{1}{D}\\times 10^{-3}",
   "vars": {
    "Q": {
     "desc": "處理水量",
     "unit": "m3/hr",
     "min": 0.1,
     "max": 1000000.0
    },
    "R": {
     "desc": "氯加藥率",
     "unit": "mg/L",
     "min": 0.1,
     "max": 30.0
    },
    "C": {
     "desc": "有效氯濃度",
     "unit": "%",
     "min": 1.0,
     "max": 100.0
    },
    "D": {
     "desc": "次氯酸鈉溶液之比重",
     "unit": "-",
     "min": 0.9,
     "max": 1.5,
     "default": 1.2
    }
   },
   "expr": "Q * R * 100.0 / C / D * 1e-3",
   "warn_if": [
    {
     "expr": "C > 60",
     "msg": "有效氯濃度超過 60% 者腐蝕性極高，加藥設備與儲槽材質須特別確認"
    }
   ],
   "tests": [
    {
     "in": {
      "Q": 1000.0,
      "R": 3.0,
      "C": 10.0,
      "D": 1.2
     },
     "out": 25.0,
     "tol": 1e-06
    },
    {
     "in": {
      "Q": 500.0,
      "R": 5.0,
      "C": 12.5,
      "D": 1.15
     },
     "out": 17.39130435,
     "tol": 1e-06
    }
   ],
   "notes": "式(6-1)。接觸槽容量依計畫最大時污水量至少 15 分鐘之水力停留時間決定；加藥機採隔膜式或磁驅離心式、至少一台備用；次氯酸鈉溶液貯存容量以七日份為原則、貯存槽二槽以上、槽周圍設槽容量 1.1 倍容積之圍堤。第二筆：500×5×100/12.5/1.15×10⁻³ = 17.3913 L/hr。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.374（頁碼 357）式(6-1) 及式中說明（另以 150 dpi 頁面影像目視核對）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "sewer105_centrifuge_dewatering_count",
   "src": "sewer105",
   "clause": "7-5-04",
   "page": 403,
   "title": "離心式脫水機台數 N=Q/(q·t)（式7-25）",
   "keywords": "污水下水道 離心式脫水機 台數 每台每小時可處理量 工作日操作時間 備用",
   "unit": "台",
   "output": "N",
   "latex": "N = \\dfrac{Q}{q\\,t}",
   "vars": {
    "Q": {
     "desc": "處理污泥量",
     "unit": "m3/d",
     "min": 0.1,
     "max": 100000.0
    },
    "q": {
     "desc": "每台每小時可處理量",
     "unit": "m3/h",
     "min": 0.1,
     "max": 1000.0
    },
    "t": {
     "desc": "工作日操作時間",
     "unit": "hr/day",
     "min": 1.0,
     "max": 24.0,
     "default": 8.0
    }
   },
   "expr": "Q / (q * t)",
   "warn_if": [
    {
     "expr": "result != ceil(result)",
     "msg": "台數須無條件進位，且原則上應有 2 台以上（含備用）"
