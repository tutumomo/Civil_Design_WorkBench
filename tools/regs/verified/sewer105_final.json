 "formulas": [
  {
   "id": "sewer105_roller_thickener_count",
   "src": "sewer105",
   "clause": "7-3-05",
   "page": 389,
   "title": "滾筒式濃縮機台數 N=Q/(q·t)（式7-18）",
   "keywords": "污水下水道 污泥 滾筒式濃縮機 台數 處理污泥量 每台處理容量 工作日操作時間 式7-18",
   "unit": "台",
   "output": "N",
   "latex": "N = \\dfrac{Q}{q \\times t}",
   "vars": {
    "Q": {
     "desc": "處理污泥量",
     "unit": "m3/day",
     "min": 0.1,
     "max": 100000.0
    },
    "q": {
     "desc": "1 台每小時處理容量",
     "unit": "m3/hr",
     "min": 0.1,
     "max": 1000.0
    },
    "t": {
     "desc": "工作日 1 天操作時間",
     "unit": "hr/day",
     "min": 1.0,
     "max": 24.0,
     "default": 8.0
    }
   },
   "expr": "Q / (q * t)",
   "warn_if": [
    {
     "expr": "result < 2",
     "msg": "計算台數未滿 2 台，依 7-3-05 條文 2. 濃縮機應設二組以上，實際配置須取 2 台以上"
    }
   ],
   "tests": [
    {
     "in": {
      "Q": 1000.0,
      "q": 50.0,
      "t": 8.0
     },
     "out": 2.5,
     "tol": 1e-06
    },
    {
     "in": {
      "Q": 2000.0,
      "q": 40.0,
      "t": 10.0
     },
     "out": 5.0,
     "tol": 1e-06
    },
    {
     "in": {
      "Q": 300.0,
      "q": 60.0,
      "t": 8.0
     },
     "out": 0.625,
     "tol": 1e-06
    }
   ],
   "notes": "式(7-18)（7-3-05 解說 1.）。與離心式之式(7-17) 形式完全相同，但分屬不同條文，故獨立建條目。條文 1.：台數依處理污泥量、每台處理容量及工作日操作時數決定；條文 2.：應設二組以上，由具低轉速之濾布或金屬篩網構成旋轉主體、攪拌器、支撐架、驅動馬達及減速機組成。污泥進料泵應具備定量排量功能，每組濃縮機各設一台並應設置加藥設備。滾筒轉速 5~20 rpm，濃縮後污泥濃度約 3~4%。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.389（頁碼 372）式(7-18) 及式中說明（另以 150 dpi 頁面影像目視核對）",
    "by": "agent",
    "date": "2026-11-14"
   }
  }
