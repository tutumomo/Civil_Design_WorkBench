{
 "formulas": [
  {
   "id": "sewer105_stokes_settling_velocity",
   "src": "sewer105",
   "clause": "3-5-01",
   "page": 278,
   "title": "Stokes 定律沉降速度 Vt=g·d²(ρp−ρm)/(18μ)（式3-30，沉砂池）",
   "keywords": "污水下水道 沉砂池 Stokes 沉降速度 砂礫 粒徑 黏度",
   "unit": "m/s",
   "output": "Vt",
   "latex": "V_t = \\dfrac{g\\,d^{2}\\left(\\rho_p-\\rho_m\\right)}{18\\mu}",
   "vars": {
    "g": {
     "desc": "重力加速度",
     "unit": "m/s2",
     "min": 9.7,
     "max": 9.9,
     "default": 9.8
    },
    "d": {
     "desc": "粒子（砂礫）直徑",
     "unit": "m",
     "min": 1e-05,
     "max": 0.01
    },
    "rho_p": {
     "desc": "粒子密度（砂礫約 2,650）",
     "unit": "kg/m3",
     "min": 1000,
     "max": 8000
    },
    "rho_m": {
     "desc": "液體密度（水約 999）",
     "unit": "kg/m3",
     "min": 800,
     "max": 2000
    },
    "mu": {
     "desc": "液體動力黏度（15.5°C 水約 1.12e-3）",
     "unit": "Pa·s",
     "min": 0.0001,
     "max": 0.01
    }
   },
   "expr": "g * d ** 2 * (rho_p - rho_m) / (18.0 * mu)",
   "conditions": [
    {
     "expr": "rho_p > rho_m",
     "msg": "粒子密度須大於液體密度才會沉降"
    }
   ],
   "warn_if": [
    {
     "expr": "result > 0.1",
     "msg": "沉降速度偏大，雷諾數可能已超出 Stokes 層流適用範圍（Re<1），須改用過渡區公式"
    }
   ],
   "tests": [
    {
     "in": {
      "g": 9.8,
      "d": 0.00021,
      "rho_p": 2650.0,
      "rho_m": 998.2,
      "mu": 0.00112
     },
     "out": 0.035405,
     "tol": 0.0001
    },
    {
     "in": {
      "g": 9.8,
      "d": 0.00015,
      "rho_p": 2650.0,
      "rho_m": 998.2,
      "mu": 0.00112
     },
     "out": 0.018062,
     "tol": 0.0001
    }
   ],
   "notes": "指針式(3-30)（3-5-01 解說），原文字列單位「ρ: g/m3、μ: g/m.sec」應為 kg/m³ 與 Pa·s（kg/(m·s)）之誤植，本條目採 SI 一致單位。注意：以 Stokes 式算 d=0.21 mm 得 212 cm/min，而指針表3-31 公布值為 131 cm/min（實測值，雷諾數已進入過渡區），設計請以表3-31 為準。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.278（頁碼 261）式(3-30)，並核算其與表3-31 之差異",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "sewer105_grit_overflow_rate",
   "src": "sewer105",
   "clause": "3-5-01",
   "page": 277,
   "title": "水平流沉砂池表面溢流率＝沉降速度×1,440×10⁻²（表3-31 註2）",
   "keywords": "污水下水道 沉砂池 表面溢流率 沉降速度 單位換算 cm/min",
   "unit": "m3/m2/day",
   "output": "overflow",
   "latex": "O = V_t \\times 1{,}440 \\times 10^{-2}",
   "vars": {
    "Vt_cm_min": {
     "desc": "砂礫沉降速度",
     "unit": "cm/min",
     "min": 0.1,
     "max": 10000.0
    }
   },
   "expr": "Vt_cm_min * 1440.0 * 0.01",
   "tests": [
    {
     "in": {
      "Vt_cm_min": 131.0
     },
     "out": 1886.4,
     "tol": 1e-06
    },
    {
     "in": {
      "Vt_cm_min": 165.0
     },
     "out": 2376.0,
     "tol": 1e-06
    }
   ],
   "notes": "表3-31 註2：表面溢流率(m³/m²/d)＝沉降速度(cm/min)×1,440×10⁻²。表列 0.21 mm 砂礫 131 cm/min → 1,890 m³/m²/d（原表四捨五入）。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.277（頁碼 260）表3-31 註2",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "sewer105_primary_clarifier_area",
   "src": "sewer105",
   "clause": "3-6-04",
   "page": 294,
   "title": "初級沉澱池表面積 A=Q/l（式3-30）",
   "keywords": "污水下水道 初級沉澱池 表面積 表面積負荷 沉澱池設計",
   "unit": "m2",
   "output": "A",
   "latex": "A = \\dfrac{Q}{l}",
   "vars": {
    "Q": {
     "desc": "進流水量",
     "unit": "m3/day",
     "min": 0.001,
     "max": 1000000.0
    },
    "l": {
     "desc": "表面積負荷（最大日流量下 35~70）",
     "unit": "m3/m2/day",
     "min": 1.0,
     "max": 500.0
    }
   },
   "expr": "Q / l",
   "warn_if": [
    {
     "expr": "l < 35 or l > 70",
     "msg": "表面積負荷超出指針建議 35~70 m³/m²·day（3-6-03）"
    }
   ],
   "tests": [
    {
     "in": {
      "Q": 10000.0,
      "l": 50.0
     },
     "out": 200.0,
     "tol": 1e-06
    },
    {
     "in": {
      "Q": 24000.0,
      "l": 35.0
     },
     "out": 685.714,
     "tol": 0.0001
    }
   ],
   "notes": "式(3-30)。3-6-03 規定最大日流量下表面積負荷率應為 35~70 m³/m²·day。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.294（頁碼 277）式(3-30)（另以 150 dpi 頁面影像目視核對）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "sewer105_primary_clarifier_volume",
   "src": "sewer105",
   "clause": "3-6-04",
   "page": 294,
   "title": "初級沉澱池容量 V=A·h=Q·t/24（式3-31）",
   "keywords": "污水下水道 初級沉澱池 容量 有效水深 沉澱時間",
   "unit": "m3",
   "output": "V",
   "latex": "V = A\\,h = Q\\,\\dfrac{t}{24}",
   "vars": {
    "Q": {
     "desc": "進流水量",
     "unit": "m3/day",
     "min": 0.001,
     "max": 1000000.0
    },
    "t": {
     "desc": "沉澱時間（一般約 1.5 小時）",
     "unit": "hr",
     "min": 0.1,
     "max": 24.0
    }
   },
   "expr": "Q * t / 24.0",
   "tests": [
    {
     "in": {
      "Q": 10000.0,
      "t": 1.5
     },
     "out": 625.0,
     "tol": 1e-06
    },
    {
     "in": {
      "Q": 24000.0,
      "t": 2.0
     },
     "out": 2000.0,
     "tol": 1e-06
    }
   ],
   "notes": "式(3-31)。亦等於 A×h；與式(3-32) t=24h/l 互相一致（h=Q t/(24A)=l t/24）。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.294（頁碼 277）式(3-31)（另以 150 dpi 頁面影像目視核對）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "sewer105_primary_clarifier_detention",
   "src": "sewer105",
   "clause": "3-6-04",
   "page": 294,
   "title": "初級沉澱池沉澱時間 t=(h/l)×24（式3-32）",
   "keywords": "污水下水道 初級沉澱池 沉澱時間 有效水深 表面積負荷",
   "unit": "hr",
   "output": "t",
   "latex": "t = \\dfrac{h}{l}\\times 24",
   "vars": {
    "h": {
     "desc": "有效水深（標準 2.5~4.0）",
     "unit": "m",
     "min": 0.5,
     "max": 10.0
    },
    "l": {
     "desc": "表面積負荷",
     "unit": "m3/m2/day",
     "min": 1.0,
     "max": 500.0
    }
   },
   "expr": "h / l * 24.0",
   "warn_if": [
    {
     "expr": "h < 2.5 or h > 4.0",
     "msg": "有效水深超出指針標準 2.5~4.0 m"
    },
    {
     "expr": "result > 3.0",
     "msg": "沉澱時間偏長，超過一定時間後去除率不再增加且易腐敗（一般約 1.5 小時）"
    }
   ],
   "tests": [
    {
     "in": {
      "h": 3.0,
      "l": 48.0
     },
     "out": 1.5,
     "tol": 1e-06
    },
    {
     "in": {
      "h": 2.5,
      "l": 35.0
     },
     "out": 1.714286,
     "tol": 1e-05
    }
   ],
   "notes": "式(3-32)。沉澱時間一般約 1.5 小時；超過一定時間後 SS 去除不再增加，反而因腐敗使水質惡化。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.294（頁碼 277）式(3-32)（另以 150 dpi 頁面影像目視核對）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "sewer105_primary_clarifier_length",
   "src": "sewer105",
   "clause": "3-6-04",
   "page": 294,
   "title": "初級沉澱池有效長 L=v·t（式3-33）",
   "keywords": "污水下水道 初級沉澱池 池長 平均流速 沉澱時間",
   "unit": "m",
   "output": "L",
   "latex": "L = v\\,t",
   "vars": {
    "v": {
     "desc": "平均流速（應在 18 m/hr＝30 cm/min 以下）",
     "unit": "m/hr",
     "min": 0.1,
     "max": 200.0
    },
    "t": {
     "desc": "沉澱時間",
     "unit": "hr",
     "min": 0.1,
     "max": 24.0
    }
   },
   "expr": "v * t",
   "warn_if": [
    {
     "expr": "v > 18.0",
     "msg": "平均流速超過 18 m/hr（30 cm/min），可能造成短流"
    }
   ],
   "tests": [
    {
     "in": {
      "v": 18.0,
      "t": 1.5
     },
     "out": 27.0,
     "tol": 1e-06
    },
    {
     "in": {
      "v": 12.0,
      "t": 2.0
     },
     "out": 24.0,
     "tol": 1e-06
    }
   ],
   "notes": "式(3-33)。以平均流速 v 為 30 cm/min（18 m/hr）以下求出 L；沉澱池總寬度以 A/L 求出，再對應適當數量刮泥機分配各池寬。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.294（頁碼 277）式(3-33)（另以 150 dpi 頁面影像目視核對）",
