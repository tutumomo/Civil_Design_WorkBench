     "desc": "直管直徑",
     "unit": "m",
     "min": 0.02,
     "max": 5.0
    },
    "v": {
     "desc": "流速",
     "unit": "m/s",
     "min": 0.0,
     "max": 20.0
    },
    "g": {
     "desc": "重力加速度",
     "unit": "m/s2",
     "min": 9.7,
