  {
   "id": "sewer105_friction_factor_newpipe",
   "src": "sewer105",
   "clause": "3-4-03",
   "page": 224,
   "title": "新管直管損失係數 f＝常數＋1/(係數×D)（表3-11 直管欄）",
   "keywords": "污水下水道 摩擦係數 鑄鐵管 鋼管 PVC 管 新管 舊管 1.5 倍",
   "unit": "-",
   "output": "f",
   "latex": "f = a + \\dfrac{1}{b\\,D}\\quad(\\text{鑄鐵 }a{=}0.02,b{=}2000;\\ \\text{鋼管 }a{=}0.03,b{=}1000;\\ \\text{PVC }a{=}0.018,b{=}2300)",
   "vars": {
    "a": {
     "desc": "常數項（鑄鐵管 0.02、鋼管 0.03、PVC 管 0.018）",
     "unit": "-",
     "min": 0.0,
     "max": 0.1
    },
    "b": {
     "desc": "管徑係數（鑄鐵管 2,000、鋼管 1,000、PVC 管 2,300）",
     "unit": "-",
     "min": 100,
     "max": 10000
    },
    "D": {
     "desc": "直管直徑",
     "unit": "m",
     "min": 0.02,
     "max": 5.0
    },
    "old_pipe": {
     "desc": "是否為舊管（1=舊管取新管 1.5 倍；0=新管）",
     "unit": "-",
     "min": 0,
     "max": 1,
     "default": 0
    }
   },
   "expr": "(a + 1.0 / (b * D)) * (1.0 + 0.5 * old_pipe)",
   "tests": [
    {
     "in": {
      "a": 0.02,
      "b": 2000.0,
      "D": 0.3,
      "old_pipe": 0
     },
     "out": 0.021667,
     "tol": 1e-05
    },
    {
     "in": {
      "a": 0.03,
      "b": 1000.0,
      "D": 0.2,
      "old_pipe": 1
     },
     "out": 0.0525,
     "tol": 1e-06
    }
   ],
