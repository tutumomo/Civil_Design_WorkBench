   "latex": "h_f = f\\cdot\\dfrac{L}{D}\\cdot\\dfrac{v^{2}}{2g}",
   "vars": {
    "f": {
     "desc": "直管損失係數（新管：鑄鐵管 0.02+1/(2000D)、鋼管 0.03+1/(1000D)、PVC 管 0.018+1/(2300D)；舊管取 1.5 倍）",
     "unit": "-",
     "min": 0.005,
     "max": 0.2
    },
    "L": {
     "desc": "直管長度",
     "unit": "m",
     "min": 0.1,
     "max": 5000.0
