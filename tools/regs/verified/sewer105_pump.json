{
 "formulas": [
  {
   "id": "sewer105_pump_suction_diameter",
   "src": "sewer105",
   "clause": "3-4-03",
   "page": 220,
   "title": "抽水機機殼吸水口口徑 d=146·√(Q/V)（式3-2）",
   "keywords": "污水下水道 抽水機 吸水口 口徑 吸水端流速 抽水量",
   "unit": "mm",
   "output": "d",
   "latex": "d = 146\\sqrt{\\dfrac{Q}{V}}",
   "vars": {
    "Q": {
     "desc": "抽水量",
     "unit": "m3/min",
     "min": 0.001,
     "max": 1000.0
    },
    "V": {
     "desc": "機殼吸水口流速（標準 1.5~3.0）",
     "unit": "m/s",
     "min": 0.1,
     "max": 10.0
    }
   },
   "expr": "146.0 * sqrt(Q / V)",
   "warn_if": [
    {
     "expr": "V < 1.5 or V > 3.0",
     "msg": "吸水口流速超出標準 1.5~3.0 m/s；靜吸水揚水或吸水側損失大者應取較小流速"
    }
   ],
   "tests": [
    {
     "in": {
      "Q": 5.0,
      "V": 2.0
     },
     "out": 230.85,
     "tol": 0.0001
    },
    {
     "in": {
      "Q": 12.0,
      "V": 3.0
     },
     "out": 292.0,
     "tol": 0.0001
    }
   ],
   "notes": "式(3-2)。常數 146 為 60·π/4 開根號後的取整值（精算 d=√(21220·Q/V)=145.7·√(Q/V) mm），以本式計算與理論值差約 0.2%。吸水口流速標準 1.5~3.0 m/s；污水抽水機須能通過直徑 75 mm 圓球狀固體，機殼吸水端與出水端開口直徑至少 100 mm。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.220（頁碼 203）式(3-2) 及式中說明",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "sewer105_pump_total_dynamic_head",
   "src": "sewer105",
   "clause": "3-4-03",
   "page": 221,
   "title": "抽水機總動水頭 Ht=Hstat+hent+hfs+Σhfvs+hfd+Σhfvd+vd²/2g（式3-3）",
   "keywords": "污水下水道 抽水機 總動水頭 TDH 靜水頭 損失水頭 速度水頭",
   "unit": "m",
   "output": "Ht",
   "latex": "H_t = H_{stat} + h_{ent} + h_{fs} + \\Sigma h_{fvs} + h_{fd} + \\Sigma h_{fvd} + \\dfrac{v_d^{2}}{2g}",
   "vars": {
    "Hstat": {
     "desc": "總靜水頭",
     "unit": "m",
     "min": -50.0,
     "max": 200.0
    },
    "hent": {
     "desc": "吸水口損失水頭",
     "unit": "m",
     "min": 0.0,
     "max": 50.0,
     "default": 0.0
    },
    "hfs": {
     "desc": "吸水管摩擦損失水頭",
     "unit": "m",
     "min": 0.0,
     "max": 50.0,
     "default": 0.0
    },
    "sum_hfvs": {
     "desc": "吸水管上管件及閥類損失水頭和",
     "unit": "m",
     "min": 0.0,
     "max": 50.0,
     "default": 0.0
    },
    "hfd": {
     "desc": "出水管摩擦損失水頭",
     "unit": "m",
     "min": 0.0,
     "max": 50.0,
     "default": 0.0
    },
    "sum_hfvd": {
     "desc": "出水管上管件及閥類損失水頭和",
     "unit": "m",
     "min": 0.0,
     "max": 50.0,
     "default": 0.0
    },
    "vd": {
     "desc": "出水管流速（末端速度水頭 vd²/2g）",
     "unit": "m/s",
     "min": 0.0,
     "max": 10.0,
     "default": 0.0
    },
    "g": {
     "desc": "重力加速度",
     "unit": "m/s2",
     "min": 9.7,
     "max": 9.9,
     "default": 9.8
    }
   },
   "expr": "Hstat + hent + hfs + sum_hfvs + hfd + sum_hfvd + vd ** 2 / (2.0 * g)",
   "tests": [
    {
     "in": {
      "Hstat": 10.0,
      "hent": 0.15,
      "hfs": 0.5,
      "sum_hfvs": 0.3,
      "hfd": 0.8,
      "sum_hfvd": 0.4,
      "vd": 1.5,
      "g": 9.8
     },
     "out": 12.2648,
     "tol": 1e-05
    },
    {
     "in": {
      "Hstat": 6.5,
      "hent": 0.2,
      "hfs": 0.3,
      "sum_hfvs": 0.1,
      "hfd": 0.6,
      "sum_hfvd": 0.25,
      "vd": 2.0,
      "g": 9.8
     },
     "out": 8.15408,
     "tol": 1e-05
    }
   ],
   "notes": "式(3-3)。靜吸水水頭為正、靜吸水揚水（水位在葉輪基準線下方）為負。若出水管最頂部在末端，另可用式(3-11) Ht=Hstat+Σhf+vd²/2g；最頂部在中途者，取式(3-12)、(3-13) 之較大值。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.221（頁碼 204）式(3-3) 及式中說明",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "sewer105_headloss_coefficient",
   "src": "sewer105",
   "clause": "3-4-03",
   "page": 223,
   "title": "管件與閥類損失水頭 h=f·v²/(2g)（式3-4）",
