   "unit": "%",
   "output": "D",
   "latex": "D = \\left(1 - \\dfrac{FS_1\\,VS_2}{VS_1\\,FS_2}\\right)\\times 100",
   "vars": {
    "FS1": {
     "desc": "進流污泥無機成分",
     "unit": "%",
     "min": 5.0,
     "max": 70.0
    },
    "VS1": {
     "desc": "進流污泥有機成分",
     "unit": "%",
     "min": 30.0,
     "max": 95.0
    },
    "FS2": {
     "desc": "出流污泥無機成分",
     "unit": "%",
     "min": 5.0,
     "max": 70.0
    },
