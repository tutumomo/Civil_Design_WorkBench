{
 "formulas": [
  {
   "id": "sewer105_ss_sludge_mass",
   "src": "sewer105",
   "clause": "7-1-02",
   "page": 380,
   "title": "初級沉澱池懸浮物污泥量 Pss=Q(SSo−SSe)×10⁻³=Q·SSo·Ess×10⁻³（式7-1）",
   "keywords": "污水下水道 污泥量 懸浮物 初級沉澱池 SS去除率 剩餘污泥 乾重",
   "unit": "kg/d",
   "output": "Pss",
   "latex": "P_{ss} = Q\\left(SS_o - SS_e\\right)\\times 10^{-3} = Q\\,SS_o\\,E_{ss}\\times 10^{-3}",
   "vars": {
    "Q": {
     "desc": "處理量",
     "unit": "m3/d",
     "min": 1.0,
     "max": 1000000.0
    },
    "SSo": {
     "desc": "進流懸浮固體濃度",
     "unit": "mg/L",
     "min": 1.0,
     "max": 5000.0
    },
    "SSe": {
     "desc": "自沉澱池出流懸浮固體濃度",
     "unit": "mg/L",
     "min": 0.0,
     "max": 5000.0,
     "default": 0.0
    }
   },
   "expr": "Q * (SSo - SSe) / 1000.0",
   "tests": [
    {
     "in": {
      "Q": 10000.0,
      "SSo": 200.0,
      "SSe": 100.0
     },
     "out": 1000.0,
     "tol": 1e-06
    },
    {
     "in": {
      "Q": 5000.0,
      "SSo": 180.0,
      "SSe": 54.0
     },
     "out": 630.0,
     "tol": 1e-06
    }
   ],
   "notes": "式(7-1)。等價寫法 Pss=Q·SSo·Ess×10⁻³（Ess 為懸浮物去除率，以小數代入）。Q(m³/d)×SS(mg/L)=g/d，除以 1000 得 kg/d。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.380（頁碼 363）式(7-1) 及式中說明（另以 150 dpi 頁面影像目視核對）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "sewer105_bod_sludge_theoretical",
   "src": "sewer105",
   "clause": "7-1-02",
   "page": 380,
   "title": "生物增殖剩餘污泥量（理論式）PBOD=Q·Y(So−Se)/(1+Kd·θc)×10⁻³（式7-2）",
   "keywords": "污水下水道 污泥量 剩餘污泥 生物增殖 產率係數 衰減係數 SRT 理論式",
   "unit": "kg/d",
   "output": "PBOD",
   "latex": "P_{BOD} = \\dfrac{Q\\,Y\\left(S_o - S_e\\right)}{1 + K_d\\,\\theta_c}\\times 10^{-3}",
   "vars": {
    "Q": {
     "desc": "處理量",
     "unit": "m3/d",
     "min": 1.0,
     "max": 1000000.0
    },
    "Y": {
     "desc": "污泥產率係數（合成產率）",
     "unit": "kg SS/kg BOD",
     "min": 0.3,
     "max": 1.2,
     "default": 0.6
    },
    "So": {
     "desc": "進流 BOD 濃度",
     "unit": "mg/L",
     "min": 1.0,
     "max": 3000.0
    },
    "Se": {
     "desc": "出流 BOD 濃度",
     "unit": "mg/L",
     "min": 0.0,
     "max": 1000.0,
     "default": 0.0
    },
    "Kd": {
     "desc": "內呼吸（衰減）係數",
     "unit": "1/day",
     "min": 0.01,
     "max": 0.2,
     "default": 0.06
    },
    "thetac": {
     "desc": "污泥停留時間 SRT",
     "unit": "day",
     "min": 1.0,
     "max": 100.0,
     "default": 10.0
    }
   },
   "expr": "Q * Y * (So - Se) / (1.0 + Kd * thetac) / 1000.0",
   "tests": [
    {
     "in": {
      "Q": 10000.0,
      "Y": 0.6,
      "So": 200.0,
      "Se": 10.0,
      "Kd": 0.06,
      "thetac": 10.0
     },
     "out": 712.5,
     "tol": 1e-06
    },
    {
     "in": {
      "Q": 5000.0,
      "Y": 0.5,
      "So": 180.0,
      "Se": 20.0,
      "Kd": 0.05,
      "thetac": 15.0
     },
     "out": 228.57142857,
     "tol": 1e-06
    }
   ],
   "notes": "式(7-2)（理論式，請參見 §4-3-01 計算）。第二筆：5000×0.5×160/(1+0.75)/1000=228.571 kg/d。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.380（頁碼 363）式(7-2) 及式中說明（另以 150 dpi 頁面影像目視核對）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "sewer105_bod_sludge_empirical",
   "src": "sewer105",
   "clause": "7-1-02",
   "page": 380,
   "title": "生物增殖剩餘污泥量（經驗式）PBOD=a·Lr−b·X·V×10⁻³（式7-3）",
   "keywords": "污水下水道 污泥量 剩餘污泥 經驗式 BOD 污泥轉換率 自行氧化率 MLSS 曝氣槽容積",
   "unit": "kg/d",
   "output": "PBOD",
   "latex": "P_{BOD} = a\\,L_r - b\\,X\\,V\\times 10^{-3}",
   "vars": {
    "a": {
     "desc": "BOD 之污泥轉換率",
     "unit": "-",
     "min": 0.3,
     "max": 1.0,
     "default": 0.6
    },
    "Lr": {
     "desc": "BOD 去除量（式7-4）",
     "unit": "kg/d",
     "min": 1.0,
     "max": 1000000.0
    },
    "b": {
     "desc": "污泥體內自行氧化率",
     "unit": "1/day",
     "min": 0.01,
     "max": 0.1,
     "default": 0.05
    },
    "X": {
     "desc": "曝氣槽內混合液 MLSS 濃度",
     "unit": "mg/L",
     "min": 100.0,
     "max": 20000.0
    },
    "V": {
     "desc": "曝氣槽容積",
     "unit": "m3",
     "min": 1.0,
     "max": 100000.0
    }
   },
   "expr": "a * Lr - b * X * V / 1000.0",
   "warn_if": [
    {
     "expr": "result < 0",
     "msg": "計算結果為負：自行氧化量已超過增殖量，實務上取 0（SRT 極長之延長曝氣法可能出現）"
    }
   ],
   "tests": [
    {
     "in": {
      "a": 0.6,
      "Lr": 1140.0,
      "b": 0.05,
      "X": 3000.0,
      "V": 2000.0
     },
     "out": 384.0,
     "tol": 1e-06
    },
    {
     "in": {
      "a": 0.7,
      "Lr": 900.0,
      "b": 0.03,
      "X": 2500.0,
      "V": 1000.0
     },
     "out": 555.0,
     "tol": 1e-06
    }
   ],
   "notes": "式(7-3)（經驗式）。a=0.5~0.8、b=0.01~0.1 day⁻¹。第二筆：0.7×900 − 0.03×2500×1000×10⁻³ = 630 − 75 = 555 kg/d。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 PDF p.380（頁碼 363）式(7-3) 及式中說明（另以 150 dpi 頁面影像目視核對）",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
