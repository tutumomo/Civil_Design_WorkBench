   "unit": "ton/day",
   "output": "P",
   "latex": "P = Q\\times SS_o\\times 10^{-6}\\times E\\times m",
   "vars": {
    "Q": {
     "desc": "處理量",
     "unit": "m3/d",
     "min": 1.0,
     "max": 1000000.0
    },
    "SSo": {
     "desc": "進流懸浮固體濃度",
     "unit": "mg/L",
     "min": 1.0,
     "max": 5000.0
