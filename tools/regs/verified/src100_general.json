{
 "formulas": [
  {
   "id": "src100_design_strength_check",
   "src": "src100",
   "clause": "1.2.3",
   "page": 2,
   "title": "設計強度檢核 φRn ≥ Σγi Qi（鋼骨鋼筋混凝土構造設計規範 1.2.3 (1.2-1)）",
   "keywords": "SRC 鋼骨鋼筋混凝土 設計強度 需要強度 載重放大係數 強度折減係數 1.2-1",
   "unit": "無因次",
   "output": "ratio",
   "latex": "\\phi R_n \\ge \\sum \\gamma_i Q_i",
   "vars": {
    "phi_Rn": {
     "desc": "設計強度 φRn",
     "unit": "tf、tf·m 或 tf（依檢核項目）",
     "min": 0
    },
    "demand": {
     "desc": "設計載重效應 Σγi Qi（需要強度）",
     "unit": "同上",
     "min": 0
    }
   },
   "expr": "phi_Rn / demand",
   "conditions": [
    {
     "expr": "demand > 0",
     "msg": "需要強度須為正"
    }
   ],
   "warn_if": [
    {
     "expr": "result < 1.0",
     "msg": "設計強度小於需要強度，不符 (1.2-1) 式"
    }
   ],
   "tests": [
    {
     "in": {
      "phi_Rn": 100.0,
      "demand": 80.0
     },
     "out": 1.25
    },
    {
     "in": {
      "phi_Rn": 90.0,
      "demand": 100.0
     },
     "out": 0.9
    }
   ],
   "notes": "(1.2-1) 式為本規範極限強度設計法之總則；φ 與 γ 依各章規定。輸出為 φRn/ΣγiQi 之比值，<1.0 即不合格。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 src100 PDF 第2頁",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "src100_load_combo",
   "src": "src100",
   "clause": "2.5",
   "page": 2,
   "title": "因數化載重組合（鋼骨鋼筋混凝土構造設計規範 2.5 (2.5-1)~(2.5-7)）",
   "keywords": "SRC 鋼骨鋼筋混凝土 載重組合 因數化載重 靜載重 活載重 風力 地震力 2.5",
   "unit": "tf（與輸入同單位）",
   "output": "factored_load",
   "latex": "(2.5\\text{-}1)\\ 1.4(D+F);\\ (2.5\\text{-}2)\\ 1.2(D+F+T)+1.6(L+H)+0.5(L_r\\ \\text{或}\\ S\\ \\text{或}\\ R);\\ \\ldots",
   "vars": {
    "D": {
     "desc": "靜載重 D",
     "unit": "tf 或 tf·m",
     "min": 0
    },
    "L": {
     "desc": "活載重 L",
     "unit": "同上",
     "min": 0
    },
    "F": {
     "desc": "液體力 F",
     "unit": "同上",
     "min": 0,
     "default": 0
    },
    "T": {
     "desc": "溫度、潛變、乾縮與不均勻沉陷等效應 T",
     "unit": "同上",
     "min": 0,
     "default": 0
    },
    "H": {
     "desc": "土壤力 H",
     "unit": "同上",
     "min": 0,
     "default": 0
    },
    "Lr": {
     "desc": "屋頂活載重 Lr",
     "unit": "同上",
     "min": 0,
     "default": 0
    },
    "S": {
     "desc": "雪載重 S",
     "unit": "同上",
     "min": 0,
     "default": 0
    },
    "R": {
     "desc": "雨載重 R",
     "unit": "同上",
     "min": 0,
     "default": 0
    },
    "Wf": {
     "desc": "風力 W",
     "unit": "同上",
     "min": 0,
     "default": 0
    },
    "E": {
     "desc": "地震力 E（αy 取 1.0）",
     "unit": "同上",
     "min": 0,
     "default": 0
    },
    "combo": {
     "desc": "載重組合編號 1~7（對應 (2.5-1)~(2.5-7)）",
     "unit": "型態",
     "min": 1,
     "max": 7,
     "default": 2
    },
    "L_reduced": {
     "desc": "1＝適用 L 載重係數 0.5 之例外（用途非車庫、公眾集會場所且活載重 ≤0.5 tf/m²）",
     "unit": "型態",
     "min": 0,
     "max": 1,
     "default": 0
    }
   },
   "defs": [
    [
     "Lsr",
     "max(max(Lr, S), R)"
    ],
    [
     "Lc",
     "0.5 if L_reduced > 0.5 else 1.0"
    ]
   ],
   "expr": "(1.4 * (D + F)) if combo < 1.5 else ((1.2 * (D + F + T) + 1.6 * (L + H) + 0.5 * Lsr) if combo < 2.5 else ((1.2 * D + 1.6 * Lsr + max(Lc * L, 0.8 * Wf)) if combo < 3.5 else ((1.2 * D + Lc * L + 1.6 * Wf + 0.5 * Lsr) if combo < 4.5 else ((1.2 * D + E + Lc * L + 0.2 * S) if combo < 5.5 else ((0.9 * D + 1.6 * Wf + 1.6 * H) if combo < 6.5 else (0.9 * D + E + 1.6 * H))))))",
   "conditions": [
    {
     "expr": "1 <= combo <= 7",
     "msg": "載重組合編號僅 1~7"
    }
   ],
   "tests": [
