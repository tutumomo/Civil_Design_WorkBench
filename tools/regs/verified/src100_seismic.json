{
 "formulas": [
  {
   "id": "src100_joint_flexural_ratio",
   "src": "src100",
   "clause": "8.4.2",
   "page": 79,
   "title": "SRC 梁柱接合處之撓曲強度比（鋼骨鋼筋混凝土構造設計規範 8.4.2 (8.4-1)~(8.4-4)）",
   "keywords": "SRC 鋼骨鋼筋混凝土 梁柱接頭 撓曲強度比 強柱弱梁 0.6 0.7 1.0 8.4-1 8.4-4",
   "unit": "無因次",
   "output": "ratio",
   "latex": "\\frac{\\sum(M_{ns})_C}{\\sum(M_{ns})_B}\\ge0.6,\\ \\frac{\\sum(M_{nrc})_C}{\\sum(M_{nrc})_B}\\ge0.6;\\qquad \\frac{\\sum(M_{ns})_C}{\\sum(M_{ns})_B}\\ge1.0\\ (\\text{鋼梁}),\\ \\ge0.7\\ (\\text{應力平順傳遞})",
   "vars": {
    "sum_Mc": {
     "desc": "接合處所有柱之標稱彎矩強度總和 ΣMnC（鋼骨或 RC 部分）",
     "unit": "kgf·cm",
     "min": 0
    },
    "sum_Mb": {
     "desc": "接合處所有梁之標稱彎矩強度總和 ΣMnB（鋼骨或 RC 部分）",
     "unit": "kgf·cm",
     "min": 0.0001
    },
    "steel_beam": {
     "desc": "1＝鋼梁與 SRC 柱接合；0＝SRC 梁與 SRC 柱接合",
     "unit": "型態",
     "min": 0,
     "max": 1,
     "default": 0
    },
    "smooth": {
     "desc": "1＝經分析證明鋼梁應力可平順傳遞至 SRC 柱（(8.4-4) 式下限 0.7）",
     "unit": "型態",
     "min": 0,
     "max": 1,
     "default": 0
    }
   },
   "defs": [
    [
     "limit",
     "((1.0 if smooth < 0.5 else 0.7) if steel_beam > 0.5 else 0.6)"
    ]
   ],
   "expr": "sum_Mc / sum_Mb",
   "conditions": [
    {
     "expr": "sum_Mb > 0",
     "msg": "ΣMnB 須為正"
    }
   ],
   "warn_if": [
    {
     "expr": "result < 0.6",
     "msg": "撓曲強度比小於 0.6，不符 (8.4-1)(8.4-2)"
    },
    {
     "expr": "steel_beam > 0.5 and result < 1.0 and smooth < 0.5",
     "msg": "鋼梁接合處之撓曲強度比小於 1.0，不符 (8.4-3)"
    },
    {
     "expr": "steel_beam > 0.5 and smooth > 0.5 and result < 0.7",
     "msg": "採 (8.4-4) 放寬時仍不得小於 0.7"
    }
   ],
   "tests": [
    {
     "in": {
      "sum_Mc": 120.0,
      "sum_Mb": 100.0,
      "steel_beam": 0,
      "smooth": 0
     },
     "out": 1.2
    },
    {
     "in": {
      "sum_Mc": 60.0,
      "sum_Mb": 100.0,
      "steel_beam": 1,
      "smooth": 1
     },
     "out": 0.6
    }
   ],
   "notes": "(8.4-1)(8.4-2)：SRC 梁與 SRC 柱接合時，鋼骨部分與 RC 部分之撓曲強度比均不得小於 0.6。(8.4-3)：鋼梁與 SRC 柱接合時鋼骨部分不得小於 1.0；(8.4-4)：經分析證明可平順傳遞者可放寬為 0.7。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 src100 PDF 第79頁",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "src100_column_axial_seismic",
   "src": "src100",
   "clause": "9.3",
   "page": 96,
   "title": "SRC 柱之耐震軸向強度檢核（鋼骨鋼筋混凝土構造設計規範 9.3 (9.3-1)(9.3-2)）",
   "keywords": "SRC 鋼骨鋼筋混凝土 柱 軸向強度 耐震 地震力折減係數 Fu 1.4Fu 9.3-1 9.3-2",
   "unit": "kgf（與輸入同單位）",
   "output": "P_demand",
   "latex": "1.2P_D+0.5P_L\\pm1.4F_uP_E\\le\\phi_cP_n;\\qquad 0.9P_D\\pm1.4F_uP_E\\le\\phi_tP_n",
   "vars": {
    "PD": {
     "desc": "靜載重造成之軸力 PD",
     "unit": "kgf",
     "min": 0
    },
    "PL": {
     "desc": "活載重造成之軸力 PL",
     "unit": "kgf",
     "min": 0,
     "default": 0
    },
    "PE": {
     "desc": "地震力造成之軸力 PE",
     "unit": "kgf",
     "min": 0
    },
    "Fu": {
     "desc": "地震力折減係數 Fu（不必超過 2.5）",
     "unit": "無因次",
     "min": 0,
     "default": 1.0
    },
    "mode": {
     "desc": "0＝受軸壓力（(9.3-1)）；1＝受軸拉力（(9.3-2)）",
     "unit": "型態",
     "min": 0,
     "max": 1,
     "default": 0
    },
    "L_full": {
     "desc": "1＝停車場、公眾集會場所或活載重 >0.5 tf/m²，PL 係數取 1.0",
     "unit": "型態",
     "min": 0,
     "max": 1,
     "default": 0
    }
   },
   "defs": [
    [
     "cL",
     "1.0 if L_full > 0.5 else 0.5"
    ]
   ],
   "expr": "1.2 * PD + cL * PL + 1.4 * Fu * PE if mode < 0.5 else 0.9 * PD + 1.4 * Fu * PE",
   "conditions": [
    {
     "expr": "Fu <= 2.5",
     "msg": "Fu 不必超過 2.5"
    }
   ],
   "warn_if": [
    {
     "expr": "Fu > 2.5",
     "msg": "Fu 超過 2.5，已超出本條適用範圍"
    }
   ],
   "tests": [
    {
     "in": {
      "PD": 100000.0,
      "PL": 50000.0,
      "PE": 40000.0,
      "Fu": 1.0,
      "mode": 0,
      "L_full": 0
     },
     "out": 201000.0
    },
    {
     "in": {
      "PD": 100000.0,
      "PL": 50000.0,
      "PE": 40000.0,
      "Fu": 2.0,
      "mode": 1,
      "L_full": 1
     },
     "out": 202000.0
    }
   ],
   "notes": "(9.3-1) 受軸壓力、(9.3-2) 受軸拉力；地震力項採 ±1.4(Fu)PE。Fu 不必超過 2.5。停車場、公眾集會場所或活載重 >0.5 tf/m² 者 (9.3-1) 式中 PL 係數取 1.0。上列組合不必超過相接構材或接頭區極限狀態下傳至柱之軸力的 1.25 倍；Pu/φPn ≤ 0.5 且符合相關規定者得免檢核。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 src100 PDF 第96頁",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "src100_beam_shear_seismic",
   "src": "src100",
   "clause": "9.5.2",
   "page": 98,
   "title": "SRC 梁耐震設計之需求剪力分配（鋼骨鋼筋混凝土構造設計規範 9.5.2 (9.5-1)~(9.5-4)）",
   "keywords": "SRC 鋼骨鋼筋混凝土 梁 耐震 需求剪力 Mpr 可能彎矩強度 1.25Fyr 9.5-1 9.5-4",
   "unit": "kgf（與輸入同單位）",
   "output": "V_required",
   "latex": "V_u=\\frac{M_{pr1}+M_{pr2}}{L_n}\\pm\\frac{W}{2};\\quad M_{pr}=M_{ns}+M_{prc};\\quad \\phi_{vs}V_{ns}\\ge\\frac{M_{ns}}{M_{pr}}V_u",
   "vars": {
    "Mpr1": {
     "desc": "梁一端交接面之可能彎矩強度 Mpr1（(9.5-3) 式）",
     "unit": "kgf·cm",
     "min": 0
    },
    "Mpr2": {
     "desc": "梁另一端交接面之可能彎矩強度 Mpr2",
     "unit": "kgf·cm",
     "min": 0
    },
    "Ln": {
     "desc": "梁淨跨距 Ln",
     "unit": "cm",
     "min": 0.0001
    },
    "Wv": {
     "desc": "作用於梁上之總垂直載重 W",
     "unit": "kgf",
     "min": 0,
     "default": 0
    },
    "Mns": {
     "desc": "鋼骨部分標稱彎矩強度 Mns",
     "unit": "kgf·cm",
     "min": 0
    },
    "Mprc": {
     "desc": "RC 部分可能彎矩強度 Mprc（拉力鋼筋以 1.25Fyr 計算）",
     "unit": "kgf·cm",
     "min": 0
    },
    "part": {
     "desc": "0＝鋼骨部分（φvs=0.9）；1＝RC 部分（φvrc=0.75）",
     "unit": "型態",
     "min": 0,
     "max": 1,
     "default": 0
    }
   },
   "defs": [
    [
     "Mpr",
     "Mns + Mprc"
    ],
    [
     "Vu",
     "(Mpr1 + Mpr2) / Ln + Wv / 2.0"
    ]
   ],
   "expr": "Vu * Mns / Mpr if part < 0.5 else Vu * Mprc / Mpr",
   "conditions": [
    {
     "expr": "Ln > 0 and Mns + Mprc > 0",
     "msg": "Ln 與 Mpr 須為正"
    }
   ],
   "tests": [
    {
     "in": {
      "Mpr1": 8000000.0,
      "Mpr2": 6000000.0,
      "Ln": 600.0,
      "Wv": 20000.0,
      "Mns": 5000000.0,
      "Mprc": 3000000.0,
      "part": 0
     },
     "out": 20833.333333333332
    },
    {
     "in": {
      "Mpr1": 8000000.0,
      "Mpr2": 6000000.0,
      "Ln": 600.0,
      "Wv": 20000.0,
      "Mns": 5000000.0,
      "Mprc": 3000000.0,
      "part": 1
     },
     "out": 12499.999999999998
    }
   ],
   "notes": "(9.5-4) 需求剪力 Vu 採梁兩端產生塑鉸後之剪力（非結構分析之係數化剪力）；(9.5-3) Mpr = Mns + Mprc，其中 Mprc 計算時拉力鋼筋降伏應力以 1.25Fyr 取代。需求剪力再依 (9.5-1)(9.5-2) 按 Mns/Mpr、Mprc/Mpr 分配至鋼骨與 RC 部分。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 src100 PDF 第98頁",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "src100_strong_column",
   "src": "src100",
   "clause": "9.6.1",
   "page": 101,
   "title": "SRC 梁柱接頭之強柱弱梁檢核（鋼骨鋼筋混凝土構造設計規範 9.6.1 (9.6-1)）",
   "keywords": "SRC 鋼骨鋼筋混凝土 強柱弱梁 梁柱接頭 ΣMc ΣMB 1.2 9.6-1",
   "unit": "無因次",
   "output": "ratio",
   "latex": "\\frac{\\sum M_C}{\\sum M_B}\\ge1.2",
   "vars": {
    "sum_MC": {
     "desc": "接頭處各柱在交接面之標稱彎矩強度總和 ΣMC（取各載重組合軸力下之最小彎矩強度）",
     "unit": "kgf·cm",
     "min": 0
    },
    "sum_MB": {
     "desc": "接頭處各梁在交接面之標稱彎矩強度總和 ΣMB",
     "unit": "kgf·cm",
     "min": 0.0001
    }
   },
   "expr": "sum_MC / sum_MB",
   "conditions": [
    {
     "expr": "sum_MB > 0",
     "msg": "ΣMB 須為正"
    }
   ],
   "warn_if": [
    {
     "expr": "result < 1.2",
     "msg": "強柱弱梁比值小於 1.2，該柱對強度與勁度之貢獻應不予計入"
    }
   ],
   "tests": [
    {
     "in": {
      "sum_MC": 180.0,
      "sum_MB": 100.0
     },
     "out": 1.8
    }
   ],
   "notes": "(9.6-1) 式：ΣMC/ΣMB ≥ 1.2，兩方向梁通過時應分別檢討；梁彎矩和之方向須與柱彎矩和相反，且順、逆鐘方向彎矩均須計入。另本節第1款要求接合處撓曲強度符合 8.4.2 節。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 src100 PDF 第101頁",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "src100_column_shear_seismic",
   "src": "src100",
   "clause": "9.6.2",
   "page": 102,
   "title": "SRC 柱耐震設計之需求剪力分配（鋼骨鋼筋混凝土構造設計規範 9.6.2 (9.6-3)~(9.6-5)）",
   "keywords": "SRC 鋼骨鋼筋混凝土 柱 耐震 需求剪力 Mct Mcb hn 9.6-3 9.6-5",
   "unit": "kgf（與輸入同單位）",
   "output": "V_required",
   "latex": "V_u=\\frac{M_{ct}+M_{cb}}{h_n};\\qquad \\phi_{vs}V_{ns}\\ge\\frac{M_{ns}}{M_{pr}}V_u,\\quad \\phi_{vrc}V_{nrc}\\ge\\frac{M_{prc}}{M_{pr}}V_u",
   "vars": {
    "Mct": {
     "desc": "柱上方接合處兩側梁產生塑鉸時柱端交接面之彎矩強度 Mct",
     "unit": "kgf·cm",
     "min": 0
    },
    "Mcb": {
     "desc": "柱下方接合處對應之彎矩強度 Mcb",
     "unit": "kgf·cm",
     "min": 0
    },
    "hn": {
     "desc": "柱淨高 hn",
     "unit": "cm",
     "min": 0.0001
    },
    "Mns": {
     "desc": "鋼骨部分標稱彎矩強度 Mns",
     "unit": "kgf·cm",
     "min": 0
    },
    "Mprc": {
     "desc": "RC 部分可能彎矩強度 Mprc（拉力鋼筋以 1.25Fyr 計算）",
     "unit": "kgf·cm",
     "min": 0
    },
    "part": {
     "desc": "0＝鋼骨部分；1＝RC 部分",
     "unit": "型態",
     "min": 0,
     "max": 1,
     "default": 0
    }
   },
   "defs": [
    [
     "Mpr",
     "Mns + Mprc"
    ],
    [
     "Vu",
     "(Mct + Mcb) / hn"
    ]
   ],
   "expr": "Vu * Mns / Mpr if part < 0.5 else Vu * Mprc / Mpr",
   "conditions": [
    {
     "expr": "hn > 0 and Mns + Mprc > 0",
     "msg": "hn 與 Mpr 須為正"
    }
   ],
   "tests": [
    {
     "in": {
      "Mct": 6000000.0,
      "Mcb": 5000000.0,
      "hn": 300.0,
      "Mns": 4000000.0,
      "Mprc": 3000000.0,
      "part": 0
     },
     "out": 20952.38095238095
    },
    {
     "in": {
      "Mct": 6000000.0,
      "Mcb": 5000000.0,
      "hn": 300.0,
      "Mns": 4000000.0,
      "Mprc": 3000000.0,
      "part": 1
     },
     "out": 15714.285714285714
    }
   ],
   "notes": "(9.6-5) 柱需求剪力 Vu = (Mct + Mcb)/hn，即梁端塑鉸時柱上下端彎矩所對應之剪力；Mpr 依 (9.5-3) 式。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 src100 PDF 第102頁",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "src100_column_Ash",
   "src": "src100",
   "clause": "9.6.3",
   "page": 104,
   "title": "SRC 柱圍束箍筋需求量 Ash（鋼骨鋼筋混凝土構造設計規範 9.6.3 (9.6-6)(9.6-7)）",
   "keywords": "SRC 鋼骨鋼筋混凝土 柱 圍束箍筋 Ash 折減係數 Ps Phcc 高度圍束區 9.6-6 9.6-7",
   "unit": "cm2",
   "output": "Ash",
   "latex": "A_{sh}=0.3sb_c\\frac{f_c'}{F_{yh}}\\Big(\\frac{A_g}{A_{ch}}-1\\Big)\\Big[1-\\frac{P_s+P_{hcc}}{(P_n)_u}\\Big];\\qquad A_{sh}=0.09sb_c\\frac{f_c'}{F_{yh}}\\Big[1-\\frac{P_s+P_{hcc}}{(P_n)_u}\\Big]",
   "vars": {
    "s": {
     "desc": "箍筋間距 s",
     "unit": "cm",
     "min": 0.0001
    },
    "bc": {
     "desc": "箍筋圍束之柱核心寬度 bc",
     "unit": "cm",
     "min": 0.0001
    },
    "fc": {
     "desc": "混凝土規定抗壓強度 f'c",
     "unit": "kgf/cm2",
     "min": 0
    },
    "Fyh": {
     "desc": "箍筋之規定降伏應力 Fyh",
     "unit": "kgf/cm2",
     "min": 0.0001
    },
    "Ag": {
     "desc": "柱之全斷面積 Ag",
     "unit": "cm2",
     "min": 0
    },
    "Ach": {
     "desc": "箍筋圍束之柱核心斷面積 Ach",
     "unit": "cm2",
     "min": 0.0001
    },
    "Ps": {
     "desc": "鋼骨部分軸壓強度 Ps = AsFys（(9.6-8) 式）",
     "unit": "kgf",
     "min": 0,
     "default": 0
    },
    "Phcc": {
     "desc": "高度圍束區混凝土額外提昇之軸壓強度 Phcc = 0.2f'c·Ahcc（(9.6-9) 式）",
     "unit": "kgf",
     "min": 0,
     "default": 0
    },
    "Pn_u": {
     "desc": "(Pn)u = AsFys + 0.85f'cAc + FyrAr（(9.6-10) 式）",
     "unit": "kgf",
     "min": 0.0001
    }
   },
   "defs": [
    [
     "red",
     "1.0 - (Ps + Phcc) / Pn_u"
    ]
   ],
   "expr": "max(0.3 * s * bc * (fc / Fyh) * (Ag / Ach - 1.0) * red, 0.09 * s * bc * (fc / Fyh) * red)",
   "conditions": [
    {
     "expr": "Fyh > 0 and Ach > 0 and Pn_u > 0",
     "msg": "Fyh、Ach、(Pn)u 須為正"
    }
   ],
   "warn_if": [
    {
     "expr": "Ag < Ach",
     "msg": "Ag 應大於 Ach"
    }
   ],
   "tests": [
    {
     "in": {
      "s": 10.0,
      "bc": 40.0,
      "fc": 280.0,
      "Fyh": 4200.0,
      "Ag": 2400.0,
      "Ach": 1900.0,
      "Ps": 240000.0,
      "Phcc": 100000.0,
      "Pn_u": 600000.0
     },
     "out": 1.04
    }
   ],
   "notes": "(9.6-6)(9.6-7) 兩式取大值，且 Ash 不得小於剪力鋼筋需求量。折減係數 [1−(Ps+Phcc)/(Pn)u] 反映鋼骨分擔軸力與翼板圍束之貢獻。Ahcc 為鋼骨翼板所圍束之混凝土面積，H 型或 T 型鋼骨對弱軸彎曲時取 0，且 Ahcc ≤ 2500 cm²。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 src100 PDF 第104頁",
    "by": "agent",
    "date": "2026-11-14"
   }
  },
  {
   "id": "src100_column_confinement_forces",
   "src": "src100",
   "clause": "9.6.3",
   "page": 104,
   "title": "SRC 柱圍束箍筋公式之軸壓強度項（鋼骨鋼筋混凝土構造設計規範 9.6.3 (9.6-8)~(9.6-10)）",
   "keywords": "SRC 鋼骨鋼筋混凝土 柱 圍束箍筋 Ps Phcc Pn_u Ahcc 9.6-8 9.6-9 9.6-10",
   "unit": "kgf（與輸入同單位）",
   "output": "Pn_u",
   "latex": "P_s=A_sF_{ys};\\quad P_{hcc}=0.2f_c'A_{hcc};\\quad (P_n)_u=A_sF_{ys}+0.85f_c'A_c+F_{yr}A_r",
   "vars": {
    "As": {
     "desc": "鋼骨部分之斷面積 As",
     "unit": "cm2",
     "min": 0
    },
    "Fys": {
     "desc": "鋼骨之規定降伏應力 Fys",
     "unit": "kgf/cm2",
     "min": 0
    },
    "fc": {
     "desc": "混凝土規定抗壓強度 f'c",
     "unit": "kgf/cm2",
     "min": 0
    },
    "Ac": {
     "desc": "混凝土部分之斷面積 Ac",
     "unit": "cm2",
     "min": 0
    },
    "Fyr": {
     "desc": "主筋之規定降伏應力 Fyr",
     "unit": "kgf/cm2",
     "min": 0,
     "default": 0
    },
    "Ar": {
     "desc": "主筋部分之斷面積 Ar",
     "unit": "cm2",
     "min": 0,
     "default": 0
    },
    "Ahcc": {
     "desc": "高度圍束區混凝土之斷面積 Ahcc（≤2500 cm²，弱軸彎曲之 H/T 型鋼骨取 0）",
     "unit": "cm2",
     "min": 0,
     "max": 2500,
     "default": 0
    }
   },
   "defs": [
