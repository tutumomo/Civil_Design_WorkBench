     "expr": "Ahcc > 2500",
     "msg": "Ahcc 超過 2500 cm² 上限，應予折減"
    }
   ],
   "tests": [
    {
     "in": {
      "As": 100.0,
      "Fys": 2400.0,
      "fc": 280.0,
      "Ac": 2000.0,
      "Fyr": 4200.0,
      "Ar": 40.0,
      "Ahcc": 500.0
     },
     "out": 884000.0
    }
   ],
   "notes": "(9.6-8) Ps = AsFys；(9.6-9) Phcc = 0.2f'c·Ahcc；(9.6-10) (Pn)u = AsFys + 0.85f'cAc + FyrAr。輸出為 (Pn)u，Ps 與 Phcc 以 defs 計算後供 src100_column_Ash 使用。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 src100 PDF 第104頁",
