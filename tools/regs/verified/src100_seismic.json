  {
   "id": "src100_wall_Vnwrc",
   "src": "src100",
   "clause": "9.10.3",
   "page": 118,
   "title": "SRC 剪力牆 RC 部分之標稱剪力強度 Vnwrc（鋼骨鋼筋混凝土構造設計規範 9.10.3 (9.10-4)）",
   "keywords": "SRC 鋼骨鋼筋混凝土 剪力牆 RC 剪力強度 Vnwrc alpha_c 高寬比 牆筋比 9.10-4",
   "unit": "kgf（與輸入同單位）",
   "output": "Vnwrc",
   "latex": "V_{nwrc}=(\\alpha_c\\sqrt{f_c'}+\\rho_nF_{yr})A_{cv};\\quad \\alpha_c=0.80\\ (H_w/L_w\\le1.5),\\ 0.53\\ (H_w/L_w\\ge2.0),\\ 0.53[3.0-(H_w/L_w)]",
   "vars": {
    "fc": {
     "desc": "混凝土規定抗壓強度 f'c",
     "unit": "kgf/cm2",
     "min": 0
    },
    "rho_n": {
     "desc": "與剪力作用方向垂直平面上之牆筋比 ρn",
     "unit": "無因次",
     "min": 0
    },
    "Fyr": {
     "desc": "牆剪力鋼筋之規定降伏應力 Fyr",
     "unit": "kgf/cm2",
     "min": 0
    },
    "Acv": {
     "desc": "剪力方向全牆或設計牆段之 RC 總斷面積 Acv",
     "unit": "cm2",
     "min": 0
    },
    "Hw": {
     "desc": "剪力方向全牆或設計牆段之高度 Hw",
     "unit": "cm",
     "min": 0.0001
    },
    "Lw": {
     "desc": "剪力方向全牆或設計牆段之長度 Lw",
     "unit": "cm",
     "min": 0.0001
    }
   },
   "defs": [
