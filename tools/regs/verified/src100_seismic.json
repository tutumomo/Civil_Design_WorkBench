     "desc": "鋼板之標稱降伏應力 Fyp",
     "unit": "kgf/cm2",
     "min": 0,
     "default": 0
    },
    "Asp": {
     "desc": "剪力方向之鋼板斷面積 Asp",
     "unit": "cm2",
     "min": 0,
     "default": 0
    },
    "Pns": {
     "desc": "鋼骨斜撐之標稱受壓強度 Pns（依 6.4.1 節，reff 取 rs）",
     "unit": "kgf",
     "min": 0,
     "default": 0
    },
    "theta_w": {
     "desc": "鋼骨斜撐與水平線之夾角 θw",
     "unit": "度",
     "min": 0,
     "max": 90,
     "default": 45
    },
    "mode": {
     "desc": "0＝內裝鋼板（(9.10-2)）；1＝內裝 X 型或 V 型雙對稱鋼骨斜撐（(9.10-3)）",
     "unit": "型態",
     "min": 0,
     "max": 1,
     "default": 0
