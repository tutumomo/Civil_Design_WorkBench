   }
  },
  {
   "id": "steel99_Lc",
   "title": "側向未支撐間距上限 Lc（ASD 7.2.1 第(3)款）",
   "src": "steel99",
   "clause": "7.2.1",
   "page": 1,
   "keywords": "鋼構 Lc 側向未支撐 間距 梁 bf Af d",
   "unit": "cm",
   "output": "Lc",
   "latex": "L_c=\\min\\left(\\frac{20b_f}{\\sqrt{F_y}},\\;\\frac{1400}{(d/A_f)F_y}\\right)",
   "vars": {
    "bf": {
     "desc": "翼板寬",
     "unit": "cm",
     "min": 1
    },
    "d": {
     "desc": "梁深",
     "unit": "cm",
     "min": 1
    },
    "Af": {
     "desc": "壓力翼板斷面積",
     "unit": "cm2",
     "min": 0.1
    },
    "Fy": {
     "desc": "降伏應力",
     "unit": "tf/cm2",
     "min": 1.0,
     "max": 6.0
    }
   },
   "defs": [
    [
     "a",
     "20*bf/sqrt(Fy)"
    ],
    [
     "b",
     "1400/((d/Af)*Fy)"
    ]
   ],
   "expr": "min(a,b)",
   "notes": "Lb≤Lc 且符合第4.5節結實斷面等條件時，Fb 得取 0.66Fy（steel99_Fb_compact）。Lb>Lc 者依 7.2.3（未收錄）。",
   "tests": [
    {
     "in": {
      "bf": 15,
      "d": 40,
      "Af": 60,
      "Fy": 2.5
     },
     "out": 189.73665961010275,
     "tol": 1e-09
    }
   ],
   "status": "verified",
   "verified": {
    "method": "逐式對照原頁圖 第七章(一) p.1＋手算",
    "by": "agent",
    "date": "2026-11-01"
   }
  },
