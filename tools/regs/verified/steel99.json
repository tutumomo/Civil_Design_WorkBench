  {
   "id": "steel99_Mn_lateral",
   "title": "Lp<Lb≤Lr 之標稱撓曲強度 Mn=Cb[Mp−(Mp−Mr)(Lb−Lp)/(Lr−Lp)]（式7.2-1）",
   "src": "steel99",
   "clause": "7.2.2",
   "page": 1,
   "keywords": "鋼構 Mn 撓曲強度 側向扭轉挫屈 內插",
   "unit": "tf·cm",
   "output": "Mn",
   "latex": "M_n=C_b\\left[M_p-(M_p-M_r)\\frac{L_b-L_p}{L_r-L_p}\\right]\\le M_p",
   "vars": {
    "Cb": {
     "desc": "側向扭轉挫屈修正係數（steel99_Cb）",
     "unit": "-",
     "min": 1.0,
     "max": 2.3
    },
    "Mp": {
     "desc": "塑性彎矩",
     "unit": "tf·cm",
     "min": 1
    },
    "Mr": {
     "desc": "側向扭轉挫屈界限彎矩",
     "unit": "tf·cm",
     "min": 1
    },
    "Lb": {
     "desc": "側向無支撐段長度",
     "unit": "cm",
     "min": 1
    },
    "Lp": {
     "desc": "Lp（steel99_Lp_I）",
     "unit": "cm",
     "min": 1
    },
    "Lr": {
     "desc": "Lr（steel99_Lr_I）",
     "unit": "cm",
     "min": 1
    }
   },
   "conditions": [
    {
     "expr": "Lr>Lp",
     "msg": "Lr 必須大於 Lp"
    },
    {
     "expr": "Lb>=Lp",
     "msg": "Lb<Lp 時應直接用 Mn=Mp（7.2.2(1)）"
    }
   ],
   "expr": "min(Mp,Cb*(Mp-(Mp-Mr)*(Lb-Lp)/(Lr-Lp)))",
