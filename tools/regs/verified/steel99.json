      "M2": 100
     },
     "out": 2.3
    },
    {
     "in": {
      "M1": -100,
      "M2": 100
     },
     "out": 1.0
    },
    {
     "in": {
      "M1": 50,
      "M2": 100,
      "cantilever": 1
     },
     "out": 1.0
    }
   ],
   "status": "verified",
   "verified": {
    "method": "逐式對照原頁圖 第七章(二) p.1＋手算",
    "by": "agent",
    "date": "2026-11-01"
   }
  },
