{
 "formulas": [
  {
   "id": "steel99_Fa_asd",
   "title": "受壓構材容許壓應力 Fa（ASD，式6.3-1、6.3-2）",
   "src": "steel99",
   "clause": "6.3",
   "page": 1,
   "keywords": "鋼構 受壓 柱 容許壓應力 Fa 挫屈 ASD Cc",
   "unit": "tf/cm2",
   "output": "Fa",
   "latex": "F_a=\\frac{[1-\\frac{(KL/r)^2}{2C_c^2}]F_y}{\\frac53+\\frac38\\frac{KL/r}{C_c}-\\frac18\\left(\\frac{KL/r}{C_c}\\right)^3}\\;(KL/r<C_c);\\quad F_a=\\frac{12\\pi^2E}{23(KL/r)^2}\\;(KL/r\\ge C_c),\\quad C_c=\\sqrt{\\frac{2\\pi^2E}{F_y}}",
   "vars": {
    "Fy": {
     "desc": "降伏應力",
     "unit": "tf/cm2",
     "min": 1.0,
     "max": 6.0
    },
    "E": {
     "desc": "彈性模數",
     "unit": "tf/cm2",
     "default": 2100.0,
     "min": 1500,
     "max": 2500
    },
    "klr": {
     "desc": "有效長細比 KL/r（K 依第4.8節）",
     "unit": "-",
     "min": 1,
     "max": 400
    }
   },
   "defs": [
    [
     "Cc",
     "sqrt(2*pi**2*E/Fy)"
    ]
   ],
   "expr": "(1-(klr**2)/(2*Cc**2))*Fy/(5/3+3/8*(klr/Cc)-1/8*(klr/Cc)**3) if klr<Cc else 12*pi**2*E/(23*klr**2)",
   "conditions": [
    {
     "expr": "klr<=200 or True",
     "msg": ""
    }
   ],
   "warn_if": [
    {
     "expr": "klr>200",
     "msg": "長細比 KL/r 超過 200，另受第4.4節最大長細比限制"
    }
   ],
   "notes": "ASD（容許應力設計法，第六(一)章）。適用於肢材寬厚比符合結實或半結實斷面、且未受支撐部分最大有效長細比 KL/r<Cc 者。單位 tf、cm。C_c 為彈性與非彈性挫屈分界（挫屈應力=0.5Fy 之長細比）。",
   "tests": [
    {
     "in": {
      "Fy": 2.5,
      "E": 2100,
      "klr": 80
     },
     "out": 1.079077063727558,
     "tol": 1e-09
    },
    {
     "in": {
      "Fy": 2.5,
      "E": 2100,
      "klr": 150
     },
     "out": 0.48060682300956875,
     "tol": 1e-09
    }
   ],
   "status": "verified",
   "verified": {
    "method": "逐式對照原頁圖 第六章(一) p.1（式6.3-1、6.3-2）＋手算",
    "by": "agent",
    "date": "2026-11-01"
   }
  },
  {
   "id": "steel99_Fcr_lrfd",
   "title": "受壓構材標稱壓應力 Fcr 與設計強度 φcPn（LRFD，式6.2-1~6.2-4）",
   "src": "steel99",
   "clause": "6.2",
   "page": 1,
   "keywords": "鋼構 LRFD 柱 Fcr lambda_c φcPn 極限設計 受壓",
   "unit": "tf",
   "output": "phiPn",
   "latex": "\\lambda_c=\\frac{KL}{\\pi r}\\sqrt{\\frac{F_y}{E}},\\;F_{cr}=e^{-0.419\\lambda_c^2}F_y\\;(\\lambda_c\\le1.5);\\;\\frac{0.877}{\\lambda_c^2}F_y\\;(\\lambda_c>1.5),\\;\\phi_c=0.85,\\;P_n=A_gF_{cr}",
   "vars": {
    "Fy": {
     "desc": "標稱降伏應力",
     "unit": "tf/cm2",
     "min": 1.0,
     "max": 6.0
    },
    "E": {
     "desc": "彈性模數",
     "unit": "tf/cm2",
     "default": 2100.0,
     "min": 1500,
     "max": 2500
    },
    "klr": {
     "desc": "有效長細比 KL/r",
     "unit": "-",
     "min": 1,
     "max": 400
    },
    "Ag": {
     "desc": "構材全斷面積",
     "unit": "cm2",
     "min": 0.1
    }
   },
   "defs": [
    [
     "lc",
     "klr/pi*sqrt(Fy/E)"
    ],
    [
     "Fcr",
     "exp(-0.419*lc**2)*Fy if lc<=1.5 else 0.877/lc**2*Fy"
    ]
   ],
   "expr": "0.85*Ag*Fcr",
   "notes": "LRFD（鋼結構極限設計法，第六(二)章）。φc=0.85；輸出為 φcPn（tf），steps.Fcr 為標稱壓應力。肢材寬厚比大於 λr 者另依附錄1（未收錄）。",
   "tests": [
    {
     "in": {
      "Fy": 2.5,
      "E": 2100,
      "klr": 80,
      "Ag": 100
     },
     "out": 153.77433516099862,
     "tol": 1e-09
    },
    {
     "in": {
      "Fy": 2.5,
      "E": 2100,
      "klr": 200,
      "Ag": 100
     },
     "out": 38.62580715415832
    }
   ],
   "status": "verified",
   "verified": {
    "method": "逐式對照原頁圖 第六章(二) p.1（式6.2-1~6.2-4）＋手算",
    "by": "agent",
    "date": "2026-11-01"
   }
  },
  {
