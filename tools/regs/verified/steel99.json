     "min": 10
    },
    "E": {
     "desc": "鋼材彈性模數",
     "unit": "tf/cm2",
     "default": 2100,
     "min": 1500,
     "max": 2500
    },
    "G": {
     "desc": "鋼材彈性剪力模數",
     "unit": "tf/cm2",
     "default": 810,
     "min": 600,
     "max": 1000
    },
    "J": {
     "desc": "扭曲常數",
     "unit": "cm4",
     "min": 0.01
    },
    "A": {
     "desc": "斷面積",
     "unit": "cm2",
     "min": 1
    },
    "Iy": {
     "desc": "對弱軸之慣性矩",
     "unit": "cm4",
     "min": 0.01
    },
