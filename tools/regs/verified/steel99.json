  {
   "id": "steel99_Cb",
   "title": "側向扭轉挫屈修正係數 Cb（LRFD 7.2.2）",
   "src": "steel99",
   "clause": "7.2.2",
   "page": 1,
   "keywords": "鋼構 Cb 側向扭轉挫屈 彎矩梯度",
   "unit": "-",
   "output": "Cb",
   "latex": "C_b=1.75+1.05(M_1/M_2)+0.3(M_1/M_2)^2\\le2.3",
   "vars": {
    "M1": {
     "desc": "側向無支撐段兩端彎矩較小者（單曲率時 M1/M2 為負）",
     "unit": "tf·cm",
     "min": -1000000000.0,
     "max": 1000000000.0
    },
    "M2": {
     "desc": "兩端彎矩較大者（非零）",
     "unit": "tf·cm",
     "min": -1000000000.0,
     "max": 1000000000.0
    },
    "cantilever": {
     "desc": "側向無支撐之懸臂梁＝1（Cb 取 1.0）",
     "unit": "-",
     "default": 0,
     "min": 0,
     "max": 1
    }
   },
   "expr": "1.0 if cantilever>0.5 else min(2.3,1.75+1.05*(M1/M2)+0.3*(M1/M2)**2)",
   "notes": "M1/M2 於雙曲率彎曲時為正值、單曲率時為負值。側向無支撐段內任一點彎矩大於或等於 M2 時，Cb 取 1.0。",
