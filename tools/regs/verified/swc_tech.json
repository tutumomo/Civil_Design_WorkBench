{
 "formulas": [
  {"id": "swc16_intensity", "title": "降雨強度 I(T,t)（無因次降雨強度公式）", "src": "swc_tech", "clause": "16",
   "keywords": "降雨強度 重現期 延時 intensity 無因次", "unit": "mm/hr", "output": "I",
   "latex": "I^{T}_{t}=I^{25}_{60}\\,(G+H\\log T)\\,\\frac{A}{(t+B)^{C}}",
   "vars": {"P": {"desc": "年平均降雨量", "unit": "mm", "min": 500, "max": 6000},
            "T": {"desc": "重現期距", "unit": "年", "min": 1, "max": 1000},
            "t": {"desc": "降雨延時或集流時間", "unit": "min", "min": 1, "max": 1440}},
   "defs": [["I60_25", "(P/(25.29+0.094*P))**2"], ["A", "(P/(-189.96+0.31*P))**2"], ["B", "55"],
            ["C", "(P/(-381.71+1.45*P))**2"], ["G", "(P/(42.89+1.33*P))**2"], ["H", "(P/(-65.33+1.836*P))**2"]],
   "expr": "I60_25*(G+H*log10(T))*A/((t+B)**C)",
   "notes": "第16條：降雨強度推估值不得小於此公式之推估值（此式為下限）。P 須採計畫區附近 15 年以上雨量資料。log 為常用對數。",
   "warn_if": [{"expr": "result<=0", "msg": "結果非正，檢查輸入"}],
   "tests": [{"in": {"P": 2000, "T": 25, "t": 60}, "out": null, "xcheck": "hydrology.rainfall_intensity(2000,25,60)"}],
   "status": "verified", "verified": {"method": "對照原條文(1)~(7)式＋與 tools/design/hydrology.py 交叉比對", "by": "agent", "date": "2026-11-01"}},

  {"id": "swc17_rational_qp", "title": "合理化公式洪峰流量 Qp=CIA/360", "src": "swc_tech", "clause": "17",
   "keywords": "合理化公式 洪峰流量 逕流 rational Qp", "unit": "m3/s", "output": "Qp",
   "latex": "Q_p=\\frac{1}{360}\\,C\\,I\\,A",
   "vars": {"C": {"desc": "逕流係數", "unit": "-", "min": 0, "max": 1},
            "I": {"desc": "降雨強度", "unit": "mm/hr", "min": 0},
            "A": {"desc": "集水區面積", "unit": "ha", "min": 0, "max": 1000}},
   "expr": "C*I*A/360",
   "notes": "第17條：面積在一千公頃以內且無實測資料時得採用；超過 1000 ha 須用單位歷線。",
   "tests": [{"in": {"C": 0.9, "I": 100, "A": 36}, "out": 9.0}],
   "status": "verified", "verified": {"method": "原條文＋手算＋與 hydrology.design_flow 交叉比對", "by": "agent", "date": "2026-11-01"}},

  {"id": "swc19_t1_overland", "title": "流入時間 t1=l/v（漫地流）", "src": "swc_tech", "clause": "19",
   "keywords": "集流時間 流入時間 漫地流 t1", "unit": "s", "output": "t1",
   "latex": "t_1=\\frac{l}{v}",
   "vars": {"l": {"desc": "漫地流流動長度", "unit": "m", "min": 0, "max": 300},
            "v": {"desc": "漫地流流速", "unit": "m/s", "min": 0.3, "max": 0.6}},
   "expr": "l/v",
   "warn_if": [{"expr": "l>100", "msg": "第19條：開發坡面之漫地流長度不得大於 100 m（集水區 300 m）；若為開發坡面此輸入不合規"}],
   "notes": "結果單位為秒；tc(分)=t1/60+t2×60。超過長度上限之部分須併入流下時間。",
   "tests": [{"in": {"l": 100, "v": 0.5}, "out": 200.0}],
   "status": "verified", "verified": {"method": "原條文＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "swc19_t2_rziha", "title": "流下時間 t2=L/W，W=72(H/L)^0.6（芮哈公式）", "src": "swc_tech", "clause": "19",
   "keywords": "集流時間 流下時間 芮哈 Rziha t2", "unit": "hr", "output": "t2",
   "latex": "t_2=\\frac{L}{W},\\quad W=72\\left(\\frac{H}{L}\\right)^{0.6}",
   "vars": {"H": {"desc": "溪流縱斷面高程差", "unit": "km", "min": 0},
            "L": {"desc": "溪流長度", "unit": "km", "min": 0.001}},
   "defs": [["W", "72*(H/L)**0.6"]], "expr": "L/W",
   "notes": "適用天然河段；人工整治後規則河段應以曼寧公式求流速。W 單位 km/hr，t2 單位小時。",
   "tests": [{"in": {"H": 0.1, "L": 1.0}, "out": 0.055293, "tol": 0.0001}],
   "status": "verified", "verified": {"method": "原條文＋手算＋與 hydrology.time_of_concentration 交叉比對", "by": "agent", "date": "2026-11-01"}},

  {"id": "swc25_slope_grid", "title": "坵塊法平均坡度 S=nπΔh/(8L)×100", "src": "swc_tech", "clause": "25",
   "keywords": "坡度 坵塊法 平均坡度", "unit": "%", "output": "S",
   "latex": "S=\\frac{n\\pi\\Delta h}{8L}\\times100",
   "vars": {"n": {"desc": "方格內等高線與方格邊線交點總數和", "unit": "點", "min": 0},
            "dh": {"desc": "等高線間距 Δh", "unit": "m", "min": 0},
            "L": {"desc": "方格(坵塊)邊長", "unit": "m", "min": 0.001}},
   "expr": "n*3.14*dh/(8*L)*100",
   "notes": "第25條規定 π 取 3.14。方格邊長為 10 m 或 25 m。",
   "tests": [{"in": {"n": 16, "dh": 10, "L": 25}, "out": 251.2, "tol": 0.0001}],
   "status": "verified", "verified": {"method": "原條文＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "swc25_slope_contour", "title": "等高線法平均坡度 S=h/L×100", "src": "swc_tech", "clause": "25",
   "keywords": "坡度 等高線法 平均坡度", "unit": "%", "output": "S",
   "latex": "S=\\frac{h}{L}\\times100",
   "vars": {"h": {"desc": "兩點間高差", "unit": "m", "min": 0},
            "L": {"desc": "兩點間水平距離", "unit": "m", "min": 0.001}},
   "expr": "h/L*100", "tests": [{"in": {"h": 30, "L": 100}, "out": 30.0}],
   "status": "verified", "verified": {"method": "原條文＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "swc35_usle", "title": "USLE 土壤流失量 Am=Rm·Km·L·S·C·P", "src": "swc_tech", "clause": "35",
   "keywords": "USLE 土壤流失 通用土壤流失公式 沖蝕", "unit": "公噸/公頃/年", "output": "Am",
   "latex": "A_m=R_m K_m L S C P",
   "vars": {"Rm": {"desc": "降雨沖蝕指數", "unit": "MJ·mm/(ha·hr·yr)", "min": 0},
            "Km": {"desc": "土壤沖蝕指數", "unit": "t·ha·hr/(ha·MJ·mm)", "min": 0},
            "L": {"desc": "坡長因子", "unit": "-", "min": 0},
            "S": {"desc": "坡度因子", "unit": "-", "min": 0},
            "C": {"desc": "覆蓋與管理因子", "unit": "-", "min": 0, "max": 1},
            "P": {"desc": "水土保持處理因子", "unit": "-", "min": 0, "max": 1}},
   "expr": "Rm*Km*L*S*C*P",
   "warn_if": [],
   "notes": "第35條：換算體積以每立方公尺 1.4 公噸計；開挖整地推估時 C 不得小於 0.05、P 不得小於 0.5；各參數須用台灣各地區之參數值。",
   "tests": [{"in": {"Rm": 10000, "Km": 0.03, "L": 1.5, "S": 2.0, "C": 0.05, "P": 0.5}, "out": 22.5, "tol": 0.001}],
   "status": "verified", "verified": {"method": "原條文＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "swc84_manning_v", "title": "曼寧公式平均流速 v=(1/n)R^(2/3)S^(1/2)", "src": "swc_tech", "clause": "84",
   "keywords": "曼寧 流速 排水渠 manning", "unit": "m/s", "output": "v",
   "latex": "v=\\frac{1}{n}R^{2/3}S^{1/2}",
   "vars": {"n": {"desc": "曼寧粗糙係數", "unit": "-", "min": 0.005, "max": 0.2},
            "R": {"desc": "水力半徑", "unit": "m", "min": 0.0001},
            "S": {"desc": "水力坡降（可用溝底坡代）", "unit": "m/m", "min": 0.000001}},
   "expr": "(1/n)*R**(2/3)*S**0.5",
   "warn_if": [{"expr": "result<0.8", "msg": "第85條：混凝土排水設施最小容許流速 0.8 m/s，此流速低於下限"}],
   "notes": "R=A/P（見 swc84_hydraulic_radius）。容許流速上限見表 swc85_max_velocity。",
   "tests": [{"in": {"n": 0.015, "R": 0.5, "S": 0.01}, "out": 4.19974, "tol": 0.0001}],
   "status": "verified", "verified": {"method": "原條文＋手算＋與 channel_hydraulics.capacity 交叉比對", "by": "agent", "date": "2026-11-01"}},

  {"id": "swc84_hydraulic_radius", "title": "水力半徑 R=A/P", "src": "swc_tech", "clause": "84",
   "keywords": "水力半徑 潤周 通水斷面", "unit": "m", "output": "R",
   "latex": "R=\\frac{A}{P}",
   "vars": {"A": {"desc": "通水斷面積", "unit": "m2", "min": 0},
            "P": {"desc": "潤周長", "unit": "m", "min": 0.0001}},
   "expr": "A/P", "tests": [{"in": {"A": 0.5, "P": 2.0}, "out": 0.25}],
   "status": "verified", "verified": {"method": "原條文＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "swc96_Vs1_temp_detention", "title": "臨時滯洪量 Vs1=tb'(Q2−Q1)/2×3600", "src": "swc_tech", "clause": "96",
   "keywords": "滯洪量 臨時 三角單位歷線", "unit": "m3", "output": "Vs1",
   "latex": "V_{s1}=\\frac{t_b'(Q_2-Q_1)}{2}\\times3600",
   "vars": {"tb": {"desc": "基期（不足一小時以一小時計）", "unit": "hr", "min": 1},
            "Q1": {"desc": "開發前洪峰流量", "unit": "m3/s", "min": 0},
            "Q2": {"desc": "開發中洪峰流量", "unit": "m3/s", "min": 0}},
   "expr": "tb*(Q2-Q1)/2*3600",
   "conditions": [{"expr": "Q2>=Q1", "msg": "開發中洪峰流量應不小於開發前"}],
   "tests": [{"in": {"tb": 1, "Q1": 1.0, "Q2": 3.0}, "out": 3600.0}],
   "status": "verified", "verified": {"method": "原條文＋手算", "by": "agent", "date": "2026-11-01"}},

  {"id": "swc96_Vs2_perm_detention", "title": "永久滯洪量 Vs2=tb'(Q3−Q1)/2×3600", "src": "swc_tech", "clause": "96",
   "keywords": "滯洪量 永久 三角單位歷線", "unit": "m3", "output": "Vs2",
