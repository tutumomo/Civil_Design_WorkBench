 "formulas": [
  {
   "id": "urbanroad113_rational_Q",
   "title": "逕流量合理化公式 Q=(C×I×A)/360（7.2.3）",
   "src": "urbanroad113",
   "clause": "7.2.3",
   "page": 85,
   "keywords": "逕流量 合理化公式 rational 設計流量 市區道路 暴雨",
   "unit": "m3/s",
   "output": "Q",
   "latex": "Q=\\frac{C\\times I\\times A}{360}",
   "vars": {
    "C": {
     "desc": "逕流係數（查表 7.2.2／表 7.2.3）",
     "unit": "-",
     "min": 0,
     "max": 1
    },
    "I": {
     "desc": "降雨持續時間 t 分鐘內之平均降雨率",
     "unit": "mm/hr",
     "min": 0
    },
    "A": {
     "desc": "集水面積",
     "unit": "ha",
     "min": 0
    }
   },
   "expr": "C*I*A/360",
   "conditions": [],
   "warn_if": [
    {
     "expr": "A > 1000",
     "msg": "集水面積逾 1000 ha，7.2.3 第2款規定應改以單位歷線法或其他經驗證之水文、水理模式推算"
    }
   ],
   "notes": "原條文：Q 逕流量（立方公尺/秒）、C 逕流係數、I 降雨持續時間 t 分鐘內之平均降雨率（公釐/小時）、A 集水面積（公頃）。單位制為 SI（mm/hr、ha、m3/s），與水土保持技術規範第 17 條 swc17_rational_qp 同式。7.2.3 第2款：集水面積過大而不適合採用合理化公式者，應另以單位歷線法推算。",
   "tests": [
    {
     "in": {
      "C": 0.8,
      "I": 50,
      "A": 2.0
     },
     "out": 0.2222222222222222,
     "tol": 1e-09
    }
   ],
   "status": "verified",
   "verified": {
    "method": "逐式對照原頁圖 p.85＋手算；與 swc17_rational_qp 交叉比對一致",
    "by": "agent",
    "date": "2026-11-01"
   }
  },
  {
