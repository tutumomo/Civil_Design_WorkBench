  {
   "id": "wood100_bolt_tension_allow",
   "title": "螺栓接合長期容許拉力（木構造 6.4.2 (6.8)(6.9)式取小）",
   "src": "wood100",
   "clause": "6.4.2",
   "page": 87,
   "keywords": "木構造 螺栓 容許拉力 墊圈面積 壓陷應力 (6.8) (6.9)",
   "unit": "kgf",
   "output": "Pt",
   "latex": "P_t = \\min\\left(0.5 F A_z,\\; f_c A_w\\right)",
   "vars": {
    "F": {
     "desc": "螺栓鋼材之基準強度 F（2400 kgf/cm2 以上）",
     "unit": "kgf/cm2",
     "min": 0
    },
    "A_z": {
     "desc": "螺栓斷面積 Az",
     "unit": "cm2",
     "min": 0
    },
    "f_c": {
     "desc": "木材之長期容許壓陷應力 fc",
     "unit": "kgf/cm2",
     "min": 0
    },
    "A_w": {
     "desc": "墊圈之面積 Aw",
     "unit": "cm2",
     "min": 0
    }
   },
   "defs": [
    [
     "P_steel",
     "0.5 * F * A_z"
    ],
    [
     "P_wood",
     "f_c * A_w"
    ]
   ],
   "expr": "min(P_steel, P_wood)",
   "conditions": [
    {
     "expr": "F >= 0 and A_z >= 0 and f_c >= 0 and A_w >= 0",
     "msg": "強度與面積須非負"
    },
    {
     "expr": "F >= 2400",
     "msg": "螺栓鋼材基準強度未達 2400 kgf/cm2"
    }
   ],
   "tests": [
