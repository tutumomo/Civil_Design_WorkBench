{
 "formulas": [
  {
   "id": "wood100_hankinson_load_angle",
   "title": "接合扣件載重角度 θ 之容許應力（木構造 6.1.3 (6.1)式）",
   "src": "wood100",
   "clause": "6.1.3",
   "page": 75,
   "keywords": "木構造 接合部 載重角度 Hankinson 容許應力 R0 R90 (6.1)",
   "unit": "kgf/cm2",
   "output": "R_theta",
   "latex": "R_\\theta = \\frac{R_0 \\cdot R_{90}}{R_0 \\sin^2\\theta + R_{90}\\cos^2\\theta}",
   "vars": {
    "R_0": {
     "desc": "纖維平行方向之容許應力 R0",
     "unit": "kgf/cm2",
     "min": 0
    },
    "R_90": {
     "desc": "纖維垂直方向之容許應力 R90",
     "unit": "kgf/cm2",
     "min": 0
    },
    "theta_deg": {
     "desc": "載重角度 θ（外力合力方向與構材長軸夾角，0~90 度）",
     "unit": "度",
     "min": 0,
     "max": 90
    }
   },
   "defs": [
    [
     "t",
     "radians(theta_deg)"
    ]
   ],
   "expr": "(R_0 * R_90) / (R_0 * (sin(t) ** 2) + R_90 * (cos(t) ** 2))",
   "conditions": [
    {
     "expr": "R_0 >= 0 and R_90 >= 0 and 0 <= theta_deg <= 90",
     "msg": "R0、R90 須非負，載重角度須介於 0~90 度"
    },
    {
     "expr": "R_0 * (sin(t) ** 2) + R_90 * (cos(t) ** 2) > 0",
     "msg": "分母為 0（R0 與 R90 同時為 0）"
    }
   ],
   "tests": [
    {
     "in": {
      "R_0": 100,
      "R_90": 30,
      "theta_deg": 30
     },
     "out": 63.1578947368421
    },
    {
     "in": {
      "R_0": 100,
      "R_90": 30,
      "theta_deg": 0
     },
     "out": 100.0
    },
    {
     "in": {
      "R_0": 100,
      "R_90": 30,
      "theta_deg": 90
     },
     "out": 30.0
    }
   ],
   "notes": "木構造 6.1.3 (6.1)式（Hankinson 式，p.75）：載重角度為施加於一個接合扣件之外力合力方向與構材長軸之夾角。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.75 §6.1.3 (6.1)式（p75.png）",
    "by": "agent",
    "date": "2026-11-14"
   },
   "_file": "wood100_p3_joints.json"
  },
  {
   "id": "wood100_joint_shear_stress",
   "title": "接合部之剪應力（木構造 6.1.7 (6.2)式）",
   "src": "wood100",
   "clause": "6.1.7",
   "page": 78,
   "keywords": "木構造 接合部 剪應力 端距係數 k he (6.2)",
   "unit": "kgf/cm2",
   "output": "F_v",
   "latex": "F_v = k\\frac{3Q}{2 b h_e}",
   "vars": {
    "Q": {
     "desc": "構材之剪力，取 Q1、Q2 中較大值",
     "unit": "kgf",
     "min": 0
    },
    "b": {
     "desc": "構材寬度 b",
     "unit": "cm",
     "min": 0.1
    },
    "h_e": {
     "desc": "構材深度減去載重非承擔側邊距之值 he",
     "unit": "cm",
     "min": 0.1
    },
    "k": {
     "desc": "接合部位端距係數：C 為構材深度 5 倍以上取 2/3（插入鋼板接合取 1.0），未達 5 倍時 k = h/he",
     "unit": "無因次",
     "min": 0.1
    }
   },
   "expr": "k * 3.0 * Q / (2.0 * b * h_e)",
   "conditions": [
    {
     "expr": "Q >= 0 and b > 0 and h_e > 0 and k > 0",
     "msg": "Q 須非負，b、he、k 須為正"
    }
   ],
   "tests": [
    {
     "in": {
      "Q": 1000,
      "b": 10,
      "h_e": 15,
      "k": 0.6666666666666666
     },
     "out": 6.666666666666666
    }
   ],
   "notes": "木構造 6.1.7 (6.2)式（p.78，圖6.1-4）：以裂環、剪力板、螺栓及穿孔釘等接合之構材，當載重角度大於 0 度時，接合部剪應力須小於構材之容許剪應力。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.78 §6.1.7 (6.2)式（p78.png）",
    "by": "agent",
    "date": "2026-11-14"
   },
   "_file": "wood100_p3_joints.json"
  },
  {
   "id": "wood100_nail_shear_allow",
   "title": "鐵釘單剪長期容許剪力（木構造 6.2.2 (6.3)式）",
   "src": "wood100",
   "clause": "6.2.2",
   "page": 81,
   "keywords": "木構造 釘接合 容許剪力 樹種群係數 J1 J2 J3 (6.3)",
   "unit": "kgf",
   "output": "P",
   "latex": "P = k d^{1.8}",
   "vars": {
    "k": {
     "desc": "樹種群係數（J1=255、J2=230、J3=200，依表6.1-1 分類）",
     "unit": "無因次",
     "min": 0
    },
    "d": {
     "desc": "釘徑 d",
     "unit": "cm",
     "min": 0.1
    }
   },
   "expr": "k * (d ** 1.8)",
   "conditions": [
    {
     "expr": "k >= 0 and d > 0",
     "msg": "k 須非負且 d > 0"
    }
   ],
   "tests": [
    {
     "in": {
      "k": 255,
      "d": 0.4
     },
     "out": 49.005876906442396
    }
   ],
   "notes": "木構造 6.2.2(1) (6.3)式（p.81）：釘入木材側面之鐵釘其單剪長期容許剪力；短期為長期之 2 倍。側材厚度應為釘徑 6 倍以上、釘長為側材厚度 2.5 倍以上；雙剪取單剪之 2 倍。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.81 §6.2.2(1) (6.3)式（p81.png）",
    "by": "agent",
    "date": "2026-11-14"
   },
   "_file": "wood100_p3_joints.json"
  },
  {
   "id": "wood100_nail_plywood_side_shear",
   "title": "以合板為側材之釘單剪容許剪力（木構造 6.2.3 (6.4)式，與 (6.3) 取小）",
   "src": "wood100",
   "clause": "6.2.3",
   "page": 83,
   "keywords": "木構造 釘接合 合板側材 容許剪力 punch shear (6.4)",
   "unit": "kgf",
   "output": "P",
   "latex": "P = 187\\,\\rho_p^{1.5} t^{0.75} d_h^{1.7}",
   "vars": {
    "rho_p": {
     "desc": "合板之比重 ρp（可用表6.1-1 數值，柳桉合板與 J1 同等；多樹種取較低值）",
     "unit": "無因次",
     "min": 0.1
    },
    "t": {
     "desc": "合板厚度 t（5mm 以上之構造用合板）",
     "unit": "cm",
     "min": 0.1
    },
    "d_h": {
     "desc": "釘頭部直徑 dh",
     "unit": "cm",
     "min": 0.1
    }
   },
   "expr": "187.0 * (rho_p ** 1.5) * (t ** 0.75) * (d_h ** 1.7)",
   "conditions": [
    {
     "expr": "rho_p > 0 and t > 0 and d_h > 0",
     "msg": "ρp、t、dh 須為正"
    },
    {
     "expr": "t >= 0.5",
     "msg": "本式以厚度 5mm 以上之構造用合板為對象"
    }
   ],
   "tests": [
    {
     "in": {
      "rho_p": 0.5,
      "t": 0.9,
      "d_h": 0.6
     },
     "out": 25.635135702652693
    }
   ],
   "notes": "木構造 6.2.3(1) (6.4)式（p.83）：須與 (6.3) 式計算值取較小值；短期為長期之 2 倍。釘入主構材之釘長應為釘徑 9 倍以上且為側材厚度 1.5 倍以上，適用釘徑 2.7mm 以上。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.83 §6.2.3(1) (6.4)式（p83.png）",
    "by": "agent",
    "date": "2026-11-14"
   },
   "_file": "wood100_p3_joints.json"
  },
  {
