  {
   "id": "wood100_drive_pin_shear_allow",
   "title": "穿孔釘接合長期容許剪力（木構造 6.6.2 (6.13)式）",
   "src": "wood100",
   "clause": "6.6.2",
   "page": 95,
   "keywords": "木構造 穿孔釘 容許剪力 降伏強度 (6.13) (6.14)",
   "unit": "kgf",
   "output": "Pa",
   "latex": "P_a = \\tfrac{1}{3} P_y,\\qquad P_y = C F_e d\\, l",
   "vars": {
    "C": {
     "desc": "依接合形式與破壞形式而定之係數 C（圖6.6-2）",
     "unit": "無因次",
     "min": 0
    },
    "F_e": {
     "desc": "主構材之承壓強度 Fe（取長期容許壓應力之 3 倍）",
     "unit": "kgf/cm2",
     "min": 0
    },
    "d": {
     "desc": "穿孔釘之軸徑 d",
     "unit": "cm",
     "min": 0.1
    },
    "l": {
     "desc": "主構材厚度 l",
     "unit": "cm",
     "min": 0.1
    }
   },
   "defs": [
    [
     "P_y",
     "C * F_e * d * l"
