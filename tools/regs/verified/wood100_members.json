  {
   "id": "wood100_bending_effective_ze",
   "title": "受彎構材有效斷面模數（木構造 5.4.3 (5.15)式）",
   "src": "wood100",
   "clause": "5.4.3",
   "page": 63,
   "keywords": "木構造 受彎構材 有效斷面模數 切口 受壓側 受拉側 (5.15)",
   "unit": "cm3",
   "output": "Z_e",
   "latex": "Z_e = \\begin{cases} Z & \\text{無缺口} \\\\ Z_0 & \\text{受壓側有切口} \\\\ 0.6 Z_0 & \\text{受拉側有切口}(h' > \\frac{3}{4}h) \\end{cases}",
   "vars": {
    "b": {
     "desc": "矩形斷面寬度 b",
     "unit": "cm",
     "min": 0
    },
    "h": {
     "desc": "全斷面深度 h",
     "unit": "cm",
     "min": 0.1
    },
    "h_rem": {
     "desc": "切口處殘存淨深度 h'（無缺口時填 h）",
     "unit": "cm",
     "min": 0
    },
    "notch_type": {
     "desc": "缺口型態：0=無缺口，1=受壓側有切口，2=受拉側有切口",
