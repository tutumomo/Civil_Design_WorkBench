     "unit": "無因次",
     "min": 0.1
    }
   },
   "expr": "f_b * Z_e / C_f",
   "conditions": [
    {
     "expr": "f_b >= 0 and Z_e >= 0 and C_f > 0",
     "msg": "f_b >= 0、Z_e >= 0 且 C_f > 0"
    }
