  {
   "id": "wood100_bending_moment_allow",
   "title": "單一受彎構材容許彎矩（木構造 5.4.3 (5.14)式）",
   "src": "wood100",
   "clause": "5.4.3",
   "page": 62,
   "keywords": "木構造 受彎構材 撓曲應力 有效斷面模數 尺寸調整係數 (5.14)",
   "unit": "kgf-cm",
   "output": "M_allow",
   "latex": "\\frac{M}{Z_e} \\times C_f \\le f_b \\iff M \\le \\frac{f_b Z_e}{C_f}",
   "vars": {
    "f_b": {
     "desc": "容許撓曲應力 f_b（若需考慮橫向挫屈，取折減後 fb' = Cb*fb）",
     "unit": "kgf/cm2",
     "min": 0
