      "h": 30,
      "b": 10,
      "E_yy": 120000,
      "L_f_bxx": 110,
      "f_b": 110
     },
     "out": 110.0
    },
    {
     "in": {
      "l_e": 1200,
      "h": 40,
      "b": 8,
      "E_yy": 120000,
      "L_f_bxx": 110,
      "f_b": 110
     },
     "out": 64.0
    }
   ],
   "notes": "木構造 5.4.3(5) (5.19)~(5.21)式及表5.4-5（p.64-65）：注意表5.4-5 中 C_k < C_s <= 50 段為 C_b = 0.4 E//y-y / (C_s^2 * Lfbx-x)，與 C_k = 0.8*sqrt(E/f) 之銜接點在 C_s = C_k 處：左側 1 - 1/3 = 0.667，右側 0.4 / 0.64 = 0.625。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.64-65 §5.4.3(5) (p64.png/p65.png)",
    "by": "agent",
