   "latex": "C_f = C_l \\times C_h \\times \\left(\\frac{30}{h}\\right)^{1/9}",
   "vars": {
    "h": {
     "desc": "受彎構材（梁）深 h（<=30cm 時 Cf=1.00）",
     "unit": "cm",
     "min": 0.1
    },
    "C_l": {
     "desc": "載重調整係數（一點集中 1.08、等均布 1.0、三分點 0.97）",
     "unit": "無因次",
     "min": 0.5
    },
    "C_h": {
     "desc": "跨度/梁深調整係數（依表5.4-3：7→1.06, 14→1.02, 21→1.00, 28~35→0.98）",
     "unit": "無因次",
     "min": 0.5
    }
   },
   "expr": "1.0 if h <= 30 else C_l * C_h * ((30.0 / h) ** (1.0 / 9.0))",
   "conditions": [
