{
 "formulas": [
  {
   "id": "wood100_tension_member",
   "title": "受拉構材容許軸拉力計算（木構造 5.2.1 (5.1)式）",
   "src": "wood100",
   "clause": "5.2.1",
   "page": 51,
   "keywords": "木構造 受拉構材 容許軸拉力 有效淨斷面積 容許拉應力 (5.1)",
   "unit": "kgf",
   "output": "N_allow",
   "latex": "N \\le A_e f_t",
   "vars": {
    "A_e": {
     "desc": "依 5.2.2 節規定之有效淨斷面積（斷面欠缺總和須在全斷面積 1/4 以下）",
     "unit": "cm2",
     "min": 0
    },
    "f_t": {
     "desc": "容許拉應力（長期或短期）",
     "unit": "kgf/cm2",
     "min": 0
    }
   },
   "expr": "A_e * f_t",
   "conditions": [
    {
     "expr": "A_e >= 0 and f_t >= 0",
     "msg": "有效淨斷面積與容許拉應力須非負"
    }
   ],
   "tests": [
    {
     "in": {
      "A_e": 80,
      "f_t": 55
     },
     "out": 4400.0
    }
   ],
   "notes": "木構造 5.2.1 (5.1)式 N <= A_e * f_t；另依 5.2.2(2)，受拉構材斷面欠缺總和應在全斷面積之 1/4 以下。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.51 §5.2.1 (5.1)式（wood100_pt2.txt）",
    "by": "agent",
    "date": "2026-11-14"
   },
   "_file": "wood100_p2_members.json"
  },
  {
   "id": "wood100_tension_notch_ae",
   "title": "受拉構材邊緣切口之有效淨斷面積（木構造 5.2.3 解說 (5.2)式）",
   "src": "wood100",
   "clause": "5.2.3",
   "page": 52,
   "keywords": "木構造 受拉構材 切口 有效淨斷面積 偏心 (5.2)",
   "unit": "cm2",
   "output": "A_e",
   "latex": "A_e = b(h - h') \\times 0.5",
   "vars": {
    "b": {
     "desc": "構材寬度 b",
     "unit": "cm",
     "min": 0
    },
    "h": {
     "desc": "構材全深度 h",
     "unit": "cm",
     "min": 0
    },
    "h_prime": {
     "desc": "邊緣切口深度 h'",
     "unit": "cm",
     "min": 0
    }
   },
   "expr": "b * (h - h_prime) * 0.5",
   "conditions": [
    {
     "expr": "b >= 0 and h >= h_prime >= 0",
     "msg": "寬度 b >= 0 且深度 h >= h' >= 0"
    }
   ],
   "tests": [
    {
     "in": {
      "b": 10,
      "h": 15,
      "h_prime": 3
     },
     "out": 60.0
    }
   ],
   "notes": "木構造 5.2.3 【解說】(二)(1) (5.2)式（圖5.2-1）：邊緣切口產生應力偏心使軸向拉伸強度顯著降低，故淨斷面再折半。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.52 §5.2.3 (5.2)式（p52.png）",
    "by": "agent",
    "date": "2026-11-14"
   },
   "_file": "wood100_p2_members.json"
  },
  {
   "id": "wood100_tension_hole_ae",
   "title": "受拉構材中央圓孔之有效淨斷面積（木構造 5.2.3 解說 (5.3)式）",
   "src": "wood100",
   "clause": "5.2.3",
   "page": 52,
   "keywords": "木構造 受拉構材 圓孔 開孔 有效淨斷面積 (5.3)",
   "unit": "cm2",
   "output": "A_e",
   "latex": "A_e = bh\\left(1 - \\frac{\\phi}{h}\\right)",
   "vars": {
    "b": {
     "desc": "構材寬度 b",
     "unit": "cm",
     "min": 0
    },
    "h": {
     "desc": "構材深度 h",
     "unit": "cm",
     "min": 0.1
    },
    "phi": {
     "desc": "中央圓孔直徑 φ",
     "unit": "cm",
     "min": 0
    }
   },
   "expr": "b * h * (1.0 - phi / h)",
   "conditions": [
    {
     "expr": "b >= 0 and h > 0 and 0 <= phi <= h",
     "msg": "b >= 0、h > 0 且 0 <= φ <= h"
    }
   ],
   "tests": [
    {
     "in": {
      "b": 10,
      "h": 15,
      "phi": 3
     },
     "out": 120.0
    }
   ],
   "notes": "木構造 5.2.3 【解說】(二)(2) (5.3)式（圖5.2-2）：圓孔偏離中央往邊緣移動時，有效淨斷面應再予折減。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.52 §5.2.3 (5.3)式（p52.png）",
    "by": "agent",
    "date": "2026-11-14"
   },
   "_file": "wood100_p2_members.json"
  },
  {
   "id": "wood100_compression_buckling",
   "title": "單一受壓構材容許軸壓力與挫屈折減計算（木構造 5.3.2 (5.4)~(5.6),(5.8)式）",
   "src": "wood100",
   "clause": "5.3.2",
   "page": 53,
   "keywords": "木構造 受壓構材 挫屈折減係數 細長比 容許挫屈應力 (5.4) (5.5) (5.6) (5.8)",
   "unit": "kgf",
   "output": "N_allow",
   "latex": "\\lambda = \\frac{_kl}{i},\\quad \\eta = \\begin{cases} 1 & \\lambda \\le 30 \\\\ 1.3 - 0.01\\lambda & 30 < \\lambda \\le 100 \\\\ \\frac{3000}{\\lambda^2} & 100 < \\lambda \\le 150 \\end{cases},\\quad f_k = \\eta f_c,\\quad N \\le A_g f_k",
   "vars": {
    "A_g": {
     "desc": "構材全斷面積 A_g",
     "unit": "cm2",
     "min": 0
    },
    "f_c": {
     "desc": "容許壓應力 f_c（長期或短期）",
     "unit": "kgf/cm2",
     "min": 0
    },
    "kl": {
     "desc": "挫屈長度 _kl",
     "unit": "cm",
     "min": 0
    },
    "i": {
     "desc": "挫屈方向斷面迴轉半徑 i（矩形 h/3.46，圓形 D/4.0）",
     "unit": "cm",
     "min": 0.01
    }
   },
   "defs": [
    [
     "lam",
     "kl / i"
    ],
    [
     "eta",
     "1.0 if lam <= 30 else (1.3 - 0.01 * lam if lam <= 100 else 3000.0 / (lam ** 2))"
    ],
    [
     "f_k",
     "eta * f_c"
    ]
   ],
   "expr": "A_g * f_k",
   "conditions": [
    {
     "expr": "A_g >= 0 and f_c >= 0 and kl >= 0 and i > 0",
     "msg": "斷面積與應力須非負，i > 0"
    },
    {
     "expr": "kl / i <= 150",
     "msg": "5.3.2(3) 規定受壓構材細長比 λ 須在 150 以下"
    }
   ],
   "tests": [
    {
     "in": {
      "A_g": 100,
      "f_c": 75,
      "kl": 120,
      "i": 4
     },
     "out": 7500.0
    },
    {
     "in": {
      "A_g": 100,
      "f_c": 75,
      "kl": 240,
      "i": 4
     },
     "out": 5250.0
    },
    {
     "in": {
      "A_g": 100,
      "f_c": 75,
      "kl": 480,
      "i": 4
     },
     "out": 1562.5
    }
   ],
   "notes": "木構造 5.3.2 (5.4)~(5.6),(5.8)式：細長比上限 λ<=150；矩形斷面 i=h/3.46、圓形斷面 i=D/4.0。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.53-54 §5.3.2 (p54.png)",
    "by": "agent",
    "date": "2026-11-14"
   },
   "_file": "wood100_p2_members.json"
  },
  {
   "id": "wood100_compression_euler_short_allow",
   "title": "試驗彈性模數細長柱之短期容許挫屈應力（木構造 5.3.2 (5.7)式）",
   "src": "wood100",
   "clause": "5.3.2",
   "page": 54,
   "keywords": "木構造 短期容許挫屈應力 彈性模數 歐勒挫屈 λ>100 (5.7)",
   "unit": "kgf/cm2",
   "output": "Sf_k",
   "latex": "_{S}f_k = \\frac{\\pi^2 E}{\\lambda^2}",
   "vars": {
    "E": {
     "desc": "設計用彈性模數（個別試驗 E=2/3*E0；抽樣試驗 E=1/2*E0）",
     "unit": "kgf/cm2",
     "min": 0
    },
    "lam": {
     "desc": "構材細長比 λ（100 < λ <= 150）",
     "unit": "無因次",
     "min": 100,
     "max": 150
    }
   },
   "expr": "(pi ** 2) * E / (lam ** 2)",
   "conditions": [
    {
     "expr": "E >= 0 and 100 <= lam <= 150",
     "msg": "(5.7) 適用 λ 在 100 以上且不超過 150"
    }
   ],
   "tests": [
    {
     "in": {
      "E": 60000,
      "lam": 120
     },
     "out": 41.12335167120566
    }
   ],
   "notes": "木構造 5.3.2(2)(b) (5.7)式：λ 在 100 以上，由實驗求得彈性模數 E0 時，個別材料試驗取 E=(2/3)E0、抽樣試驗取 E=(1/2)E0。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.54 §5.3.2(2)(b) (p54.png)",
    "by": "agent",
    "date": "2026-11-14"
   },
   "_file": "wood100_p2_members.json"
  },
  {
   "id": "wood100_compression_unequal_kl",
   "title": "兩端承受不同軸向壓力之受壓構材挫屈長度（木構造 5.3.2 (5.9)式）",
   "src": "wood100",
   "clause": "5.3.2",
   "page": 55,
   "keywords": "木構造 挫屈長度 不同軸壓力 N1 N2 (5.9)",
   "unit": "cm",
   "output": "kl",
   "latex": "_kl = l\\left(0.75 + 0.25\\frac{N_2}{N_1}\\right)",
   "vars": {
    "l": {
     "desc": "構材實長 l",
     "unit": "cm",
     "min": 0
    },
    "N1": {
     "desc": "較大端軸向壓力 N1",
     "unit": "kgf",
     "min": 0.001
    },
    "N2": {
     "desc": "較小端軸向壓力 N2（N1 > N2）",
     "unit": "kgf",
     "min": 0
    }
   },
   "expr": "l * (0.75 + 0.25 * (N2 / N1))",
   "conditions": [
    {
     "expr": "l >= 0 and N1 > 0 and N1 >= N2 >= 0",
     "msg": "構材長度 l >= 0 且 N1 >= N2 >= 0（N1 > 0）"
    }
   ],
   "tests": [
    {
     "in": {
      "l": 300,
      "N1": 1000,
      "N2": 600
     },
     "out": 270.0
    }
   ],
   "notes": "木構造 5.3.2(4)(c)(iv) (5.9)式：檢核 (5.4) 式時設計軸壓力 N 取較大之 N1。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.55 §5.3.2 (p55.png)",
    "by": "agent",
    "date": "2026-11-14"
   },
   "_file": "wood100_p2_members.json"
  },
  {
   "id": "wood100_composite_col_ie",
   "title": "複合受壓構材 y-y 軸有效斷面慣性矩（木構造 5.3.3 (5.10)式）",
   "src": "wood100",
   "clause": "5.3.3",
   "page": 57,
   "keywords": "木構造 複合受壓構材 有效斷面慣性矩 效率係數 間隔墊塊 (5.10)",
   "unit": "cm4",
   "output": "I_e",
   "latex": "I_e = \\xi \\Sigma I_1",
   "vars": {
    "xi": {
     "desc": "斷面慣性矩之有效率 ξ（依表5.3-5 或表5.3-6；三根以上乘 1.2）",
     "unit": "無因次",
     "min": 0
    },
    "sum_I1": {
     "desc": "平行 y-y 軸、相對於各主材重心軸之斷面慣性矩之和 ΣI1",
     "unit": "cm4",
     "min": 0
    }
   },
   "expr": "xi * sum_I1",
   "conditions": [
    {
     "expr": "xi >= 0 and sum_I1 >= 0",
     "msg": "效率 ξ 與斷面慣性矩之和須非負"
    }
   ],
   "tests": [
    {
     "in": {
      "xi": 2.2,
      "sum_I1": 500
     },
     "out": 1100.0
    }
   ],
   "notes": "木構造 5.3.3(1)(b) (5.10)式：個別主材全長細長比<=200，墊塊間個別主材細長比<=60。主材數三根以上且兩端及三分點以上由墊塊分隔時，ξ 取表5.3-6 之 1.2 倍。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.57 §5.3.3 (p57.png)",
    "by": "agent",
    "date": "2026-11-14"
   },
   "_file": "wood100_p2_members.json"
  },
  {
   "id": "wood100_spacer_nail_stiffness_ratio",
   "title": "複合受壓構材釘接墊塊之剛比 k（木構造 5.3.3 (5.11)式）",
   "src": "wood100",
   "clause": "5.3.3",
   "page": 59,
   "keywords": "木構造 複合受壓構材 間隔墊塊 剛比 釘接合 (5.11)",
   "unit": "無因次",
   "output": "k",
   "latex": "k = v\\bar{\\alpha}\\cdot \\frac{P\\cdot l}{E A_1},\\quad \\bar{\\alpha} = \\frac{2(\\alpha+1)(1+0.25\\alpha)}{\\alpha+2}",
   "vars": {
    "alpha": {
     "desc": "空腹率 α = a / h",
     "unit": "無因次",
     "min": 0
    },
    "P": {
     "desc": "墊塊單面與主材接合之釘的短期容許剪力",
     "unit": "kgf",
     "min": 0
    },
    "l": {
     "desc": "主材長度 l",
     "unit": "cm",
     "min": 0
    },
    "E": {
     "desc": "主材彈性模數 E",
     "unit": "kgf/cm2",
     "min": 0.1
    },
    "A_1": {
     "desc": "單支主材斷面積 A1",
     "unit": "cm2",
     "min": 0.1
    },
    "v": {
     "desc": "釘接合種類係數 v（一般採用 35 cm^-1）",
     "unit": "1/cm",
     "min": 0
    }
   },
   "defs": [
    [
     "alpha_bar",
     "2.0 * (alpha + 1.0) * (1.0 + 0.25 * alpha) / (alpha + 2.0)"
    ]
   ],
   "expr": "v * alpha_bar * P * l / (E * A_1)",
   "conditions": [
    {
     "expr": "alpha >= 0 and P >= 0 and l >= 0 and E > 0 and A_1 > 0 and v >= 0",
     "msg": "參數須滿足 E > 0、A1 > 0 且非負"
    }
   ],
   "tests": [
    {
     "in": {
      "alpha": 0,
      "P": 400,
      "l": 300,
      "E": 80000,
      "A_1": 100,
      "v": 35
     },
     "out": 0.525
    },
    {
     "in": {
      "alpha": 3,
      "P": 400,
      "l": 300,
      "E": 80000,
      "A_1": 100,
      "v": 35
     },
     "out": 1.47
    }
   ],
   "notes": "木構造 5.3.3(3)(a) (5.11)式：墊塊長度須為 (α+2)h 以上。註：α=1 時算式給出 1.667，表5.3-7 刊載為 1.65。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.59 §5.3.3(3)(a) (p59.png)",
    "by": "agent",
    "date": "2026-11-14"
   },
   "_file": "wood100_p2_members.json"
  },
  {
   "id": "wood100_spacer_glue_stiffness_ratio",
   "title": "複合受壓構材膠合墊塊之剛比 k（木構造 5.3.3 (5.12)式）",
   "src": "wood100",
   "clause": "5.3.3",
   "page": 59,
   "keywords": "木構造 複合受壓構材 間隔墊塊 剛比 膠合劑接合 (5.12)",
   "unit": "無因次",
   "output": "k",
   "latex": "k = 0.05\\bar{\\alpha}_g\\cdot \\frac{l}{h},\\quad \\bar{\\alpha}_g = (\\alpha+1)\\left(1 - \\frac{\\alpha}{30}\\right)",
   "vars": {
    "alpha": {
     "desc": "空腹率 α = a / h",
     "unit": "無因次",
     "min": 0,
     "max": 30
    },
    "l": {
     "desc": "主材長度 l",
     "unit": "cm",
     "min": 0
    },
    "h": {
     "desc": "主材厚度 h",
     "unit": "cm",
     "min": 0.1
    }
   },
   "defs": [
    [
     "alpha_g",
     "(alpha + 1.0) * (1.0 - alpha / 30.0)"
    ]
   ],
   "expr": "0.05 * alpha_g * (l / h)",
   "conditions": [
    {
     "expr": "0 <= alpha <= 30 and l >= 0 and h > 0",
     "msg": "空腹率 0 <= α <= 30，l >= 0 且 h > 0"
    }
   ],
   "tests": [
    {
     "in": {
      "alpha": 0,
      "l": 300,
      "h": 6
     },
     "out": 2.5
    },
    {
     "in": {
      "alpha": 2,
      "l": 300,
      "h": 6
     },
     "out": 7.0
    }
   ],
   "notes": "木構造 5.3.3(3)(b) (5.12)式：墊塊與主材應為相同材質及寬度，長度應為 (α+1)h 以上。註：α=1 時算式給出 1.933，表5.3-8 刊載為 2.00。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.59 §5.3.3(3)(b) (p59.png)",
    "by": "agent",
    "date": "2026-11-14"
   },
   "_file": "wood100_p2_members.json"
