  {
   "id": "wood100_bending_shear_allow",
   "title": "單一受彎構材容許剪力與支點有效斷面積（木構造 5.4.3 (5.17)(5.18)式）",
   "src": "wood100",
   "clause": "5.4.3",
   "page": 63,
   "keywords": "木構造 受彎構材 剪應力 有效斷面積 支點 切口 (5.17) (5.18)",
   "unit": "kgf",
   "output": "Q_allow",
   "latex": "\\alpha \\frac{Q}{A_e} \\le f_s,\\quad A_e = \\begin{cases} A & \\text{無缺口} \\\\ A_0 & \\text{受壓側切口} \\\\ A_0^2 / A & \\text{受拉側切口}(h' > \\frac{2}{3}h) \\end{cases}",
   "vars": {
    "b": {
     "desc": "矩形斷面寬度 b（或圓形有效寬度換算）",
     "unit": "cm",
     "min": 0
    },
    "h": {
     "desc": "全斷面深度 h",
     "unit": "cm",
     "min": 0.1
    },
    "h_rem": {
     "desc": "支點切口處殘存淨深度 h'（無缺口時填 h）",
     "unit": "cm",
     "min": 0
    },
    "notch_type": {
     "desc": "缺口型態：0=無缺口，1=受壓側切口，2=受拉側切口",
     "unit": "型態",
     "min": 0,
     "max": 2
    },
    "alpha": {
     "desc": "形狀係數 α（矩形 1.5、圓形 4/3）",
     "unit": "無因次",
     "min": 1.0
    },
    "f_s": {
     "desc": "容許剪應力 f_s（無切口且不會劈裂時可採用 1.5 倍）",
     "unit": "kgf/cm2",
     "min": 0
    }
   },
   "defs": [
    [
     "A_full",
     "b * h"
    ],
    [
     "A_net",
     "b * h_rem"
    ],
    [
