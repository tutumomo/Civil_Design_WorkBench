  {
   "id": "wood100_lateral_buckling_stress",
   "title": "受彎構材橫向挫屈折減後容許撓曲應力（木構造 5.4.3 (5.19)~(5.21)式）",
   "src": "wood100",
   "clause": "5.4.3",
   "page": 64,
   "keywords": "木構造 橫向挫屈 細長比 Cs Ck Cb 折減容許撓曲應力 (5.19) (5.20) (5.21)",
   "unit": "kgf/cm2",
   "output": "f_b_prime",
   "latex": "C_s = \\sqrt{\\frac{_el \\cdot h}{b^2}},\\quad C_k = 0.8\\sqrt{\\frac{E_{//y-y}}{_{L}f_{bx-x}}},\\quad f_b' = C_b f_b",
   "vars": {
    "l_e": {
     "desc": "有效橫向挫屈長度 _el（依表5.4-6）",
     "unit": "cm",
     "min": 0
    },
    "h": {
     "desc": "受彎構材深度 h",
     "unit": "cm",
     "min": 0.1
    },
    "b": {
     "desc": "受彎構材寬度 b",
     "unit": "cm",
     "min": 0.1
    },
    "E_yy": {
     "desc": "y-y 軸彈性模數 E//y-y",
     "unit": "kgf/cm2",
     "min": 0.1
    },
    "L_f_bxx": {
     "desc": "x-x 軸長期容許撓曲應力 Lfbx-x",
     "unit": "kgf/cm2",
     "min": 0.1
    },
    "f_b": {
     "desc": "未折減之容許撓曲應力 f_b（長期或短期）",
     "unit": "kgf/cm2",
     "min": 0
    }
   },
   "defs": [
    [
     "C_s",
     "sqrt(l_e * h / (b ** 2))"
    ],
    [
     "C_k",
     "0.8 * sqrt(E_yy / L_f_bxx)"
    ],
    [
     "C_b",
     "1.0 if C_s <= 10.0 else ((1.0 - (1.0 / 3.0) * ((C_s / C_k) ** 4)) if C_s <= C_k else (0.4 * E_yy / ((C_s ** 2) * L_f_bxx)))"
    ]
   ],
   "expr": "C_b * f_b",
   "conditions": [
    {
     "expr": "l_e >= 0 and h > 0 and b > 0 and E_yy > 0 and L_f_bxx > 0 and f_b >= 0",
     "msg": "幾何與材料參數須有效"
    },
    {
     "expr": "sqrt(l_e * h / (b ** 2)) <= 50.0",
     "msg": "表5.4-5 規定 C_s > 50 不容許"
    }
   ],
   "tests": [
