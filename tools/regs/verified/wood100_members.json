   "unit": "無因次",
   "output": "ratio",
   "latex": "\\frac{N_e}{A_e \\eta f_c} + \\frac{M_1}{Z_{e1} f_b} \\le 1.0 \\;\\text{(受壓弦材)};\\quad \\frac{N_e}{A_e f_t} + \\frac{M_1}{Z_{e1} f_b} \\le 1.0 \\;\\text{(受拉弦材)}",
   "vars": {
    "N_e": {
     "desc": "純桁架（節點鉸接）所產生之軸向力 Ne",
     "unit": "kgf",
     "min": 0
    },
    "A_e": {
     "desc": "弦材有效斷面積 Ae（受壓取全斷面；受拉依 5.2.2）",
     "unit": "cm2",
     "min": 0.1
    },
    "M_1": {
     "desc": "弦材視為單一受彎構材承受分擔載重所產生彎矩 M1",
     "unit": "kgf-cm",
     "min": 0
    },
    "Z_e1": {
     "desc": "弦材之有效斷面模數 Ze1",
     "unit": "cm3",
     "min": 0.1
    },
    "f_axial": {
     "desc": "軸向容許應力（受壓取 fc；受拉取 ft）",
     "unit": "kgf/cm2",
     "min": 0.1
    },
    "f_b": {
     "desc": "容許撓曲應力 fb",
     "unit": "kgf/cm2",
     "min": 0.1
    },
    "eta": {
