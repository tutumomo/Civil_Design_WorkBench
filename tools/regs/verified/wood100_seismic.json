   ],
   "notes": "木構造 7.3.7 (7.3)式（p.106）：作用於橫隔版之剪力可假設均勻分布於全寬。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.106 §7.3.7 (7.3)式",
    "by": "agent",
    "date": "2026-11-14"
