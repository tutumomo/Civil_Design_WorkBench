{
 "formulas": [
  {
   "id": "wood100_wood_period",
   "title": "木構造建築物基本振動周期（木構造 7.3.4 (7.1)式）",
   "src": "wood100",
   "clause": "7.3.4",
   "page": 103,
   "keywords": "木構造 框組式構造 耐震設計 基本振動周期 hn (7.1)",
   "unit": "秒",
   "output": "T",
   "latex": "T = 0.05\\,h_n^{0.75}",
   "vars": {
    "h_n": {
     "desc": "由基面至結構物最高層之高度 hn",
     "unit": "m",
     "min": 0.1
    }
   },
   "expr": "0.05 * (h_n ** 0.75)",
   "conditions": [
    {
     "expr": "h_n > 0",
     "msg": "hn 須為正"
    }
   ],
   "tests": [
    {
     "in": {
      "h_n": 7
     },
     "out": 0.21517585353294255
    }
   ],
   "notes": "木構造 7.3.4(2) (7.1)式（p.103）：耐震設計應依建築物耐震設計規範及本節補充條款辦理；剪力牆與橫隔版抗剪力依 7.3.6~7.3.9 節。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.103 §7.3.4(2) (7.1)式（p103.png）",
    "by": "agent",
    "date": "2026-11-14"
   },
   "_file": "wood100_p4_seismic_app.json"
  },
  {
   "id": "wood100_shearwall_strength",
   "title": "框組式構造剪力牆抗剪力（木構造 7.3.6 (7.2)式）",
   "src": "wood100",
   "clause": "7.3.6",
   "page": 106,
   "keywords": "木構造 框組式構造 剪力牆 抗剪力 K_SF J_sp J_ub (7.2)",
   "unit": "kgf",
   "output": "V",
   "latex": "V = \\sum V_d L_s,\\qquad V_d = \\nu_d\\,(K_{SF} J_{sp} J_{ub})",
   "vars": {
    "nu_d": {
     "desc": "採用木質結構覆蓋板材剪力牆之抗剪強度 νd（附錄表四-2，kgf/m）",
     "unit": "kgf/m",
     "min": 0
    },
    "K_SF": {
     "desc": "使用條件係數（乾燥 1.0、潮濕 0.75）",
     "unit": "無因次",
     "min": 0
    },
    "J_sp": {
     "desc": "框架材質樹種係數 Jsp = 1 − (0.5 − SG) ≦ 1.0",
     "unit": "無因次",
     "min": 0,
     "max": 1.0
    },
    "J_ub": {
     "desc": "水平向覆蓋、無橫檔剪力牆之強度修正係數（附錄表四-3）",
     "unit": "無因次",
     "min": 0
    },
    "L_s": {
     "desc": "平行載重方向之剪力牆長度 Ls",
     "unit": "m",
     "min": 0
    }
   },
   "defs": [
    [
     "V_d",
     "nu_d * K_SF * J_sp * J_ub"
    ]
   ],
   "expr": "V_d * L_s",
   "conditions": [
    {
     "expr": "nu_d >= 0 and K_SF >= 0 and 0 <= J_sp <= 1.0 and J_ub >= 0 and L_s >= 0",
     "msg": "各係數須非負且 Jsp ≦ 1.0"
    }
   ],
   "tests": [
    {
     "in": {
      "nu_d": 300,
      "K_SF": 1.0,
      "J_sp": 0.95,
      "J_ub": 0.8,
      "L_s": 6
     },
     "out": 1368.0
    }
   ],
   "notes": "木構造 7.3.6(1) (7.2)式（p.106）：兩面覆蓋板（同材質或不同材質）之抗剪力得累計；開孔剪力牆之抗剪力為各段總和（不含開孔段），各段應能個別抵抗傾覆力矩。剪力牆最大高寬比應小於 2:1。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.106 §7.3.6(1) (7.2)式",
    "by": "agent",
    "date": "2026-11-14"
   },
   "_file": "wood100_p4_seismic_app.json"
  },
  {
   "id": "wood100_diaphragm_strength",
   "title": "框組式構造橫隔版抗剪力（木構造 7.3.7 (7.3)式）",
   "src": "wood100",
   "clause": "7.3.7",
   "page": 106,
   "keywords": "木構造 框組式構造 橫隔版 抗剪力 淨深 d_n (7.3)",
   "unit": "kgf",
   "output": "V",
   "latex": "V = V_d\\, d_n,\\qquad V_d = \\nu_d\\,(K_{SF} J_{sp})",
   "vars": {
    "nu_d": {
     "desc": "採用木質結構覆蓋板材水平橫隔版之抗剪強度 νd（附錄表四-4，kgf/m）",
     "unit": "kgf/m",
     "min": 0
    },
    "K_SF": {
     "desc": "使用條件係數（乾燥 1.0、潮濕 0.75）",
     "unit": "無因次",
     "min": 0
    },
    "J_sp": {
     "desc": "框架材質樹種係數 Jsp = 1 − (0.5 − SG) ≦ 1.0",
     "unit": "無因次",
     "min": 0,
     "max": 1.0
    },
    "d_n": {
     "desc": "平行載重方向之橫隔版淨深 dn",
     "unit": "m",
     "min": 0
    }
   },
   "defs": [
    [
     "V_d",
     "nu_d * K_SF * J_sp"
    ]
   ],
   "expr": "V_d * d_n",
   "conditions": [
    {
     "expr": "nu_d >= 0 and K_SF >= 0 and 0 <= J_sp <= 1.0 and d_n >= 0",
     "msg": "各係數須非負且 Jsp ≦ 1.0"
    }
   ],
   "tests": [
