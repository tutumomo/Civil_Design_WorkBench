     "in": {
      "w": 200,
      "L": 12
     },
     "out": 3600.0
    }
   ],
   "notes": "木構造 7.3.9(3) (7.6)式（p.107）：適用於承受均佈載重之簡單支承橫隔版。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.107 §7.3.9(3) (7.6)式",
    "by": "agent",
    "date": "2026-11-14"
   },
   "_file": "wood100_p4_seismic_app.json"
  },
  {
   "id": "wood100_diaphragm_moment_M2",
   "title": "橫隔版開孔邊緣力矩 M2（木構造 7.3.9 (7.7)式）",
   "src": "wood100",
   "clause": "7.3.9",
   "page": 107,
   "keywords": "木構造 橫隔版 開孔 邊緣力矩 M2 we b2/12 (7.7)",
   "unit": "kgf-m",
   "output": "M_2",
   "latex": "M_2 = \\frac{w_e b^2}{12}",
   "vars": {
    "w_e": {
     "desc": "橫隔版邊緣所承受之側向載重 we（得以 w/2 估計）",
     "unit": "kgf/m",
     "min": 0
    },
    "b": {
     "desc": "垂直於載重之開孔長度 b",
