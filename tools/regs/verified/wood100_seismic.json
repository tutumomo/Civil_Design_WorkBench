  {
   "id": "wood100_adjusted_allow_stress",
   "title": "鋸製材容許應力與彈性模數之修正（木構造 附錄二 附表二-1）",
   "src": "wood100",
   "clause": "附錄二",
   "page": 137,
   "keywords": "木構造 附錄二 容許應力 修正係數 K_D K_H K_Z K_S K_T 附表二-1",
   "unit": "kgf/cm2",
   "output": "F",
   "latex": "F = f \\times K_D \\times K_H \\times K_Z \\times K_S \\times K_T",
   "vars": {
    "f": {
     "desc": "基準容許應力或彈性模數 f（fb、fc、ft、fv、fc⊥、E'）",
     "unit": "kgf/cm2",
     "min": 0
    },
    "K_D": {
     "desc": "載重持續時間修正係數 KD（附表二-2）",
     "unit": "無因次",
     "min": 0
    },
    "K_H": {
     "desc": "載重共享修正係數 KH（附表二-3；剪力與垂直纖維者取 1.0）",
     "unit": "無因次",
     "min": 0
    },
    "K_Z": {
     "desc": "尺寸修正係數 KZ（附表二-4；剪力與垂直纖維者取 1.0）",
     "unit": "無因次",
     "min": 0
    },
    "K_S": {
     "desc": "使用條件係數 KS（附表二-5）",
     "unit": "無因次",
     "min": 0
    },
    "K_T": {
     "desc": "藥劑處理係數 KT（附表二-6）",
     "unit": "無因次",
     "min": 0
    }
   },
   "expr": "f * K_D * K_H * K_Z * K_S * K_T",
   "conditions": [
    {
     "expr": "f >= 0 and K_D >= 0 and K_H >= 0 and K_Z >= 0 and K_S >= 0 and K_T >= 0",
     "msg": "基準值與各修正係數須非負"
    }
   ],
   "tests": [
    {
     "in": {
      "f": 145,
      "K_D": 1.6,
      "K_H": 1.2,
      "K_Z": 1.1,
      "K_S": 1.0,
      "K_T": 1.0
     },
     "out": 306.24
    }
   ],
   "notes": "附表二-1（p.137）各性質之對應係數：Fb=fb·KD·KHb·KZb·KSb·KT；Fc=fc·KD·KHc·KZc·KSc·KT；Ft=ft·KD·KHt·KZt·KSt·KT；Fv=fv·KD·1.0·1.0·KSv·KT；Fc⊥=fc⊥·KD·1.0·1.0·KS⊥·KT；E=E'·KD·1.0·1.0·KSE·KT。本式以通用 KH、KZ 表示，剪力與垂直纖維性質應填 1.0。",
   "status": "verified",
   "verified": {
    "method": "逐字對照 wood100 PDF p.137 附表二-1（p137.png）",
    "by": "agent",
    "date": "2026-11-14"
   },
