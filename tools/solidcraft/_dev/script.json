{
  "name": "SolidCraft 參數化流程驗證_帶孔支架",
  "commands": [
    { "command": "parameters.add", "params": { "name": "W", "expression": "120", "unit": "mm", "comment": "板長" } },
    { "command": "parameters.add", "params": { "name": "D", "expression": "80", "unit": "mm", "comment": "板寬" } },
    { "command": "parameters.add", "params": { "name": "T", "expression": "8", "unit": "mm", "comment": "板厚" } },
    { "command": "parameters.add", "params": { "name": "HOLE_D", "expression": "20", "unit": "mm", "comment": "孔徑" } },
    { "command": "parameters.add", "params": { "name": "HOLE_PITCH", "expression": "60", "unit": "mm", "comment": "孔距" } },
    { "command": "solid.box", "params": { "length": "W", "width": "D", "height": "T", "corner": [0, 0, 0], "name": "Plate" } },
    { "command": "solid.cylinder", "params": { "radius": "HOLE_D / 2", "height": "T * 3", "base": ["HOLE_PITCH", "D / 2", "-T"], "name": "Cutter" } },
    { "command": "solid.combine", "params": { "target": "Plate", "tools": ["Cutter"], "operation": "cut", "keep_tools": false } }
  ]
}
